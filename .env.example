# Environment variables for FReD/FLoRA data processing pipelines
# Copy to .env and fill in your values
# .env is in .gitignore and will NOT be committed

# OSF Authentication Token (required for release pipelines)
# Get your token from https://osf.io/settings/tokens/
OSF_TOKEN=

# COS Integration Toggle (for FReD pipeline)
# Set to TRUE to include COS test data in FReD preparation
# Set to FALSE to skip COS merging
ENABLE_COS_MERGE=FALSE

# OpenAlex API Contact Email (for doi_o_getkeywords.R)
# The OpenAlex API requires a contact email for rate limiting
# See https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=
