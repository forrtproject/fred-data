# OS files
.DS_Store
~$*

# Environment configuration
.env
.Renviron

# Blind audit source texts (never commit)
audit/*/texts/
audit/*/scripts/__pycache__/
audit/*/codings/*.tmp*
audit/*/argon/*.lock
audit/*/codings/*tmp*

# Unreviewed model stdout can contain long source excerpts
audit/*/argon/*.attempt*.txt

# FLoRA acquisition helpers; final provenance is in the coding envelopes
audit/flora_blind_2026-10/codings/*.blindmeta.json

# Active evidence-recovery files and unreviewed provider output
audit/flora_blind_2026-10/evidence_followup/private/
audit/flora_blind_2026-10/evidence_followup/argon/*.attempt*.txt
audit/flora_blind_2026-10/evidence_followup/argon/snapshot/
audit/flora_blind_2026-10/evidence_followup/argon/**/*.attempt*.txt
audit/flora_blind_2026-10/evidence_followup/**/*.lock
audit/flora_blind_2026-10/evidence_followup/**/*.tmp*
# Finite relay snapshots duplicate prompts and immutable private history paths.
audit/flora_blind_2026-10/evidence_followup/candidate_cli/*/snapshot.json
