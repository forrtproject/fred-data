10.1080/23273798.2016.1197954,3eb87368cec5640c,0,10.1037/a0013554,Do chinese readers obtain preview benefit from word n+2? Evidence from eye movements.,"Yang, J., Wang, S., Xu, Y., & Rayner, K.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Yang, J., Wang, S., Xu, Y., & Rayner, K."", ""year"": ""2009"", ""title"": ""Do chinese readers obtain preview benefit from word n+2? Evidence from eye movements."", ""doi"": ""10.1037/a0013554"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""In addition to investigating whether idioms are processed as single lexical units during reading, we also attempted to replicate the findings of Yang et al. (2009) and Yang et al. (2012) (i.e. word n+2 preview effects are only observed in Chinese text when word n+1 is highly frequent) in the same testing session as our main study."", ""outcome"": ""successful"", ""outcome_quote"": ""This replication was successful, with us observing near identical effects to both Yang et al. studies when restricting our analysis to the same interest areas used in these studies."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly compare the tested finding with this original.""}"
10.1080/23273798.2016.1197954,3eb87368cec5640c,2,10.1037/xlm0000013,Preview benefit in English spaced compounds.,"Cutter, M. G., Drieghe, D., & Liversedge, S. P.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Cutter, M. G., Drieghe, D., & Liversedge, S. P."", ""year"": ""2014"", ""title"": ""Preview benefit in English spaced compounds."", ""doi"": ""10.1037/xlm0000013"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""In the current study we investigated whether a similar phenomenon occurs in Chinese reading; namely, that when word n+2 forms a multi-word unit with word n+1, parafoveal processing of word n+2 may occur to a larger extent than previously observed."", ""outcome"": ""failed"", ""outcome_quote"": ""It is worth considering the characteristics of our idioms which may have led to them not being processed as multi-word units in the parafovea, in contrast to the spaced compounds investigated by Cutter et al. (2014)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly compare the tested finding with this original.""}"
10.1080/23273798.2016.1197954,3eb87368cec5640c,3,,The eyes have it: An eye-movement study into the processing of formulaic sequences.,"Underwood, G., Schmitt, N., & Galpin, A.",2004,full_text,,unverified,unresolved,{},"{""authors"": ""Underwood, G., Schmitt, N., & Galpin, A."", ""year"": ""2004"", ""title"": ""The eyes have it: An eye-movement study into the processing of formulaic sequences."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""First of all, the terminal word of our items received shorter fixations when they were part of an idiom as opposed to part of a phrase. This replicates an effect that has previously been observed in English idioms (see Underwood, Schmitt, & Galpin, 2004) and translated Chinese idioms (see Carrol & Conklin, 2015)."", ""outcome"": ""successful"", ""outcome_quote"": ""First of all, the terminal word of our items received shorter fixations when they were part of an idiom as opposed to part of a phrase. This replicates an effect that has previously been observed in English idioms (see Underwood, Schmitt, & Galpin, 2004) and translated Chinese idioms (see Carrol & Conklin, 2015)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly compare the tested finding with this original.""}"
