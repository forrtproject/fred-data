10.1515/iral-2012-0001,7399924f3ac7dc01,2,,Constructions as categories of language: The role of order on construction learning.,"Goldberg, Adele E., Casenhiser, Devin & White, Tiffani.",2007,full_text,,unverified,unresolved,{},"{""authors"": ""Goldberg, Adele E., Casenhiser, Devin & White, Tiffani."", ""year"": ""2007"", ""title"": ""Constructions as categories of language: The role of order on construction learning."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Goldberg et al. (2007) showed that initially providing skewed input facilitated rapid construction generalization. The present study investigates this effect for the position of verbs with relative high token frequency."", ""outcome"": ""mixed"", ""outcome_quote"": ""There was a significant main effect for order of frequent verbs in the comprehension of the APPEARANCE construction. Figure 1 shows that the (+forward order) group outperformed the (−forward skewing) group. No significant effects were found in the guided production of the APPEARANCE construction and the comprehension of the Samoan ergative construction."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors present an agreeing comprehension effect and explicitly absent effects in the other tasks; no overall verdict supersedes this comparison.""}"
10.1037/edu0000141,5a644ad030ba92a5,1,10.3102/0162373715581709,An Effort to Close Achievement Gaps at Scale through Self-Affirmation.,"Borman, G. D., Grigg, J., & Hanselman, P.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""Borman, G. D., Grigg, J., & Hanselman, P."", ""year"": ""2016"", ""title"": ""An Effort to Close Achievement Gaps at Scale through Self-Affirmation."", ""doi"": ""10.3102/0162373715581709"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The current study was designed to replicate both the original self-affirmation study\n(Cohen et al., 2006) and the previous successful independent replication (Borman et al., 2016)."", ""outcome"": ""failed"", ""outcome_quote"": ""We found no evidence of\neffects in this replication study and estimates were precise enough to reject benefits larger than\nan effect size of 0.10. These null effects were significantly different from persistent benefits in\nthe prior study in the same setting, and extensive testing revealed that currently theorized\nmoderators of self-affirmation effects could not explain the difference."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The new cohort produced no benefits; the paper explicitly describes its failure to replicate. Previously reported cohort results are the comparison, not new successful replications.""}"
10.1111/1475-6773.12595,d509c13037dfec31,0,,Fifth Report to Congress on the Evaluation of the Medicare Coordinated Care Demonstration: Findings over 10 Years.,"Burwell, S.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Burwell, S."", ""year"": ""2014"", ""title"": ""Fifth Report to Congress on the Evaluation of the Medicare Coordinated Care Demonstration: Findings over 10 Years."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We tested whether the impact estimates for Phase II (using the primary sample) were statistically different from Phase I impacts for high-risk beneﬁciaries (N = 322), as reported in the evaluation’s ﬁfth report to Congress (Burwell 2014)."", ""outcome"": ""failed"", ""outcome_quote"": ""Over the 4 years of the demonstration’s second phase, the HQP program did not achieve its earlier success. The program did not reduce hospitalizations, outpatient ED visits, 2-year mortality rates, or Medicare expenditures relative to the control group."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall verdict that the program did not achieve its earlier success; directly compares Phase II to Phase I.""}"
10.1007/s11205-005-5074-x,b62c747678016333,0,,Feeding the illusion of growth and happiness: A reply to Hagerty and Veenhoven,"Easterlin, R.A",2005,full_text,,unverified,unresolved,{},"{""authors"": ""Easterlin, R.A"", ""year"": ""2005"", ""title"": ""Feeding the illusion of growth and happiness: A reply to Hagerty and Veenhoven"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Richard Easterlin elegantly disputed these findings in a paper: Feeding the\n      Illusion of Growth and Happiness: A Reply to Hagerty and Veenhoven, published in this\n      journal (Easterlin 2005)."", ""outcome"": ""failed"", ""outcome_quote"": ""All in all, it seems that people have become happier in the second half of the 20th century\n    and that the gains in happiness have been greater in poor nations than in rich nations."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The extended national survey series contradict the closest target in the debate: Easterlin’s 2005 no-growth interpretation. The overall judgment is rising happiness despite measurement uncertainty.""}"
10.31219/osf.io/x394e_v3,78fb9fef3070ea73,1,10.1037/a0021971,Hindsight bias from 3 to 95 years of age.,"Bernstein, D. M., Erdfelder, E., Meltzoff, A. N., Peria, W., & Loftus, G. R.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Bernstein, D. M., Erdfelder, E., Meltzoff, A. N., Peria, W., & Loftus, G. R."", ""year"": ""2011"", ""title"": ""Hindsight bias from 3 to 95 years of age."", ""doi"": ""10.1037/a0021971"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""For the extensions, we predict that age will positively correlate with hindsight bias, whereas other socio-demographic variables (such as socioeconomic status, gender, occupation, and education) will not (Hypothesis 2). This investigation will provide further evidence for the claim that populations of older ages are more susceptible to hindsight bias (Bernstein et al., 2011; Groß & Bayen, 2021; Pohl et al., 2018), whereas evidence for gender, occupation, and education is not consolidated yet."", ""outcome"": ""failed"", ""outcome_quote"": ""We expected to find a positive correlation between age and hindsight bias, and no correlation with other socio-demographic variables. Also, we expected to find a positive correlation between depressive symptoms and hindsight bias. Contrary to our expectations, no correlation was found between hindsight bias and sociodemographic or depressive symptoms. These results contrast with previous findings showing a higher magnitude of hindsight bias for older adults (Groß, 2013) and a positive correlation between depressive symptoms and hindsight bias (Groß et al., 2017; Groß & Bayen, 2017)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Specific earlier finding is explicitly tested and the authors report its absence. Differences in design do not remove the comparison.""}"
10.31219/osf.io/x394e_v3,78fb9fef3070ea73,2,10.3758/s13421-021-01195-w,Older and younger adults’ hindsight bias after positive and negative outcomes.,"Groß, J., & Bayen, U. J.",2021,full_text,,unverified,unresolved,{},"{""authors"": ""Groß, J., & Bayen, U. J."", ""year"": ""2021"", ""title"": ""Older and younger adults’ hindsight bias after positive and negative outcomes."", ""doi"": ""10.3758/s13421-021-01195-w"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""For the extensions, we predict that age will positively correlate with hindsight bias, whereas other socio-demographic variables (such as socioeconomic status, gender, occupation, and education) will not (Hypothesis 2). This investigation will provide further evidence for the claim that populations of older ages are more susceptible to hindsight bias (Bernstein et al., 2011; Groß & Bayen, 2021; Pohl et al., 2018), whereas evidence for gender, occupation, and education is not consolidated yet. Also, we predict that depressive symptoms will be positively correlated with hindsight bias (Hypothesis 3), thus suggesting an interaction between the cognitive mechanisms in depression and the magnitude of the hindsight bias. Finally, considering the previous evidence of higher levels of hindsight bias associated with higher levels of depressive symptoms (Groß et al., 2017; Groß & Bayen, 2021; Haslam & Jayasinghe, 1995), we expect that depressive symptoms will act as a moderator variable of the hindsight bias effect (Hypothesis 4)."", ""outcome"": ""failed"", ""outcome_quote"": ""We expected to find a positive correlation between age and hindsight bias, and no correlation with other socio-demographic variables. Also, we expected to find a positive correlation between depressive symptoms and hindsight bias. Contrary to our expectations, no correlation was found between hindsight bias and sociodemographic or depressive symptoms. These results contrast with previous findings showing a higher magnitude of hindsight bias for older adults (Groß, 2013) and a positive correlation between depressive symptoms and hindsight bias (Groß et al., 2017; Groß & Bayen, 2017)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Specific earlier finding is explicitly tested and the authors report its absence. Differences in design do not remove the comparison.""}"
