10.1017/xps.2020.18,166a0786310a6eeb,0,,,Walsh and Schulzke,,abstract,,unverified,unresolved,{},"{""authors"": ""Walsh and Schulzke"", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2, 3"", ""evidence_quote"": ""To address this, we replicate and extend the research design of Walsh and Schulzke across three survey experiments."", ""outcome"": ""failed"", ""outcome_quote"": ""We find that support for military action does not differ across treatments in which subjects are told that the attack involves drone strikes or ground troops."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract states that the prior finding was greater support with drones and reports no corresponding support difference in the replication experiments.""}"
10.37237/150205,fddfd57742c5ffb7,0,10.1080/17501229.2020.1825445,Promoting positive feelings and motivation for language learning: The role of a confidence-building diary.,"Shelton-Strong, S., & Mynard, J.",2021,full_text,,unverified,unresolved,{},"{""authors"": ""Shelton-Strong, S., & Mynard, J."", ""year"": ""2021"", ""title"": ""Promoting positive feelings and motivation for language learning: The role of a confidence-building diary."", ""doi"": ""10.1080/17501229.2020.1825445"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The original investigation conducted by Shelton-Strong and Mynard (2018, 2021) on the use of a confidence-building diary with university students was replicated with younger students aged 13–14 years old (Spricigo, 2023)."", ""outcome"": ""mixed"", ""outcome_quote"": ""In the original study, all the participants felt that the CBD-based intervention was beneficial. In the replication study, although the CBD was generally well-received, a minority of participants did not find it motivating."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""Positive feelings and basic need satisfaction agree, but authors explicitly contrast preferred receptive activities with original speaking preference and contrast universal original benefit with a minority not motivated. Conclusion endorses effectiveness of the tool, rather than issuing an overall verdict on all replication findings.""}"
10.1109/esem.2015.7321191,b271f6834dc1f14f,0,,,Apel et al.,,abstract,,unverified,unresolved,{},"{""authors"": ""Apel et al."", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this study, aiming at increasing the existing body of evidence and assessing results for systems developed under an alternative version control paradigm, we replicate an experiment conducted by Apel et al. to compare the unstructured and semistructured approach with respect to the occurrence of conflicts reported by both approaches."", ""outcome"": ""successful"", ""outcome_quote"": ""Similar to the original study, we observed that semistructured merge reduces the number of conflicts in 55% of the scenarios of the new sample. However, the observed average conflict reduction of 62% in these scenarios is far superior than what has been observed before."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit agreement with original conflict reduction finding; larger reduction does not imply mixed.""}"
10.3389/fneur.2025.1709389,eef5ae27bbc775a1,1,10.1212/WNL.88.16_supplement.P1.376,Continuous daily assessment of multiple sclerosis disability using remote step count monitoring.,"Block VJ, Lizee A, Crabtree-Hartman E, Bevan C, Graves J, Bove R.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""Block VJ, Lizee A, Crabtree-Hartman E, Bevan C, Graves J, Bove R."", ""year"": ""2016"", ""title"": ""Continuous daily assessment of multiple sclerosis disability using remote step count monitoring."", ""doi"": ""10.1212/WNL.88.16_supplement.P1.376"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We obtained the original activity data from the CA ( 11 ,  12 ) and VA ( 13 ) cohorts, harmonized overlapping variables collected in both studies, and conducted secondary data analyses to replicate analyses in the CA cohort using the VA dataset ( 13 )."", ""outcome"": ""successful"", ""outcome_quote"": ""Mirroring the approach used in the CA cohort ( 11 ,  12 ) study of 97 participants with MS using wrist-worn Fitbit activity monitors, we replicated key findings in the VA cohort ( 13 ) of 61 participants with MS with less severe disability, assessed using the hip-worn ActiGraph sensors."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""Overall verdict explicitly states key findings of the CA studies (11, 12) were replicated in the independent VA cohort; smaller correlations and reliability are not framed as replication failure.""}"
10.1016/j.learninstruc.2015.08.002,f2f8f188a2c40775,0,,,Karpicke and Blunt,2011,abstract,,unverified,unresolved,{},"{""authors"": ""Karpicke and Blunt"", ""year"": ""2011"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Karpicke and Blunt (2011) showed in college students that retrieval practice produced more learning from educational texts than concept mapping on a 1-week delayed test."", ""outcome"": ""successful"", ""outcome_quote"": ""While the results essentially replicate Karpicke and Blunt's finding which shows that retrieval practice leads to better overall performance than concept mapping, this effect was less pronounced for people with experience using this technique than it was for trained participants."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall replication verdict. Attenuation for experienced participants does not turn support into mixed.""}"
10.1093/pnasnexus/pgaf327,4557265215dceef5,1,10.1038/s41562-021-01133-5,Reconsidering evidence of moral contagion in online social networks,"Burton JW, Cruz N, Hahn U",2021,full_text,,unverified,unresolved,{},"{""authors"": ""Burton JW, Cruz N, Hahn U"", ""year"": ""2021"", ""title"": ""Reconsidering evidence of moral contagion in online social networks"", ""doi"": ""10.1038/s41562-021-01133-5"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also tested Burton et al. ( 24 )'s key claim that moral contagion models perform no better than the nonsense “XYZ contagion” model."", ""outcome"": ""failed"", ""outcome_quote"": ""Our findings also directly challenge previous claims made by Burton et al. ( 24 ) that moral contagion may not replicate well out of the original Brady et al. ( 1 ) sample, and that the moral contagion model performs “no better” than a nonsense “XYZ contagion” model."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly assess this published finding in new samples; verdict follows their stated overall comparison.""}"
10.3390/su9071286,935c2f360e27f419,1,,Eco-Friendliness in the Brand Experience of High-Tech Products.,"Saari, U.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""Saari, U."", ""year"": ""2016"", ""title"": ""Eco-Friendliness in the Brand Experience of High-Tech Products."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this study we replicate the extended BXS [19] cross-nationally to measure differences in the ways consumers experience the eco-friendliness of global smartphone brands in a cross-national context. The survey items were selected from the previously developed and extended BXS [18,19,107]. We assess the four items measuring eco-friendliness as well as the other four brand experience dimensions from the BXS by conducting structural equation modeling (SEM) and confirmatory factor analysis (CFA) following the same steps that Brakus et al. [18] undertook."", ""outcome"": ""successful"", ""outcome_quote"": ""The findings of our study indicate that the eco-friendliness dimension can be generalized in two countries with very different demographics and economic situations."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The earlier eco-friendliness dimension is explicitly retested and confirmed in both countries; changes to the other dimensions do not negate this target finding.""}"
10.1002/ijop.12519,ea72ea7a5091d5aa,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Previous research has found that negative-valence appeals relating to the self (Don't be a cheater) are more effective at reducing unethical behaviour than appeals relating to behaviour (Don't cheat). We aimed to replicate these findings and examine whether positive-valence appeals relating to the self (Be an honest person) and to behaviour (Answer honestly) could have a similar effect."", ""outcome"": ""successful"", ""outcome_quote"": ""A meta-analysis of the five experiments revealed a small effect of the self-appeals relative to the behaviour-appeals."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract states the original self-appeal advantage and reports the same advantage in the aggregate of the five new experiments. Smaller effects do not change success. Citation identity cannot be established from the abstract.""}"
10.3386/w20657,5125e2ec82209943,1,,Revisiting the Impacts of Teachers.,"Rothstein, Jesse.",2014,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Rothstein, Jesse."", ""year"": ""2014"", ""title"": ""Revisiting the Impacts of Teachers."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In addition to replicating the CFR and Rothstein analyses, we extended their work in three ways."", ""outcome"": ""statistically successful but flawed"", ""outcome_quote"": ""In a recent paper, Rothstein (2014) reports a statistically significant relationship between change in teacher value-added and changes in baseline achievement as prima facie evidence of bias in the CFR method. We find similar results, but offer a different interpretation. We find that the predicted change has a coefficient of .268 when lagged scores are the dependent variable. However, rather than invalidating the CFR methodology, the lagged score test merely demonstrates the hazards of using the same data to estimate the dependent and 19 independent variables."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""Statistical placebo relationship is replicated but shown to be mechanically confounded, a central methodological critique.""}"
10.3386/w20657,5125e2ec82209943,2,,"Match Quality, Worker Productivity, and Worker Mobility: Direct Evidence From Teachers.","Jackson, Kirabo.",Forthcoming,full_text,,unverified,unresolved,{},"{""authors"": ""Jackson, Kirabo."", ""year"": ""Forthcoming"", ""title"": ""Match Quality, Worker Productivity, and Worker Mobility: Direct Evidence From Teachers."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Using data from North Carolina, Jackson (forthcoming) estimates that teacher-school match effects account for roughly one-third of the variance in teacher effects. To test the possibility that teacher effects vary by context, we first divide the data available for each teacher’s value-added into value-added estimates using observations only from the same school and those from all available schools."", ""outcome"": ""successful"", ""outcome_quote"": ""Consistent with Jackson’s findings regarding teacher-school matches, the point estimate on value-added estimate of the same school, 1.054, is larger than the coefficient on the difference between that from all schools and similar schools, .817. However, we could not reject the hypothesis that both coefficients were equal to one (p value=.163)."", ""outcome_quote_section"": ""results"", ""outcome_confident"": false, ""outcome_reasoning"": ""Authors describe the direction as consistent with Jackson. Equality cannot be rejected; this tentative outcome follows their comparison, not statistical significance.""}"
