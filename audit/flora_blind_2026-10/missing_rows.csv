10.1167/18.10.139,8b38dc8bb390979b,0,,,Moran et al.,2017,abstract,,unverified,unresolved,"{""corrected_value"": null, ""field"": ""missing_row"", ""file_key"": ""8b38dc8bb390979b"", ""location"": ""Abstract"", ""method"": ""argon"", ""quote"": ""Moran et al. (2017, VSS) found that realistic miniature increased immersion relative to unrealistic miniatures, but memory was unaffected. However, the questions used to assess memory were very easy, raising the possibility of a ceiling effect. The current experiment was very similar to Moran et al. (2017)."", ""reason"": ""No prior adjudication or state files exist for this work. The source is a 2018 conference abstract (VSS) with no reference list. It cites 'Moran et al. (2017, VSS)' (sharing co-author Matt Moran with the present abstract) and states that the current experiment was very similar to Moran et al. (2017), while also directly comparing its failed immersion result to shipped row 2364 (Baranowski; Hecht, 2014, 'The Big Picture: Effects of Surround on Immersion and Size Perception', DOI 10.1068/p7663). Because only the abstract is supplied and no title, full author list, DOI, or reference entry is available for Moran et al. (2017, VSS), the evidence cannot establish a complete source-backed bibliographic identity or resolve whether Moran et al. (2017, VSS) is an independent target versus a preliminary conference presentation from the same ongoing replication of Baranowski & Hecht (2014)."", ""request_id"": ""luna_0071_8b38dc8bb390979b"", ""target_index"": 0, ""verdict"": ""undeterminable""}","{""authors"": ""Moran et al."", ""year"": ""2017"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Moran et al. (2017, VSS) found that realistic miniature increased immersion relative to unrealistic miniatures, but memory was unaffected. However, the questions used to assess memory were very easy, raising the possibility of a ceiling effect. The current experiment was very similar to Moran et al. (2017)."", ""outcome"": ""failed"", ""outcome_quote"": ""However, immersion results failed to replicate: immersion scores did not significantly differ across the three conditions."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The title focuses on immersion and this effect explicitly failed. The prior memory null was also recovered; under the title-specific coding rule the central immersion finding is failed. The directly repeated study is Moran et al. (2017), not the earlier Baranowski and Hecht paper. No reference list is available to expand the citation.""}"
10.17605/osf.io/r8qp2,8109f7a62fdc044f,1,10.1177/0261927X12460666,The Language of Political Aggression,"Matsumoto, D., & Hwang, H. C.",2013,full_text,,error,argon,"{""target_index"": 1, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""blind_right"", ""corrected_value"": {""doi"": ""10.1177/0261927X12460666"", ""title"": ""The Language of Political Aggression"", ""authors"": ""Matsumoto, D., & Hwang, H. C."", ""year"": ""2013"", ""type"": ""replication"", ""outcome"": ""mixed""}, ""quote"": ""We sought to conceptually replicate two studies of the role of linguistic style in\n\npredicting war attitudes and behaviors, Abe (2012) and Matsumoto and Hwang (2013), in\n\nthe U.S. Congressional context."", ""location"": ""Introduction, p. 6"", ""reason"": ""The paper explicitly replicates both Abe (2012) and Matsumoto and Hwang (2013), testing Matsumoto and Hwang (2013) through Hypotheses 1 and 3 across the congressional speech samples, so Matsumoto and Hwang (2013) is an omitted target that requires its own replication record with a mixed outcome.""}","{""authors"": ""Matsumoto, D., & Hwang, H. C."", ""year"": ""2013"", ""title"": ""The Language of Political Aggression"", ""doi"": ""10.1177/0261927X12460666"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1A, 1B, 2A, 2B, 3"", ""evidence_quote"": ""We sought to conceptually replicate two studies of the role of linguistic style in\n\npredicting war attitudes and behaviors, Abe (2012) and Matsumoto and Hwang (2013), in\n\nthe U.S. Congressional context."", ""outcome"": ""mixed"", ""outcome_quote"": ""We add to this area by replicating two\n\nprevious studies: Abe (2012) and Matsumoto and Hwang (2013) in the context of a\n\nlegislative body. The present study hypothesized that legislators who support war measures\n\nwould be externally focused and less cognitively complex in their speeches, while opponents\n\nof war measures would be internally focused. Speeches were obtained pertaining to the\n\ndecisions for the U.S. to take military action in Kosovo, Iraq, and Libya. While we found\n\nmixed results depending on the circumstances of a speciﬁc conﬂict, we demonstrate how\n\nautomated language analysis can be combined with voting records to better understand\n\nbehavioral action, such as legislative decision."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract explicitly frames the combined conceptual replications as mixed across conflicts; results and discussion report supported and unsupported hypotheses across samples.""}"
10.7287/peerj.preprints.804v1,2558baa058315658,0,,,,2013,abstract,,correct,argon,"{""corrected_value"": null, ""field"": ""missing_row"", ""file_key"": ""2558baa058315658"", ""location"": ""abstract"", ""method"": ""argon"", ""quote"": ""Background: A study by White et al. found that population disease burden predicted preference for attractive politicians in U.S. congressional elections. Aim: We aimed to replicate this finding using data from the United Kingdom."", ""reason"": ""Prior adjudication and state files are absent. The blind target (coded with year 2013 and empty authors/title/DOI because the supplied PeerJ Preprints source text is abstract-only and cites 'White et al ., Psych Sci 2013' in the title and 'White et al.' in the abstract without a reference list) is already represented by shipped row 2369 (White, Kenrick, & Neuberg, 2013, Psychological Science, 'Beauty at the Ballot Box', 10.1177/0956797613493642), which reports the exact U.S. congressional election disease-threat and candidate-attractiveness finding retested here."", ""request_id"": ""luna_0012_2558baa058315658"", ""target_index"": 0, ""verdict"": ""shipped_right""}","{""authors"": """", ""year"": ""2013"", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""A study by White et al. found that population disease burden predicted preference for attractive politicians in U.S. congressional elections. Aim: We aimed to replicate this finding using data from the United Kingdom."", ""outcome"": ""failed"", ""outcome_quote"": ""None of the health metrics predicted rated sexiness of members of parliament."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The original association is explicitly described and the corresponding UK analysis found none. Target bibliography unavailable; do not import it from the later published version.""}"
10.1002/hrdq.21464,4866281e6326e57b,0,,"Job attitudes and employee engagement: Considering the ""A-factor"".","Newman, D. A., Joseph, D. L., & Hulin, C. L.",2010,abstract,,error,argon,"{""target_index"": 0, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""blind_right"", ""corrected_value"": {""doi"": """", ""title"": ""Job attitudes and employee engagement: Considering the \""A-factor\""."", ""authors"": ""Newman, D. A., Joseph, D. L., & Hulin, C. L."", ""year"": ""2010"", ""type"": ""reproduction"", ""outcome_computation"": ""computationally reproducible"", ""outcome_robustness"": ""robustness challenges""}, ""quote"": ""Analyses not conducted in Newman et al. (2010) (Handbook of Employee Engagement: Perspectives, Issues, Research, and Practice, pp. 43–61) were performed to deconstruct the explained variance in work engagement into commonality coefficients representing all possible subsets of variables."", ""location"": ""abstract (L34); methods (L545-L547); results (L699-L731); discussion (L861-L875)"", ""reason"": ""Newman et al. (2010) is an omitted reproduction target: the authors explicitly re-estimated its structural equation model (Figure 4.3, Panel A) on its meta-analytic correlation matrix, recovering identical latent correlations, and then decomposed the model's variance to challenge its substantive conclusions regarding construct redundancy.""}","{""authors"": ""Newman, D. A., Joseph, D. L., & Hulin, C. L."", ""year"": ""2010"", ""title"": ""Job attitudes and employee engagement: Considering the \""A-factor\""."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""For the relationships among work engagement, job satisfaction, affective organizational commitment, and job involvement, we used the meta-analytic correlations from Newman et al. (2010). This allowed us to replicate and extend the work of Newman et al. by conducting new analyses on the same data."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": ""computationally reproducible"", ""outcome_computational_quote"": ""For example, our model produced estimated latent correlations from the A-factor of job attitudes to work engagement (φ=0.77), job satisfaction (φ=0.71), affective organizational commitment (φ=0.75), and job involvement (φ=0.72) that were identical to those reported by Newman et al. (2010). Only the RMSEA values differed slightly where our analysis yielded a value 0.006 lower than the value of 0.180 reported by Newman."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""Therefore, interpretation of relationships between factors such as those made by Newman et al. (2010) –and others –require analyses similar to those reported in the present study."", ""outcome_confident"": false, ""outcome_reasoning"": ""Original meta-analytic data reanalysed with variance decomposition, challenging redundancy interpretation. Original 2010 numerical model explicitly recovered up to minor fit-index variation; numerical reproduction of 2011 is not separately established. Both publications are directly re-examined; 2010 supplied the data and original numerical model, while 2011 states the challenged claim. Partial full-text extraction limits certainty, especially the scope of the 2010 robustness verdict.""}"
10.1371/journal.pone.0126363,5e91a20ae553fe8f,0,10.1038/ng.2383,Large-scale association analysis provides insights into the genetic architecture and pathophysiology of type 2 diabetes,"Morris AP, Voight BF, Teslovich TM, Ferreira T, Segrè AV, Steinthorsdottir V, et al.",2012,full_text,,error,argon,"{""corrected_value"": {""authors"": ""Morris AP, Voight BF, Teslovich TM, Ferreira T, Segrè AV, Steinthorsdottir V, et al."", ""doi"": ""10.1038/ng.2383"", ""outcome"": ""cannot_be_determined"", ""record_type"": ""replication"", ""title"": ""Large-scale association analysis provides insights into the genetic architecture and pathophysiology of type 2 diabetes"", ""year"": ""2012""}, ""field"": ""missing_row"", ""file_key"": ""5e91a20ae553fe8f"", ""location"": ""Discussion, line 22"", ""method"": ""argon"", ""quote"": ""In this study, we examined the association of 7 SNPs, rs12571751 in ZMIZ1, rs10842994 near KLHDC5, rs2796441 near TLE1, rs459193 near ANKRD55, rs10401969 in CILP2, rs12970134 near MC4R, and rs7202877 near BCAR1, with susceptibility to type 2 diabetes in a Japanese population, and found that rs12571751 in ZMIZ1 was significantly associated with type 2 diabetes in the Japanese population. We also examined the effects of 3 additional SNP loci, rs11063069 near CCND2 and rs8108269 near GIPR, which were identified in sex-differentiated analyses [16], and rs8090011 in LAMA1, which was shown to be associated with non-obese type 2 diabetes in European GWAS [15], but we did not replicate the original association in the Japanese population (Tables 4 and 5, S3 Table)."", ""reason"": ""Neither prior_adjudication_path nor prior_state_path exists on disk (never adjudicated). This genetic replication study in 4,280 Japanese type 2 diabetes patients and 2,692 controls empirically retests 10 T2D susceptibility SNP loci identified in two distinct European GWAS papers: (1) 9 SNPs from Morris et al. (2012, Nature Genetics 44: 981-990, 10.1038/ng.2383, Reference [16]), comprising 7 unstratified loci (rs12571751 in ZMIZ1, rs10842994 near KLHDC5, rs2796441 near TLE1, rs459193 near ANKRD55, rs10401969 in CILP2, rs12970134 near MC4R, rs7202877 near BCAR1) and 2 sex-differentiated loci (rs11063069 near CCND2, rs8108269 near GIPR); and (2) 1 BMI-stratified SNP (rs8090011 in LAMA1) from Perry et al. (2012, PLoS Genetics 8: e1002741, 10.1371/journal.pgen.1002741, Reference [15]). Only Perry et al. (2012) is present in shipped_rows (row 2379, corresponding to target_index 1). Morris et al. (2012) (target_index 0) is a separate primary empirical study whose T2D associations are directly retested here and is missing from the shipped dataset."", ""request_id"": ""luna_0043_5e91a20ae553fe8f"", ""target_index"": 0, ""verdict"": ""blind_right""}","{""authors"": ""Morris AP, Voight BF, Teslovich TM, Ferreira T, Segrè AV, Steinthorsdottir V, et al."", ""year"": ""2012"", ""title"": ""Large-scale association analysis provides insights into the genetic architecture and pathophysiology of type 2 diabetes"", ""doi"": ""10.1038/ng.2383"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We selected 10 autosomal SNPs identified by European GWAS in 2012, including, rs12571751 in ZMIZ1, rs10842994 near KLHDC5, rs2796441 near TLE1, rs459193 near ANKRD55, rs10401969 in CILP2, rs12970134 near MC4R, rs7202877 near BCAR1, rs11063069 near CCND2, rs8108269 near GIPR [16], and rs8090011 in LAMA1 [15]."", ""outcome"": ""mixed"", ""outcome_quote"": ""In this study, we examined the association of 7 SNPs, rs12571751 in ZMIZ1, rs10842994 near KLHDC5, rs2796441 near TLE1, rs459193 near ANKRD55, rs10401969 in CILP2, rs12970134 near MC4R, and rs7202877 near BCAR1, with susceptibility to type 2 diabetes in a Japanese population, and found that rs12571751 in ZMIZ1 was significantly associated with type 2 diabetes in the Japanese population. We also examined the effects of 3 additional SNP loci, rs11063069 near CCND2 and rs8108269 near GIPR, which were identified in sex-differentiated analyses [16], and rs8090011 in LAMA1, which was shown to be associated with non-obese type 2 diabetes in European GWAS [15], but we did not replicate the original association in the Japanese population (Tables 4 and 5, S3 Table)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true}"
10.17605/osf.io/8wd2b,c20f9db39f03cdd4,0,,Do defaults save lives?,"Johnson, E. J., & Goldstein, D.",2003,full_text,,unverified,unresolved,{},"{""authors"": ""Johnson, E. J., & Goldstein, D."", ""year"": ""2003"", ""title"": ""Do defaults save lives?"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": ""Experiment 1"", ""replication_study_numbers"": """", ""evidence_quote"": ""In two well-powered samples (N = 1920), we conducted a close replication of the default effect in Johnson and Goldstein (2003) and in Johnson, Bellman, and Lohse (2002)."", ""outcome"": ""successful"", ""outcome_quote"": ""We successfully replicated Johnson and Goldstein (2003)."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""Overall verdict confirms this target despite smaller effects; both samples contributed to Part 1.""}"
