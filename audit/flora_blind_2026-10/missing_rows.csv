10.1353/etc.2018.0028,f6ecbaa5bb972be9,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this replication study, we examined the effect of educators’ participation in a practice-based professional learning series for designing, implementing, and evaluating Functional Assessment-based Interventions (FABI; Umbreit, Liaupsin, Ferro, & Lane, 2007) on their actual knowledge and perceived knowledge, confidence, and usefulness of concepts taught."", ""outcome"": ""successful"", ""outcome_quote"": ""Consistent with earlier inquiry, results indicated participants demonstrated statistically significant improvements in the constructs measured."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract explicitly compares improvements with the earlier inquiry; the target citation is not identifiable in the available abstract. The Umbreit citation identifies the intervention approach, not demonstrably the earlier evaluation.""}"
10.1177/1029864918811879,415599a1ed8d3293,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Here, we describe the replication of the Goldsmiths Musical Sophistication Index (Gold-MSI) in a sample of 346 university students, drawn from both a school of music and a department of psychology."", ""outcome"": ""successful"", ""outcome_quote"": ""The original approach to modeling the Gold-MSI was followed as closely as possible, and the results replicated well overall."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall replication verdict overrides item and model limitations.""}"
