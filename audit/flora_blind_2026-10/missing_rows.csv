10.3109/03014460.2011.614278,118e48f49bc02bfd,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study replicated the genetic association of SNP of FTO (rs17817449) with obesity in a north Indian population and, to the authors' knowledge; this is the first such association study in a north Indian population."", ""outcome"": ""successful"", ""outcome_quote"": ""This study replicated the genetic association of SNP of FTO (rs17817449) with obesity in a north Indian population and, to the authors' knowledge; this is the first such association study in a north Indian population."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract explicitly states replication of the association. Original-paper identity and number cannot be recovered from the abstract; this unnamed entry records the stated target association without guessing a citation.""}"
10.1017/s000305540505166x,7ca2f3f9da21d2d9,1,,Do Get-Out-the-Vote Calls Reduce Turnout? The Importance of Statistical Methods for Field Experiments.,"Imai, Kosuke.",2005,full_text,,error,argon,"{""target_index"": 1, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""blind_right"", ""corrected_value"": {""doi"": """", ""title"": ""Do Get-Out-the-Vote Calls Reduce Turnout? The Importance of Statistical Methods for Field Experiments."", ""authors"": ""Imai, Kosuke."", ""year"": ""2005""}, ""quote"": ""Replication of Professor Imai’s (2005) analysis reveals a series of errors that call into question the magnitude, significance, and robustness of his matching estimates."", ""location"": ""Introduction, p. 301 (see also Table 2 and pp. 308-310)"", ""reason"": ""Omitted target: Under the codebook rules for replication chains and earlier replication/reanalysis attempts, an earlier reanalysis is a target when the current paper directly re-tests its findings. Gerber and Green (2005) directly re-runs Imai (2005)'s propensity score matching code and analysis on the dataset Imai analyzed (Table 2, pp. 308-310), demonstrating computational discrepancies and robustness failures, and also tests Imai's 6.5 percentage point estimate in the 2002 replication experiment.""}","{""authors"": ""Imai, Kosuke."", ""year"": ""2005"", ""title"": ""Do Get-Out-the-Vote Calls Reduce Turnout? The Importance of Statistical Methods for Field Experiments."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Replication of Professor Imai’s (2005) analysis reveals a series of errors that call into question the magnitude, significance, and robustness of his matching estimates."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""results"", ""outcome_computation"": ""computational issues"", ""outcome_computational_quote"": ""Table 9 of Imai 2005 exaggerates the significance of the phone effect by reporting a coefficient of 6.5 with a standard error of 3.2. These numbers imply a t-ratio of 2.03, which tells the reader at a glance that the effect is statistically significant using a two-sided test (p < .05). When these numbers are replicated using 500,000 bootstrap samples rather than 500, the correct estimate is 6.2, with a t-ratio of 1.87 (see Table 2)."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""The estimated effects of phone calls fall to insignificance when based on the actual sample. His matching program generates an estimate of 5.1 (SE = 3.3) when performing one-to-five matching on the actual sample, and this number drops to 3.6 (SE = 4.5) when one-to-five matching is performed with replacement."", ""outcome_confident"": true, ""outcome_reasoning"": ""Re-running the original matching analysis yields substantive numerical discrepancies and inflated reported significance. Alternative matching specifications and analysis of actual rather than bootstrap samples remove significance. This target is itself an earlier reanalysis, directly re-tested here.""}"
10.1080/23251042.2021.1975350,cf6414831a5988a8,0,,,"Fitzgerald, Schor, and Jorgenson",,abstract,,unverified,unresolved,{},"{""authors"": ""Fitzgerald, Schor, and Jorgenson"", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Using 2007–2013 data from the United States, research by Fitzgerald, Schor, and Jorgenson lent support to this policy option by finding a positive and statistically significant relationship between average work hours and state-level CO2 emissions. We replicated their analyses by including more recent data and confirmed the linkage between the average hours worked in a state and annual overall CO2 emissions."", ""outcome"": ""successful"", ""outcome_quote"": ""We replicated their analyses by including more recent data and confirmed the linkage between the average hours worked in a state and annual overall CO2 emissions."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract explicitly confirms the same relationship in additional years; the stronger relationship does not make this mixed.""}"
10.1176/ps.62.4.pss6204_0367,0219dcedf73975e3,0,10.1037/a0018915,Cognitive behavioral guided self-help for the treatment of recurrent binge eating.,"Striegel-Moore RH, Wilson GT, Debar L, et al.",2010,full_text,,unverified,unresolved,{},"{""authors"": ""Striegel-Moore RH, Wilson GT, Debar L, et al."", ""year"": ""2010"", ""title"": ""Cognitive behavioral guided self-help for the treatment of recurrent binge eating."", ""doi"": ""10.1037/a0018915"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study was a replication and extension trial of our original study examining the effectiveness and cost-effectiveness of a brief guided self-help treatment for binge eating disorders in a nonspecialty health care (HMO) setting ( 23 , 39 )."", ""outcome"": ""successful"", ""outcome_quote"": ""In summary, this study replicated and extended the findings from our earlier study ( 23 ), which demonstrated that a CBT-GSH intervention could significantly improve clinical outcomes for binge eating in a highly cost-effective manner ( 39 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The explicit overall replication verdict is affirmative. Smaller abstinence rates do not overturn this verdict.""}"
