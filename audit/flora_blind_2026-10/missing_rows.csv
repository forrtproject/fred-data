10.1080/00913367.2015.1089426,bd919fa8b9034efe,0,,Tests of Graphic Visuals and Cigarette Package Warning Combinations: Implications for the Framework Convention on Tobacco Control,"Kees, Jeremy, Scot Burton, J. Craig Andrews, and John Kozup",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Kees, Jeremy, Scot Burton, J. Craig Andrews, and John Kozup"", ""year"": ""2006"", ""title"": ""Tests of Graphic Visuals and Cigarette Package Warning Combinations: Implications for the Framework Convention on Tobacco Control"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1a, 1b"", ""evidence_quote"": ""Despite extension to the use of updated, currently required text warnings, ad context, and (controversial) pictorial stimuli that were selected by the FDA, cessation-related outcomes replicate ﬁndings and conclusions of Kees and colleagues (2006, 2010)."", ""outcome"": ""successful"", ""outcome_quote"": ""Despite extension to the use of updated, currently required text warnings, ad context, and (controversial) pictorial stimuli that were selected by the FDA, cessation-related outcomes replicate ﬁndings and conclusions of Kees and colleagues (2006, 2010)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1371/journal.pone.0121564,af4a8c309c18e227,1,,Attention please: No affective priming effects in a valent/neutral-categorisation task.,"Werner B, Rothermund K",2013,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Werner B, Rothermund K"", ""year"": ""2013"", ""title"": ""Attention please: No affective priming effects in a valent/neutral-categorisation task."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We therefore decided to run a new experiment in which the essential ingredients of the experiments run by Werner and Rothermund [\n7\n] were combined with the typical priming parameters used by Spruyt and colleagues."", ""outcome"": ""failed"", ""outcome_quote"": ""Still, the mere fact that we did obtain this effect under strict automaticity conditions is logically sufficient to reject the general assertion that the evaluative priming effect fails to replicate in the valent/non-valent categorization task [\n7\n,\n22\n]."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper directly adjudicates the conflicting published results using a new sample and combined procedural elements.""}"
10.7717/peerj.5347,15ecfb7ca6e72471,0,,Thermal tolerance in tropical versus subtropical pacific reef corals,"Coles SL, Jokiel PL, Lewis CR",1976,full_text,,unverified,unresolved,{},"{""authors"": ""Coles SL, Jokiel PL, Lewis CR"", ""year"": ""1976"", ""title"": ""Thermal tolerance in tropical versus subtropical pacific reef corals"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To replicate the original thermal tolerance experiments conducted in 1970 ( Coles, Jokiel & Lewis, 1976 ; Jokiel & Coles, 1977 ; Coles & Jokiel, 1978 ), three species of corals, Montipora capitata (previously M. verrucosa ), Pocillopora damicornis, and Lobactis scutaria (previously Fungia scutaria ) , ( Gittenberger, Reijnen & Hoeksema, 2011 ) were collected from the Moku o Lo‘e reef in Kāne‘ohe Bay, O‘ahu, near the original 1970 experiment collection site (21.4°N, 157.8°W)."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our results show significant differences in coral bleaching, calcification, survivorship, and mortality since 1970 in three species of corals ( L. scutaria , M. capitata, P. damicornis ). These corals show higher calcification rates at a similar temperature increase in 2017 as compared to 1970. Calcification rates remained impaired under elevated temperatures across species; however, the reductions in 2017 were not as severe as those documented in 1970."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": false, ""outcome_reasoning"": ""Replicated thermal-tolerance experiments show continued impairment but explicit differences in bleaching thresholds, mortality and calcification. The combined experimental comparison is attributed to these three papers; paper-specific attribution of each endpoint is limited.""}"
10.7717/peerj.5347,15ecfb7ca6e72471,2,10.1007/BF00391130,"Synergistic effects of temperature, salinity and light on the hermatypic coral Montipora verrucosa","Coles SL, Jokiel PL",1978,full_text,,unverified,unresolved,{},"{""authors"": ""Coles SL, Jokiel PL"", ""year"": ""1978"", ""title"": ""Synergistic effects of temperature, salinity and light on the hermatypic coral Montipora verrucosa"", ""doi"": ""10.1007/BF00391130"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To replicate the original thermal tolerance experiments conducted in 1970 ( Coles, Jokiel & Lewis, 1976 ; Jokiel & Coles, 1977 ; Coles & Jokiel, 1978 ), three species of corals, Montipora capitata (previously M. verrucosa ), Pocillopora damicornis, and Lobactis scutaria (previously Fungia scutaria ) , ( Gittenberger, Reijnen & Hoeksema, 2011 ) were collected from the Moku o Lo‘e reef in Kāne‘ohe Bay, O‘ahu, near the original 1970 experiment collection site (21.4°N, 157.8°W)."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our results show significant differences in coral bleaching, calcification, survivorship, and mortality since 1970 in three species of corals ( L. scutaria , M. capitata, P. damicornis ). These corals show higher calcification rates at a similar temperature increase in 2017 as compared to 1970. Calcification rates remained impaired under elevated temperatures across species; however, the reductions in 2017 were not as severe as those documented in 1970."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": false, ""outcome_reasoning"": ""Replicated thermal-tolerance experiments show continued impairment but explicit differences in bleaching thresholds, mortality and calcification. The combined experimental comparison is attributed to these three papers; paper-specific attribution of each endpoint is limited.""}"
10.7717/peerj.5347,15ecfb7ca6e72471,3,,Effects of thermal loading on Hawaiian reef corals,"Jokiel PL, Coles SL, Guinther EB, Key GS, Smith SV, Townsley SJ",1975,full_text,,unverified,unresolved,{},"{""authors"": ""Jokiel PL, Coles SL, Guinther EB, Key GS, Smith SV, Townsley SJ"", ""year"": ""1975"", ""title"": ""Effects of thermal loading on Hawaiian reef corals"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Additionally, whole-colony mortality was observed sooner, just after 3 days of exposure to 31 °C, in 1970 (i.e., P. damicornis, n = 15; M. capitata, n = 8; and L. scutaria, n = 3) ( Jokiel et al., 1975 ) (Wilcoxon rank-sum test: L. scutaria p <0.0001; M. capitata p < 0.0001; P. damicornis p < 0.0001). Corals were able to withstand elevated temperatures (31.4 °C) for a longer period of time in the current 2017 experiment."", ""outcome"": ""failed"", ""outcome_quote"": ""Additionally, whole-colony mortality was observed sooner, just after 3 days of exposure to 31 °C, in 1970 (i.e., P. damicornis, n = 15; M. capitata, n = 8; and L. scutaria, n = 3) ( Jokiel et al., 1975 ) (Wilcoxon rank-sum test: L. scutaria p <0.0001; M. capitata p < 0.0001; P. damicornis p < 0.0001). Corals were able to withstand elevated temperatures (31.4 °C) for a longer period of time in the current 2017 experiment."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""Directly contrasts earlier whole-colony mortality timing against new experimental results.""}"
