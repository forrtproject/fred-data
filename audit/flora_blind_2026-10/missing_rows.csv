10.1007/bf02298289,1d3010abd6bf7fd2,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this article, Salomon's model and the research in which the model was tested are discussed, and a replication study is presented. The study determines the internal structure of the Dutch versions of Salomon's instruments and tests some predictions following from the model."", ""outcome"": ""cannot_be_determined"", ""outcome_quote"": """", ""outcome_quote_section"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""The abstract contrasts Dutch and American media perceptions but does not identify which original empirical paper supplies the American result. Two 1984 reference entries fit the media-perception finding, so an outcome cannot be assigned to a uniquely identified target. The 1981 book is cited as the source of the model, not explicitly as the original empirical finding.""}"
10.1016/j.cogdev.2017.10.004,63ba7fc3511ae27e,0,,Eighteen-month-old infants show false belief understanding in an active helping paradigm.,"Buttelmann, D., Carpenter, M., & Tomasello, M.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Buttelmann, D., Carpenter, M., & Tomasello, M."", ""year"": ""2009"", ""title"": ""Eighteen-month-old infants show false belief understanding in an active helping paradigm."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""Our interactive task was based closely on a study by Buttelmann et al. (2009)."", ""outcome"": ""successful"", ""outcome_quote"": ""We also replicated Buttelmann and colleagues' (2009) finding that 18-month-old infants helped an experimenter with a false belief by unlocking the actual location of her desired object, not the empty box she misguidedly tried to open."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Author verdict explicitly identifies this original; limitations do not replace that verdict.""}"
10.1016/j.cogdev.2017.10.004,63ba7fc3511ae27e,2,,Do 15-month-old infants understand false beliefs?,"Onishi, K. H., & Baillargeon, R.",2005,full_text,,unverified,unresolved,{},"{""authors"": ""Onishi, K. H., & Baillargeon, R."", ""year"": ""2005"", ""title"": ""Do 15-month-old infants understand false beliefs?"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""We conducted close replications of studies by Knudsen and Liszkowski (2012) and Buttelmann et al. (2009), as well as two experiments based on published violation of expectation paradigms (Onishi & Baillargeon, 2005; Song, Onishi, Baillargeon & Fisher, 2008; Träuble, Marinović & Pauen, 2010), with procedural changes based on both our novel experimental goals and the original authors’ advice."", ""outcome"": ""failed"", ""outcome_quote"": ""On the other hand, we failed to reproduce evidence that 18-month-old infants’ expectations are violated when an experimenter who ought to have a false belief reaches for an object in its true location (e.g. Onishi & Baillargeon, 2005; Song et al., 2008; Träuble et al., 2010)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Author verdict explicitly identifies this original; limitations do not replace that verdict.""}"
