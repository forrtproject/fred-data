10.1109/iwsc55060.2022.00015,a0f5200ab76450d1,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this paper, we aim to replicate and evaluate the performance of CodeBERT for code clone detection on multiple datasets with varying functionalities to understand (1) whether CodeBERT can generalize to unseen code, (2) how fine-tuning can effect CodeBERT’s performance on unseen code, and (3) how CodeBERT performs for detecting various code clone types."", ""outcome"": ""cannot_be_determined"", ""outcome_quote"": """", ""outcome_quote_section"": """", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Abstract does not identify the target paper or state its original finding; reported performance cannot establish agreement.""}"
10.1037/a0025169,da9c8f0984382fe0,1,10.1016/j.jrp.2005.05.003,The causal effects of extraversion on positive affect and neuroticism on negative affect: Manipulating state extraversion and state neuroticism in an experimental approach.,"McNiel, J. M., & Fleeson, W.",2006,full_text,,unverified,unresolved,{},"{""authors"": ""McNiel, J. M., & Fleeson, W."", ""year"": ""2006"", ""title"": ""The causal effects of extraversion on positive affect and neuroticism on negative affect: Manipulating state extraversion and state neuroticism in an experimental approach."", ""doi"": ""10.1016/j.jrp.2005.05.003"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""Although possible, two studies have assessed negative affect under similar circumstances and have failed to find the state by trait interaction that would suggest a mood cost for acting counterdispositionally (McNiel & Fleeson, 2006; McNiel et al., 2010). Therefore, our studies include between-subjects manipulations, larger sample sizes, and measures of both positive and negative affect to better assess any possible distress that might accompany counterdispositional behavior."", ""outcome"": ""successful"", ""outcome_quote"": ""This study tested whether the pattern of relationships among extraversion, mood, behavior, and cognition found in Study 1 would generalize to a new interview situation. Very similar to previous research, participants reported more positive affect when acting extraverted, and this did not depend on their dispositional levels of extraversion. We again tested whether acting counterdispositionally might cause negative affect (along with positive affect in the case of introverts) and again failed to find any evidence for this idea."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The reported positive-affect benefit and/or absence of dispositional negative-affect cost agrees with this original’s findings. Cognitive depletion is a novel extension, not a failed replication of these mood findings.""}"
10.1037/a0025169,da9c8f0984382fe0,2,10.1002/per.738,The effect of state extraversion on four types of affect.,"McNiel, J. M., Lowman, J. C., & Fleeson, W.",2010,full_text,,unverified,unresolved,{},"{""authors"": ""McNiel, J. M., Lowman, J. C., & Fleeson, W."", ""year"": ""2010"", ""title"": ""The effect of state extraversion on four types of affect."", ""doi"": ""10.1002/per.738"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""Although possible, two studies have assessed negative affect under similar circumstances and have failed to find the state by trait interaction that would suggest a mood cost for acting counterdispositionally (McNiel & Fleeson, 2006; McNiel et al., 2010). Therefore, our studies include between-subjects manipulations, larger sample sizes, and measures of both positive and negative affect to better assess any possible distress that might accompany counterdispositional behavior."", ""outcome"": ""successful"", ""outcome_quote"": ""This study tested whether the pattern of relationships among extraversion, mood, behavior, and cognition found in Study 1 would generalize to a new interview situation. Very similar to previous research, participants reported more positive affect when acting extraverted, and this did not depend on their dispositional levels of extraversion. We again tested whether acting counterdispositionally might cause negative affect (along with positive affect in the case of introverts) and again failed to find any evidence for this idea."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The reported positive-affect benefit and/or absence of dispositional negative-affect cost agrees with this original’s findings. Cognitive depletion is a novel extension, not a failed replication of these mood findings.""}"
10.1038/sj.gene.6364398,c547481cb569f28e,1,,Functional annotation of a novel NFKB1 promoter polymorphism that increases risk for ulcerative colitis.,"Karban AS, Okazaki T, Panhuysen CI, Gallegos T, Potter JJ, Bailey-Wilson JE et al.",2004,full_text,,unverified,unresolved,{},"{""authors"": ""Karban AS, Okazaki T, Panhuysen CI, Gallegos T, Potter JJ, Bailey-Wilson JE et al."", ""year"": ""2004"", ""title"": ""Functional annotation of a novel NFKB1 promoter polymorphism that increases risk for ulcerative colitis."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We first set out to confirm the published associations of , susceptibility to CD or UC with NFKB1 and TLR4 alleles. Specifically, we attempted to replicate the putative association of the -94delATTG allele of NFKB1 (NFKB1 94delATTG) with UC and the 299Gly allele of TLR4 (TLR4299G1y) with CD and UC.24,25"", ""outcome"": ""failed"", ""outcome_quote"": ""In terms of the putative NFKB1 94delATTG risk allele, Karban et al.25 first reported an association with risk of developing UC. We therefore tested this specific hypothesis in our entire set of samples but did not find significant evidence of association (OR = 0.99, 95% CI: 0.81-1.2; Supplementary Table 2)."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper’s own samples did not support the original UC association; the pooled literature finding is not the outcome of the new-sample replication.""}"
10.1017/s003329170500543x,bfd9f32714e4aa69,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Overall findings of our first direct interview family study of obsessive–compulsive disorder (OCD) indicated that OCD is familial. In this replication study, we carefully examined the role of informant data in ascertaining OCD in relatives."", ""outcome"": ""mixed"", ""outcome_quote"": ""When relative diagnoses were derived without the benefit of proband informant reports, no evidence of familial OCD transmission was found. When diagnoses were made including information from the proband about the relative, evidence of familial OCD was found, but only when the diagnostic threshold was lowered to include cases with probable OCD or OCD symptoms."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Original familial association is stated. Authors report no familial evidence under one diagnostic procedure and evidence under another with a lowered threshold, and explicitly describe their results as inconsistent. Less robust support does not itself cause the mixed verdict; the contrasted presence and absence of the finding does.""}"
10.1080/02699931.2018.1541312,3661a6a08c26160e,0,,,Juslin and Gabrielsson,1996,abstract,,unverified,unresolved,{},"{""authors"": ""Juslin and Gabrielsson"", ""year"": ""1996"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""With over 560 citations reported on Google Scholar by April 2018, a publication by Juslin and Gabrielsson (1996) presented evidence supporting performers’ abilities to communicate, with high accuracy, their intended emotional expressions in music to listeners. Though there have been related studies published on this topic, there has yet to be a direct replication of this paper. A replication is warranted given the paper’s influence in the field and the implications of its results. The present experiment joins the recent replication effort by producing a five-lab replication using the original methodology. "", ""outcome"": ""mixed"", ""outcome_quote"": ""Results found overall high decoding accuracy (57%) when using emotion ratings aggregated for the sample of participants, similar to the method of analysis from the original study. However, when decoding accuracy was scored for each participant individually the average accuracy was much lower (31%). Unlike in the original study, the voice was found to be the most expressive instrument."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract gives agreeing high aggregate accuracy and a tested instrument finding explicitly unlike the original. No overall verdict overrides those comparisons.""}"
10.1371/journal.pone.0138922,1b9af749879bd4dc,1,,Cognitive style and religiosity: The role of conflict detection.,"Pennycook G, Cheyne JA, Barr N, Koehler DJ, Fugelsang JA.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Pennycook G, Cheyne JA, Barr N, Koehler DJ, Fugelsang JA."", ""year"": ""2013"", ""title"": ""Cognitive style and religiosity: The role of conflict detection."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": ""1"", ""replication_study_numbers"": """", ""evidence_quote"": ""Furthermore, in light of prior evidence linking the need for cognition (NFC) and religiosity [ 11 ], we also included a measure of need for cognition (NFC) at the end of the study to allow for exploratory analyses probing the relationship between NFC and religious beliefs; these analyses yielded additional support for the measurement order hypothesis."", ""outcome"": ""mixed"", ""outcome_quote"": ""These patterns mirror findings reported by Pennycook et al. (Study 1) [ 11 ]. When participants completed the religious beliefs measures first, however, NFC was no longer correlated with any of the religious beliefs measures: intrinsic religiosity r (205) = .06, p = .394; intuitive religious beliefs r (205) = .06, p = .384; belief in supernatural agents r (205) = .03, p = .647."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit exploratory re-test of NFC/religiosity relationship agrees under analytic-first order and fails under reversed order. The reference prints 2013 (despite volume issue metadata suggesting a later issue).""}"
10.1177/1091142114537892,990cdb9f33b9b199,0,,Coveting Thy Neighbor’s Manufacturing: The Dilemma of State Income Apportionment.,"Goolsbee Austan, Maydew Edward L.",2000,abstract,,unverified,unresolved,{},"{""authors"": ""Goolsbee Austan, Maydew Edward L."", ""year"": ""2000"", ""title"": ""Coveting Thy Neighbor’s Manufacturing: The Dilemma of State Income Apportionment."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""I gather data and attempt to replicate their analyses and findings."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": ""computational issues"", ""outcome_computational_quote"": ""I identify an apparent but inconsequential error in G&M’s sample, and I replicate the most widely cited result in the original article. Other results are substantively but not quantitatively replicated."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""When standard errors are clustered by state, as is now common econometric practice, lowering the weight on payroll in states’ corporate income tax apportionment formulae has no statistically significant impact on manufacturing employment."", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract explicitly reports numerical discrepancies in some original results and loss of significance under alternative standard errors. It also includes a newer-data extension; primary classification follows the re-analysis of the original data. Full text could further disambiguate the extent of numerical differences.""}"
10.1080/17470210903377380,55cf730a319892f9,1,10.1037/0278-7393.30.3.723,The time course of recovery for grammatical class information during lexical processing for syntactic construction,"Pechmann, T.; Garrett, M. F.; Zerbst, D.",2004,full_text,,unverified,unresolved,{},"{""authors"": ""Pechmann, T.; Garrett, M. F.; Zerbst, D."", ""year"": ""2004"", ""title"": ""The time course of recovery for grammatical class information during lexical processing for syntactic construction"", ""doi"": ""10.1037/0278-7393.30.3.723"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""If the word class effect observed here and by Pechmann and colleagues (2004 ; Pechmann & Zerbst, 2002 ) does not reflect a lexical effect, it would remove such evidence as support for models that assume word class constraints on lexical selection (e.g., Dell et al., 2008 ). In Experiment 2, we tried to establish whether a word class effect could be obtained when the variable imageability was controlled."", ""outcome"": ""failed"", ""outcome_quote"": ""Experiment 2 revealed that the word class effect could not be separated from the imageability effect: Naming latencies were sensitive to distractor imageability (see Lupker, 1979 ), but were not sensitive to distractor word class when imageability was controlled. These results conflict with the results of Pechmann and colleagues (2004 ; Pechmann & Zerbst, 2002 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly compare the tested word class effects to this original; outcome follows the reported agreement and disagreement.""}"
10.1016/j.jalz.2011.05.2412,22ff3d21c62fefc0,1,,Genome-wide association study identifies variants at CLU and PICALM associated with Alzheimer’s disease.,"Harold D, Abraham R, Hollingworth P, Sims R, Gerrish A, Hamshere ML, et al.",2009,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Harold D, Abraham R, Hollingworth P, Sims R, Gerrish A, Hamshere ML, et al."", ""year"": ""2009"", ""title"": ""Genome-wide association study identifies variants at CLU and PICALM associated with Alzheimer’s disease."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Furthermore, a consistent signal within CR1 gene was observed in a concurrent independent GWA study published by other European researchers, although no GWAS significance was achieved in that particular study [2]. Because the follow-up and replication of GWAS findings provide further validation of proposed signals, we decided to evaluate a CR1 marker with the most consistent association to AD (rs3818361) as a genetic modifying factor for AD risk in a sample of the Spanish population."", ""outcome"": ""successful"", ""outcome_quote"": ""Overall, the CR1 rs3818361 marker was not significantly associated to AD in this sample of the Spanish population."", ""outcome_quote_section"": ""fulltext"", ""outcome_confident"": false, ""outcome_reasoning"": ""The paper describes this original as a consistent CR1 signal without genome-wide significance; its own sample likewise shows a nonsignificant same-direction trend. Implicit agreement; less certain than the explicit comparison to Lambert. Original data included in meta-analysis do not alone constitute a separate reproduction.""}"
10.1109/reser.2011.12,2df82e49c9bfd95d,0,,,,2001,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": ""2001"", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""An article published in 2001 reported a controlled experiment that compared maintenance of small programs using design patterns with maintenance of equivalent programs using simplified design solutions. A replication of that experiment was published in 2004. In 2010, a group of researchers from multiple countries picked this experiment as the subject of an attempt to perform a joint replication: Many groups performing an experiment using the same setup, each contributing a few data points to a larger overall data set. This article reports on one of those sub-replications."", ""outcome"": ""successful"", ""outcome_quote"": ""Only one of the results is statistically significant; it confirms the result of the original experiment stating that the simplified version of the GR program could be extended more quickly than the pattern version which used the Abstract Factory and Composite patterns."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""The only explicit original-result comparison in the available abstract confirms the original. Other nonsignificant results are not explicitly compared, so the broader outcome remains uncertain.""}"
10.3389/fpsyg.2014.00875,10507719f2a93503,1,,Studies of similarity,"Tversky, A., Gati, I.",1978,full_text,,unverified,unresolved,{},"{""authors"": ""Tversky, A., Gati, I."", ""year"": ""1978"", ""title"": ""Studies of similarity"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": ""Experiment 4"", ""replication_study_numbers"": ""2a, 2b"", ""evidence_quote"": ""In Study 2 we attempted to replicate Experiment 4 in Tversky and Gati ( 1978 ) which was reported in Tversky ( 1977 ) as the second study providing support for the diagnosticity effect."", ""outcome"": ""statistically successful but flawed"", ""outcome_quote"": ""Thus, as the meta-analysis indicates, without eliminating possible substitution effects we replicate the original findings by Tversky ( 1977 ) and Tversky and Gati ( 1978 ). However, eliminating substitution effects strongly reduces the observed differences between conditions with averages of 2.89% (1a), 17.5% (1b), −1.21% (2a), and 1.24% (2b). Overall the size of differences between conditions, when substitution effects were eliminated, clustered around zero (see Figure 6 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors replicate the original choice pattern but identify substitution as a central confound; the effect disappears overall once that confound is eliminated. This is the paper’s main message, with the explicit joint verdict naming both originals.""}"
10.1017/ssh.2017.27,0245b18b007f60d7,1,10.1126/science.1251936,Inequality in the Long Run,"Piketty, Thomas, and Emmanuel Saez",2014,full_text,competing_supported_matches; conflicting_dois; same_author_year_siblings,correct,argon,"{""target_index"": 1, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""shipped_right"", ""corrected_value"": null, ""quote"": ""I replicate the figure from Science here as Figure 4. It reproduced the data in Figure 10.6 from Piketty’s book except it drops the point for 1810, but it now inexplicably adds a point for 1890 that isn't in the book’s version. The point plotted appears to be a simple linear interpolation between 1870 and 1910."", ""location"": ""results"", ""reason"": ""Duplicate / secondary review article rather than an omitted target. Sutch explicitly describes Piketty and Saez (2014) in Science as 'a coauthored review with Emmanuel Saez which presents his data for the top ten percent' that 'reproduced the data in Figure 10.6 from Piketty’s book,' and Sutch's empirical critique in that section analyzes Piketty's book spreadsheet (TS10.1DetailsUS) and Technical Appendix (Piketty 2014b). Per the codebook rules on ruling out another work by the same authors and a review versus the primary study, it is not a separate original target.""}","{""authors"": ""Piketty, Thomas, and Emmanuel Saez"", ""year"": ""2014"", ""title"": ""Inequality in the Long Run"", ""doi"": ""10.1126/science.1251936"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""At least in the issue of Science for May 23, 2014 he has a coauthored review with Emmanuel Saez which presents his data for the top ten percent but does not present the companion series for the top one percent [Piketty and Saez 2014: Figure 2, 839]. I replicate the figure from Science here as Figure 4. It reproduced the data in Figure 10.6 from Piketty’s book except it drops the point for 1810, but it now inexplicably adds a point for 1890 that isn't in the book’s version."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""fulltext"", ""outcome_computation"": ""computational issues"", ""outcome_computational_quote"": ""For 1980 Piketty reported that he averaged the 1983 figure from Wolff [1994] with the 1989 Federal Reserve figure from Kennickell [2009]. Had he done that, the number would be 67.7, but he reported 67.2 (which is the 1989 figure unaveraged)."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""For 1870 Piketty reports Soltow’s number taken from Lindert, 71 percent, but without applying the 1.2 multiplier that he used on the top one-percent wealth share, which consistency suggests he should have done. Had he done so, his 1870 figure would be 85.2 percent of the wealth in the hands of the top 10 percent. But that figure implies there was a fall in the wealth share between 1870 and 1910."", ""outcome_confident"": true, ""outcome_reasoning"": ""Reconstruction yields substantive discrepancies in reported shares; alternative constructions of the same source estimates qualify the historical trend.""}"
10.1371/journal.pone.0193787,ff87921f978478fb,0,,Implicit and explicit behavioral tendencies in male and female depression.,"Seidel E-M, Habel U, Finkelmeyer A, Schneider F, Gur RC, Derntl B.",2010,full_text,,unverified,unresolved,{},"{""authors"": ""Seidel E-M, Habel U, Finkelmeyer A, Schneider F, Gur RC, Derntl B."", ""year"": ""2010"", ""title"": ""Implicit and explicit behavioral tendencies in male and female depression."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Although we do not have previous genetic research to base our hypotheses on, based on clinical experiences, information processing theories in depression and the research by Seidel and colleagues [ 42 ], we expected avoidance of negative (sad, angry) facial expressions in remitted depressed S/L g -carriers who have experienced childhood trauma, as this represents the most vulnerable subgroup."", ""outcome"": ""failed"", ""outcome_quote"": ""In line with Seidel and colleagues [ 42 ], we expected automatic avoidance of angry faces as well. We did not find this, however."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The specific re-tested Seidel finding is automatic avoidance of angry faces, explicitly not found. New sad-face/genetic interaction results are not a successful replication of Seidel’s angry-face effect.""}"
10.3389/fmicb.2018.01598,93b6eb882efbcfbb,1,10.1016/j.jpedsurg.2014.01.060,Intestinal dysbiosis and bacterial enteroinvasion in a murine model of Hirschsprung’s disease.,"Pierre, J. F., Barlow-Anacker, A. J., Erickson, C. S., Heneghan, A. F., Leverson, G. E., Dowd, S. E.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Pierre, J. F., Barlow-Anacker, A. J., Erickson, C. S., Heneghan, A. F., Leverson, G. E., Dowd, S. E."", ""year"": ""2014"", ""title"": ""Intestinal dysbiosis and bacterial enteroinvasion in a murine model of Hirschsprung’s disease."", ""doi"": ""10.1016/j.jpedsurg.2014.01.060"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Previous work using murine models of HSCR and HAEC revealed intestinal dysbiosis associated with aganglionosis, indicating a potential role for intestinal microbiomes in the promotion of HAEC (\nWard et al., 2012\n;\nPierre et al., 2014\n). We examined the reproducibility of these findings and also investigated the contribution of inter-facility effects to microbiome variability in C57BL/6J mice, reproducing the findings of\nRausch et al. (2016)\non a smaller scale."", ""outcome"": ""successful"", ""outcome_quote"": ""Instead, Laramie Ednrb mice showed an enrichment of family Enterobacteriaceae from phylum Proteobacteria. Observations for these taxa are consistent with previously published work in another HSCR/HAEC mouse model (\nPierre et al., 2014\n) and shifts in Bacteroidetes (\nFrank et al., 2007\n;\nWalker et al., 2011\n) and Proteobacteria (\nFrank et al., 2007\n) have been reported in other IBD related to HAEC."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Introduction explicitly includes this paper among the dysbiosis findings re-tested; discussion compares concordant taxa.""}"
10.3389/fmicb.2018.01598,93b6eb882efbcfbb,2,10.1016/j.ijmm.2016.03.004,Analysis of factors contributing to variation in the c57bl/6j fecal microbiota across german animal facilities.,"Rausch, P., Basic, M., Batra, A., Bischoff, S. C., Blaut, M., Clavel, T.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""Rausch, P., Basic, M., Batra, A., Bischoff, S. C., Blaut, M., Clavel, T."", ""year"": ""2016"", ""title"": ""Analysis of factors contributing to variation in the c57bl/6j fecal microbiota across german animal facilities."", ""doi"": ""10.1016/j.ijmm.2016.03.004"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Previous work using murine models of HSCR and HAEC revealed intestinal dysbiosis associated with aganglionosis, indicating a potential role for intestinal microbiomes in the promotion of HAEC (\nWard et al., 2012\n;\nPierre et al., 2014\n). We examined the reproducibility of these findings and also investigated the contribution of inter-facility effects to microbiome variability in C57BL/6J mice, reproducing the findings of\nRausch et al. (2016)\non a smaller scale."", ""outcome"": ""successful"", ""outcome_quote"": ""The same facility-specific effect was also seen in fecal samples from C57BL/6J mice. These effects were independent of sex or cage influences. Our findings in C57BL/6J mice are consistent with a previous report (\nRausch et al., 2016\n)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Specific facility-effect replication explicitly stated and confirmed.""}"
10.1002/smj.3287,29734a0e5b3fc844,0,,,Leiponen and Helfat,2010,abstract,,unverified,unresolved,{},"{""authors"": ""Leiponen and Helfat"", ""year"": ""2010"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The well‐known study by Leiponen and Helfat (2010) examined how firms increased their odds of innovation success by pursuing multiple parallel innovation objectives and knowledge sources. We replicate their study across geographic and temporal contexts using three sets of data: from Finland ( N = 884) in 2006–2008 and from other European countries in two different time periods ( N = 36,480 in 2006–2008 and 24,326 in 2008–2010)."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our results largely corroborate their core findings of the direct effects. We also find no evidence of diminishing returns to the breadth of innovation objectives, and we find at best slight evidence of diminishing returns to the breadth of knowledge sources. However, we find evidence of a significant negative interaction between knowledge sources and innovation objectives, contrary to Leiponen and Helfat's (2010) finding of a lack of evidence in a positive interaction."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true}"
10.1016/j.jpsychires.2021.06.021,9e82bfa4e08b1a5a,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We investigate if we in an independent MDD sample can replicate abnormal findings of EEG-vigilance regulation during rest and as a predictor for antidepressive treatment response."", ""outcome"": ""successful"", ""outcome_quote"": ""This replication study supports the diagnostic value of EEG-vigilance regulation and its usefulness as a biomarker for the choice of treatment in MDD."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors give an overall supportive verdict. Diagnostic group difference replicated; response prediction depends on criteria. Overall verdict governs. The abstract does not identify the original paper(s).""}"
10.51910/ijhdr.v11i40.598,d7591f8fdbd060c8,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Three series including five independent blinded and randomised experiments each were carried out in the same way as in the original study. Only time and conductor of experiments were modified."", ""outcome"": ""failed"", ""outcome_quote"": ""No specific effects of agitated dilutions of gibberellic acid were found in the first two replication series (p=0.263 and p=0.062). In the third serie with gibbous Lemna gibba L. we observed a significant effect (p=0.009) of the homeopathic treatment, however growth was increased in contrast to decreasing in the former study."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The first two series show no original effect and the third shows the opposite direction. The abstract identifies no bibliographic entry for the former study; no target citation is guessed.""}"
10.1016/j.jml.2022.104352,23e78360aaf0d0af,1,10.1121/1.408177,Training Japanese listeners to identify English /r/ and /l/. II: The role of phonetic environment and talker variability in learning new perceptual categories,"Lively, S. E., Logan, J. S., & Pisoni, D. B.",1993,full_text,,unverified,unresolved,{},"{""authors"": ""Lively, S. E., Logan, J. S., & Pisoni, D. B."", ""year"": ""1993"", ""title"": ""Training Japanese listeners to identify English /r/ and /l/. II: The role of phonetic environment and talker variability in learning new perceptual categories"", ""doi"": ""10.1121/1.408177"", ""identified_by"": ""citation"", ""study_numbers"": ""2"", ""replication_study_numbers"": """", ""evidence_quote"": ""The goal of the current paper is to replicate the key experiments from Logan et al. (1991) and Lively et al. (1993) and test the hypothesis that using high variability input (specifically, input with multiple talkers) leads to more generalisation in phonetic learning than when low variability input is used."", ""outcome"": ""failed"", ""outcome_quote"": ""The current study attempted to replicate the findings of seminal work by Logan and colleagues (1991) and Lively and colleagues (1993), which found that phonetic training with multiple talkers led to greater generalization to novel talkers than single talker training. Across two different measures, our study found no evidence of such effect in a sample of 166 participants. Bayes Factor analyses found that in each case the evidence for a variability benefit was ambiguous."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Central multiple-talker advantage was not supported; ambiguous Bayes factors do not establish the null. Positive general phonetic learning is ancillary to the central contrast.""}"
10.1037/tmb0000086,1c66ad66043de6d2,1,10.1177/09567976211024535,How accurate are accuracy-nudge interventions? A preregistered direct replication of Pennycook et al. (2020).,"Roozenbeek, J., Freeman, A. L. J., & van der Linden, S.",2021,full_text,,unverified,unresolved,{},"{""authors"": ""Roozenbeek, J., Freeman, A. L. J., & van der Linden, S."", ""year"": ""2021"", ""title"": ""How accurate are accuracy-nudge interventions? A preregistered direct replication of Pennycook et al. (2020)."", ""doi"": ""10.1177/09567976211024535"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""The\npresent study aims to replicate Pennycook et al. and test whether\nﬁndings from Pennycook et al. or Roozenbeek et al. are replicated in\na third U.S. sample."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our ﬁndings\nare in partial agreement with Roozenbeek and colleagues. The\naccuracy nudge did not decrease willingness to share false general\nCOVID-19 information in Kyrgyzstan or the United States. In India,\nthe accuracy nudge did decrease willingness to share general\nCOVID-19 misinformation. However, in full agreement with Roo-\nzenbeek and colleagues, we found strong evidence suggesting\nthat the accuracy nudge does not signiﬁcantly increase the spread\nof true information in any of the three countries."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Aggregated across the two replication studies and three country samples; authors explicitly describe partial or mixed replication. Vaccine-specific measures extend the original claim.""}"
10.1027/1618-3169/a000554,bb552c10b784b963,0,10.1016/s0022-5371(80)90403-x,Auditory encoding in visual short-term recall: Effects of noise intensity and spatial location.,"Colle, H. A.",1980,full_text,,unverified,unresolved,{},"{""authors"": ""Colle, H. A."", ""year"": ""1980"", ""title"": ""Auditory encoding in visual short-term recall: Effects of noise intensity and spatial location."", ""doi"": ""10.1016/s0022-5371(80)90403-x"", ""identified_by"": ""citation"", ""study_numbers"": ""1, 2, 3"", ""replication_study_numbers"": """", ""evidence_quote"": ""In all seven experiments conducted so far, the changing-state effect on serial recall was independent of intensity (Colle, 1980; Ellermeier & Hellbrück, 1998; Schlittmeier et al., 2008; Tremblay & Jones, 1999), and this was also the case in the present study."", ""outcome"": ""mixed"", ""outcome_quote"": ""We replicated the classic finding that the increased disruption by changing-state relative to steady-state sequences is independent of intensity. Contrary to previous studies, we found an unexpected main effect of intensity. Steady-state and changing-state sequences presented at 75 dB(A) were more disruptive than presented at 45 dB(A), suggesting that intensity plays a more important role than previously assumed in the disruption of working memory performance."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly confirm intensity-independent changing-state disruption but contrast their overall intensity effect with this original’s reported null intensity effect. Both comparisons concern the same target."", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """"}"
