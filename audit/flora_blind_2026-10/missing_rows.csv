10.46867/ijcp.2018.31.01.13,12db194db4781556,1,,Belief attribution tasks with dolphins: What social minds can reveal about animal rationality.,"Tschudin, A.",2006,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Tschudin, A."", ""year"": ""2006"", ""title"": ""Belief attribution tasks with dolphins: What social minds can reveal about animal rationality."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""When we designed our FBT study, our goal was to replicate the study conducted by Tschudin (2001,\n2006) using the same methodology. For this reason, we did not seek to modify or improve the methodology."", ""outcome"": ""failed"", ""outcome_quote"": ""After a total of nine months with over 1000 training and probe trials, the dolphin never achieved the\nstandard criterion set for acceptable performance (Table 3, Figure 1). Despite all of these trials, trying to train\na concept- naïve dolphin resulted in a failure to demonstrate competency at invisible displacement of a fish in\ncontainers and to provide experimental evidence of ToM using the FBT."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors report failed preliminary performance and failed false-belief trials. They critique validity but do not explicitly declare this attempt incapable of adjudication. Both cited Tschudin works are explicitly named as replication targets; Call and Tomasello supplies protocol details and is not a separately retested original.""}"
10.1037/cou0000322,3207750cb8d5c1a4,0,10.1037/a0034943,The association of therapist empathy and synchrony in vocally encoded arousal.,"Imel ZE, Barco JS, Brown HJ, Baucom BR, Baer JS, Kircher JC, & Atkins DC",2014,full_text,same_author_year_siblings,unverified,unresolved,{},"{""authors"": ""Imel ZE, Barco JS, Brown HJ, Baucom BR, Baer JS, Kircher JC, & Atkins DC"", ""year"": ""2014"", ""title"": ""The association of therapist empathy and synchrony in vocally encoded arousal."", ""doi"": ""10.1037/a0034943"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""In the present project, we sought to replicate the study by Imel et al. (2014b) within two large samples (N = 208 and N = 204) of clinical interactions with real patients from two independent studies of Swiss French-speaking samples."", ""outcome"": ""failed"", ""outcome_quote"": ""In the present analysis, we aimed to replicate the study by Imel et al. (2014b) by evaluating potential associations of vocal synchrony with empathy ratings using two large samples (N = 208 and N = 204) of clinical interactions with real patients. Findings showed no support for our hypothesis that mean F0 synchrony between clinicians and patients would be higher in high-empathy sessions based on empathy ratings measured using traditional, labor intensive, behavioral coding. This lack of replication was consistent for both clinical samples (brief MI with young men and general practice consultation), both behavioral coding instruments (Empathy global rating from the MISC and TES scale), and both levels of analysis (session-level and minute-level synchrony)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors give an explicit failure verdict across both independent samples, both instruments and both levels of synchrony.""}"
