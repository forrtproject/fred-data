10.1093/her/cyt088,bf2a9ccd3826c797,1,,30-month quasi-experimental evaluation follow-up of a national primary school HIV intervention in Kenya.,"Maticka-Tyndale E, Wildish J, Gichuru M.",2010,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Maticka-Tyndale E, Wildish J, Gichuru M."", ""year"": ""2010"", ""title"": ""30-month quasi-experimental evaluation follow-up of a national primary school HIV intervention in Kenya."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The objective of this article is to assess whether\nthe gains made in pupil knowledge, self-efficacy\nrelated to sexual restraint and condom use and behaviour change observed in 18- and 30-month\nevaluations in Nyanza Province [18, 21] are replicated in diverse regions of the country."", ""outcome"": ""successful"", ""outcome_quote"": ""This article does provide a response to a limitation\nacknowledged in the earlier papers that reported results for only Nyanza Province. The replicability of\nthat earlier research beyond Nyanza is no longer in\nquestion."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors give an overall verdict that the earlier findings replicate beyond Nyanza. This covers both explicitly targeted evaluations despite some less favourable individual outcomes.""}"
10.1167/iovs.14-15390,74f17c0afe5e7c4a,0,,Association and familial segregation of CTG18.1 trinucleotide repeat expansion of TCF4 gene in Fuchs' endothelial corneal dystrophy,"Mootha VV, Gong X, Ku HC, Xing C.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Mootha VV, Gong X, Ku HC, Xing C."", ""year"": ""2014"", ""title"": ""Association and familial segregation of CTG18.1 trinucleotide repeat expansion of TCF4 gene in Fuchs' endothelial corneal dystrophy"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our group replicated the association with 120 FECD cases and 100 controls, finding that one copy of the expanded CTG18.1 allele increased risk of disease by 32.3-fold (95% confidence interval [CI], 13.4-77.6). 27 We found the OR of each copy of the expanded allele estimated to be 66.5 (95% CI: 12.6-350.1) in the Chinese population, mirroring its extremely high OR in Caucasians of 32.3 (95% CI: 13.4-77.6). 27"", ""outcome"": ""successful"", ""outcome_quote"": ""We found the OR of each copy of the expanded allele estimated to be 66.5 (95% CI: 12.6-350.1) in the Chinese population, mirroring its extremely high OR in Caucasians of 32.3 (95% CI: 13.4-77.6). 27"", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""Authors expressly compare the Chinese association with the preceding Caucasian replication and describe mirrored large effects and transethnic replication.""}"
