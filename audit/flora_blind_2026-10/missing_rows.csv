10.1111/acer.13039,03222dc924be9b01,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""A preliminary psychometric evaluation in a U.S. college sample showed support for 8 factors that were invariant across gender and that loaded onto a single higher-order alcohol-related problems factor."", ""outcome"": ""successful"", ""outcome_quote"": ""Our study provides an important replication of the psychometrics of the YAACQ in a new sample, and we extend previous work by presenting novel tests of measurement invariance across meaningful groups in young adulthood."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly describe their study as a replication of the psychometrics. The abstract does not give the original citation or reference list.""}"
10.1086/686223,32c8449e8e855530,0,,,"Spencer, Goldstein, Sherman, et al.",2013,abstract,,unverified,unresolved,{},"{""authors"": ""Spencer, Goldstein, Sherman, et al."", ""year"": ""2013"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In 2013, Spencer, Goldstein, Sherman, et al. reported the promising effects of a supplemental, technology-assisted, storybook intervention (Tier 2) containing embedded instruction targeting the oral language learning of preschool children at risk for delays. We sought to advance knowledge of the intervention by replicating it in a new sample and examining children’s responses to the narrator’s instructional prompts and associations with learning outcomes."", ""outcome"": ""successful"", ""outcome_quote"": ""Exposure to the intervention accelerated children’s weekly oral language learning, and effect sizes were comparable to those of Spencer et al."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract explicitly compares the intervention effects to Spencer et al. and reports comparable effects.""}"
10.1177/2053168016652420,216578f767969de4,1,,African American Power and Politics: The Political Context Variable,"Walton H, Jr.",1997,full_text,,correct,argon,"{""target_index"": 1, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""shipped_right"", ""corrected_value"": null, ""quote"": ""Like Walton (1997: Table 4.3), we trace racial discourse over time and across journals. Figure 2 contains separate scatterplots for each journal."", ""location"": ""Analysis and discussion (lines 181–183, 208–210, 234, 269) and Conclusion (lines 326–333)"", ""reason"": ""Walton (1997, Chapter 4) is a companion book chapter by the first author covering the same PSQ/APSR research program as Walton et al. (1995) and is cited only for conceptual background and as an analytical parallel ('Like Walton (1997: Table 4.3), we trace racial discourse over time and across journals'). Both Figure 1 and Figure 2 explicitly identify the 54-article corpus as the 'Walton et al. Replication Dataset, 1894–1990 (N = 54)' from Walton et al. (1995: Appendix 1), and the paper neither states a distinct empirical finding from Walton (1997) nor reports a separate replication verdict for it. Omitting a second row for Walton (1997) is therefore not an error.""}","{""authors"": ""Walton H, Jr."", ""year"": ""1997"", ""title"": ""African American Power and Politics: The Political Context Variable"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Like Walton (1997:\nTable 4.3), we trace racial discourse over time and across\njournals."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""introduction"", ""outcome_computation"": ""not checked"", ""outcome_computational_quote"": ""By building an instrument that gets at\nwhat Walton and his colleagues observe, we re-analyze\ntheir corpus of text in novel ways and apply our instrument\nto current articles in top-tier political science journals."", ""outcome_robustness"": ""robust"", ""outcome_robustness_quote"": ""This\nreplication-and-extension confirms not only that ours and\nWalton’s operationalizations are empirically comparable\nbut also that the former can serve as a proxy for the\nlatter when reviewing the race literature."", ""outcome_confident"": true, ""outcome_reasoning"": ""The original 54-publication corpus is re-analyzed using an alternative automated measure of centrality, rather than rerunning the original numerical analysis. The authors explicitly conclude the operationalizations are comparable and the original findings hold up to re-examination. New journal articles in the extension are not treated as robustness tests of original data.""}"
10.1101/144733,2a634d89a5ebc169,1,,Response latencies in discriminations of recency.,"Muter, P.",1979,full_text,,unverified,unresolved,{},"{""authors"": ""Muter, P."", ""year"": ""1979"", ""title"": ""Response latencies in discriminations of recency."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The classic ﬁnding from short-term relative JOR tasks is that correct response time (RT) depends on the lag to the more recent item but not to the less recent item (see Fig. 1, Muter, 1979; Hacker, 1980; Hockley, 1984)."", ""outcome"": ""successful"", ""outcome_quote"": ""This study replicated the classical ﬁnding in a relative JOR task that correct RT depends on the lag to the more recent probe but not on the lag to the less recent probe (Fig. 2b)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper explicitly replicates the classic correct-RT finding attributed jointly to these papers and confirms it in the discussion.""}"
