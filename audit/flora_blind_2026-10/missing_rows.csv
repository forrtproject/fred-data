10.1176/appi.ajp.20240596,710274e3f91fa9e3,0,10.1056/NEJM199801223380401,Differential behavioral effects of gonadal steroids in women with and in those without premenstrual syndrome.,"Schmidt, PJ, Nieman, LK, Danaceau, MA, et al.",1998,full_text,,unverified,unresolved,{},"{""authors"": ""Schmidt, PJ, Nieman, LK, Danaceau, MA, et al."", ""year"": ""1998"", ""title"": ""Differential behavioral effects of gonadal steroids in women with and in those without premenstrual syndrome."", ""doi"": ""10.1056/NEJM199801223380401"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We evaluated differences between cohorts, attempted to replicate our original findings of a differential behavioral sensitivity to otherwise similar changes in ovarian steroids in women with PMDD compared to healthy comparison women (3), and examined several as yet unanswered questions about the effects of ovarian steroids on symptoms in these women."", ""outcome"": ""successful"", ""outcome_quote"": ""This confirms and replicates our original finding that women with PMDD and healthy comparison women who do not have PMDD have different behavioral responses to the same physiological exposures to both estradiol and progesterone, a phenomenon that, in this experimental paradigm, distinguishes women with PMDD from women without."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly state that the differential hormone sensitivity finding was confirmed and replicated. Progesterone-specific irritability/mood-swings dissociation is framed as an extension newly detectable in the enlarged sample, while the central reproduction of the behavioral phenotype receives an overall affirmative verdict.""}"
10.1007/s42822-025-00229-1,caf2c8efd71be3f8,0,10.1007/s12147-017-9189-6,Comparing implicit gender stereotypes between women and men with the Implicit Relational Assessment Procedure.,"Drake, C. E., Primeaux, S., & Thomas, J.",2018,abstract,,unverified,unresolved,{},"{""authors"": ""Drake, C. E., Primeaux, S., & Thomas, J."", ""year"": ""2018"", ""title"": ""Comparing implicit gender stereotypes between women and men with the Implicit Relational Assessment Procedure."", ""doi"": ""10.1007/s12147-017-9189-6"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The present study systematically replicated the procedures of Drake et al. (2018) and employed the IRAP to assess general gender stereotypes among Japanese university students, who live in a society where gender inequality remains a pressing issue."", ""outcome"": ""successful"", ""outcome_quote"": ""Overall, the results generally replicated those of Drake et al. (2018), demonstrating stereotype-consistent responses in a Japanese sample."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract states an overall verdict that the results generally replicated the target.""}"
