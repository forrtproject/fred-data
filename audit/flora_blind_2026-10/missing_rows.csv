10.1177/0956797617747090,41a25a0b35cfc34c,0,,Eye movements reveal sustained implicit processing of others’ mental states.,"Schneider, D., Bayliss, A. P., Becker, S. I., & Dux, P. E.",2012,full_text,,unverified,unresolved,{},"{""authors"": ""Schneider, D., Bayliss, A. P., Becker, S. I., & Dux, P. E."", ""year"": ""2012"", ""title"": ""Eye movements reveal sustained implicit processing of others’ mental states."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""In the original studies, 14-month-old children (Surian & Geraci, 2012), adults (Schneider et al., 2012), or both children from the age of 2 years and adults (Low & Watts, 2013; Senju et al., 2009; Southgate et al., 2007) revealed anticipatory-looking patterns suggestive of belief-based anticipation in both their first looks and overall looking time. The current study exactly replicated the methods described in the original articles, using original stimuli and protocols, which were generously shared with us by the authors (for details, see Supplement A in the Supplemental Material available online)."", ""outcome"": ""mixed"", ""outcome_quote"": ""The original results were thus only partially replicated: As in the original study, there was a significant Belief × Location interaction on looking times. But unlike in the original study, this was not due to the crucial difference in looking to the no-object location (participants looked longer to this location in the false-belief than in the truebelief condition)."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly call these results partially replicated: the interaction agreed but the crucial no-object contrast did not; Study 2 produced the same pattern.""}"
10.1177/0956797617747090,41a25a0b35cfc34c,1,,Where will the triangle look for it? Attributing false beliefs to a geometric shape at 17 months.,"Surian, L., & Geraci, A.",2012,full_text,,unverified,unresolved,{},"{""authors"": ""Surian, L., & Geraci, A."", ""year"": ""2012"", ""title"": ""Where will the triangle look for it? Attributing false beliefs to a geometric shape at 17 months."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""In the original studies, 14-month-old children (Surian & Geraci, 2012), adults (Schneider et al., 2012), or both children from the age of 2 years and adults (Low & Watts, 2013; Senju et al., 2009; Southgate et al., 2007) revealed anticipatory-looking patterns suggestive of belief-based anticipation in both their first looks and overall looking time. The current study exactly replicated the methods described in the original articles, using original stimuli and protocols, which were generously shared with us by the authors (for details, see Supplement A in the Supplemental Material available online)."", ""outcome"": ""mixed"", ""outcome_quote"": ""The Kulke et al. present study thus replicated only the original negative findings but not the positive ones."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly distinguish replicated null findings from positive findings that did not replicate.""}"
10.1177/0956797617747090,41a25a0b35cfc34c,2,,Attributing false beliefs about object identity reveals a signature blind spot in humans’ efficient mind-reading system.,"Low, J., & Watts, J.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Low, J., & Watts, J."", ""year"": ""2013"", ""title"": ""Attributing false beliefs about object identity reveals a signature blind spot in humans’ efficient mind-reading system."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 3a, 3b"", ""evidence_quote"": ""In the original studies, 14-month-old children (Surian & Geraci, 2012), adults (Schneider et al., 2012), or both children from the age of 2 years and adults (Low & Watts, 2013; Senju et al., 2009; Southgate et al., 2007) revealed anticipatory-looking patterns suggestive of belief-based anticipation in both their first looks and overall looking time. The current study exactly replicated the methods described in the original articles, using original stimuli and protocols, which were generously shared with us by the authors (for details, see Supplement A in the Supplemental Material available online)."", ""outcome"": ""statistically successful but flawed"", ""outcome_quote"": ""In sum, the original pattern of belief-congruent looking could be reproduced only under conditions in which the belief congruency of the locations is confounded with additional factors, and therefore, this pattern might not reflect belief-based anticipation."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The original materials yielded the effect, but the target-specific main message is that removing confounds eliminated belief-congruent anticipation and invalidated its interpretation as implicit theory of mind.""}"
10.1177/0956797617747090,41a25a0b35cfc34c,4,,Mindblind eyes: An absence of spontaneous theory of mind in Asperger syndrome.,"Senju, A., Southgate, V., White, S., & Frith, U.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Senju, A., Southgate, V., White, S., & Frith, U."", ""year"": ""2009"", ""title"": ""Mindblind eyes: An absence of spontaneous theory of mind in Asperger syndrome."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""In the original studies, 14-month-old children (Surian & Geraci, 2012), adults (Schneider et al., 2012), or both children from the age of 2 years and adults (Low & Watts, 2013; Senju et al., 2009; Southgate et al., 2007) revealed anticipatory-looking patterns suggestive of belief-based anticipation in both their first looks and overall looking time. The current study exactly replicated the methods described in the original articles, using original stimuli and protocols, which were generously shared with us by the authors (for details, see Supplement A in the Supplemental Material available online)."", ""outcome"": ""failed"", ""outcome_quote"": ""The overall original findings were not replicated, whereas a differential analysis of the False Belief 1 and False Belief 2 conditions suggests that only the False Belief 1 condition could be replicated."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly group this original with Southgate 2007 and state an overall nonreplication verdict. The neurotypical anticipatory-looking result is the tested finding, rather than the autism group contrast.""}"
