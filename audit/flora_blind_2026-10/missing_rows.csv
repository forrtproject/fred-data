10.1177/2053168018822174,6070e18087845e69,1,,The framing of decisions and the psychology of choice.,Tversky A and Kahneman D,1981,full_text,,unverified,unresolved,{},"{""authors"": ""Tversky A and Kahneman D"", ""year"": ""1981"", ""title"": ""The framing of decisions and the psychology of choice."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""Tversky and Kahneman (1981) show that people take the riskier option when in a “loss frame” rather than a “gain frame.”"", ""outcome"": ""successful"", ""outcome_quote"": ""Lacking a US national sample benchmark, it is unclear how to grade Lucid’s performance relative to MTurk, though we would argue that the qualitative conclusions drawn from the experiment are the same across all samples."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors report agreement with the original experimental finding.""}"
10.1177/2053168018822174,6070e18087845e69,2,,Risk orientations and policy frames.,Kam CD and Simas EN,2010,full_text,,unverified,unresolved,{},"{""authors"": ""Kam CD and Simas EN"", ""year"": ""2010"", ""title"": ""Risk orientations and policy frames."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Our third experiment replicates Kam and Simas (2010), who show that risk acceptance correlates with choosing the risky option in an Asian Disease-type experiment, but that the treatment effect of the mortality frame does not vary appreciably with risk acceptance."", ""outcome"": ""successful"", ""outcome_quote"": ""This finding was replicated in both MTurk and Lucid samples."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors report agreement with the original experimental finding.""}"
