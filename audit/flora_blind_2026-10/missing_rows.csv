10.1080/23273798.2016.1197954,3eb87368cec5640c,5,10.1177/0267658310382068,Adding more fuel to the fire: An eye-tracking study of idiom processing by native and non-native speakers.,"Siyanova-Chanturia, A., Conklin, K., & Schmitt, N.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Siyanova-Chanturia, A., Conklin, K., & Schmitt, N."", ""year"": ""2011"", ""title"": ""Adding more fuel to the fire: An eye-tracking study of idiom processing by native and non-native speakers."", ""doi"": ""10.1177/0267658310382068"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""Furthermore, idioms as a whole received shorter gaze durations than phrases, an effect that has also previously been observed in English (Siyanova-Chanturia, Conklin, & Schmitt, 2011)."", ""outcome"": ""successful"", ""outcome_quote"": ""Furthermore, idioms as a whole received shorter gaze durations than phrases, an effect that has also previously been observed in English (Siyanova-Chanturia, Conklin, & Schmitt, 2011)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly compare the tested finding with this original.""}"
10.1007/s10834-024-09975-7,846f605411d9c84d,0,10.1007/s10566-023-09768-3,Crianza positiva: Combining group workshops and E-messages to strengthen parenting competences.,"Balsa, A. I., Bloomfield, J., Cid, A., Gómez-Muzzio, E., González, M. L., & Valdés, R.",2023,abstract,,unverified,unresolved,{},"{""authors"": ""Balsa, A. I., Bloomfield, J., Cid, A., Gómez-Muzzio, E., González, M. L., & Valdés, R."", ""year"": ""2023"", ""title"": ""Crianza positiva: Combining group workshops and E-messages to strengthen parenting competences."", ""doi"": ""10.1007/s10566-023-09768-3"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Using an experimental design involving 39 early childhood centers (687 families), we find no effects of the intervention on the outcomes of interest. This finding contrasts with those found in a previous edition of the program in 2018, which showed improvements in parental involvement, in the quality of parent–child interaction, and in adult–child language patterns (Balsa in Child & Youth Care Forum 53:1–22, 2023a; Balsa in Behavioural Public Policy 7: 607–643, 2023c; Bloomfield in Review of the Economics of the Household 21:95–130, 2023)."", ""outcome"": ""failed"", ""outcome_quote"": ""Using an experimental design involving 39 early childhood centers (687 families), we find no effects of the intervention on the outcomes of interest. This finding contrasts with those found in a previous edition of the program in 2018, which showed improvements in parental involvement, in the quality of parent–child interaction, and in adult–child language patterns (Balsa in Child & Youth Care Forum 53:1–22, 2023a; Balsa in Behavioural Public Policy 7: 607–643, 2023c; Bloomfield in Review of the Economics of the Household 21:95–130, 2023)."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract explicitly contrasts the null intervention results with the improvements reported in this named set of three previous papers. This verdict covers each member of that set.""}"
