10.1080/00224545.2025.2482014,86b1eb2ebf5e0d8f,0,,,"Hall, Schwartz, and Duong",2021,abstract,,unverified,unresolved,{},"{""authors"": ""Hall, Schwartz, and Duong"", ""year"": ""2021"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": ""2"", ""replication_study_numbers"": """", ""evidence_quote"": ""The current paper (N = 549) is a replication of Hall, Schwartz, and Duong (2021, Study 2) using a highly similar study procedure, with a small extension consisting of items from an emotional contagion scale."", ""outcome"": ""mixed"", ""outcome_quote"": ""We consider this to be a successful partial replication of Hall et al.’s (2021) findings."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The overall abstract verdict explicitly calls this a partial replication; the factor structure did not replicate but item rankings did.""}"
10.1080/146324400363491,1f20794bc92538d5,0,,,Cooper et al.,,abstract,,unverified,unresolved,{},"{""authors"": ""Cooper et al."", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study tries to adhere to ideals such as Cooper et al's by replicating and extending a theory-driven study of the effects of initial conditions on new venture performance using a very large (700 + cases) and high quality, longitudinal data set."", ""outcome"": ""mixed"", ""outcome_quote"": ""On a conceptual level, the studies results confirm those obtained by Cooper et al . regarding how general human capital, management know-how and industry affect marginal survival probability, as well as concerning the effects of financial and general human capability on the likelihood of becoming a high performance venture. The results sometimes coincide also on a very detailed level, such as the differential effect of gender on marginal survival vs its effect on high performance. Other parts of Cooper et al's results could not be replicated."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract explicitly confirms several findings and says other parts could not be replicated. Full citation not available in saved abstract; no reference inferred.""}"
10.5465/amproc.2026.13271abstract,f96339d6998665a9,0,,,"Kim, Shaver, and Funk",2022,abstract,,unverified,unresolved,{},"{""authors"": ""Kim, Shaver, and Funk"", ""year"": ""2022"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study presents a systematic replication of Kim, Shaver, and Funk's (2022) novel framework for measuring the dynamics of industry clusters."", ""outcome"": ""successful"", ""outcome_quote"": ""Our reproductions and exact replications validate the original findings reported by Kim et al. (2022) for the semiconductor industry, confirming the reliability of the measurement framework."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": ""cannot_be_determined"", ""outcome_computational_quote"": """", ""outcome_robustness"": ""cannot_be_determined"", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit validation verdict covers the original semiconductor findings. The abstract also reports reproductions but does not establish numerical agreement or robustness on the original data; supplemental axes are unresolved.""}"
10.1227/neu.0000000000004151,5f1e1e79f9fc8e61,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We were able to replicate the use of several PLR metrics as a biomarker for mTBI diagnosis that could easily be included with standard clinical measures."", ""outcome"": ""successful"", ""outcome_quote"": ""We were able to replicate the use of several PLR metrics as a biomarker for mTBI diagnosis that could easily be included with standard clinical measures."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract gives an overall replication-success verdict. It does not identify a particular earlier paper; one unidentified target represents the stated replication, with target count uncertain.""}"
10.1016/j.jbvi.2020.e00161,d7b616dc4adf8f1e,0,,,,2010,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": ""2010"", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this work, we replicate and extend the study by Monsen et al. (2010) that simultaneously considers financial and non-financial factors as motivators for employee participation in CVs."", ""outcome"": ""successful"", ""outcome_quote"": ""Our replication results largely support prior findings and indicate that the extra effort required for participating in a corporate venture is the most important factor driving employees’ decision."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Overall verdict largely supports prior findings; no explicit contrast in available abstract. New extensions are not failures of original results.""}"
10.1016/j.jvb.2013.06.007,e92a7cc95ddcbf0a,0,,Rule breaking in adolescence and entrepreneurial status: An empirical investigation.,"Zhang, Z. & Arvey, R.D.",2009,abstract,same_author_year_siblings,unverified,unresolved,{},"{""authors"": ""Zhang, Z. & Arvey, R.D."", ""year"": ""2009"", ""title"": ""Rule breaking in adolescence and entrepreneurial status: An empirical investigation."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Drawing from Zhang and Arvey's retrospective study [Zhang, Z. & Arvey, R.D. (2009). Rule breaking in adolescence and entrepreneurial status: An empirical investigation. Journal of Business Venturing, 24(5), 436–447], which found a link between entrepreneurship status of male adults and their recalled early antisocial rule-breaking behavior in adolescence, the present study utilized prospective longitudinal data from a Swedish cohort study to clarify the connection between antisocial rule-breaking, crime, and entrepreneurship by applying a developmental perspective."", ""outcome"": ""successful"", ""outcome_quote"": ""Drawing from Zhang and Arvey's retrospective study [Zhang, Z. & Arvey, R.D. (2009). Rule breaking in adolescence and entrepreneurial status: An empirical investigation. Journal of Business Venturing, 24(5), 436–447], which found a link between entrepreneurship status of male adults and their recalled early antisocial rule-breaking behavior in adolescence, the present study utilized prospective longitudinal data from a Swedish cohort study to clarify the connection between antisocial rule-breaking, crime, and entrepreneurship by applying a developmental perspective. Regression results, which controlled for early socioeconomic background and intellectual competencies, indeed identified early antisocial rule-breaking behavior in adolescence as a valid positive predictor of a subsequent entrepreneurial career in adulthood in men (but not in women)."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Original male-adult finding and corresponding new longitudinal male-sample result are explicitly stated. Women and registered crime are extensions, not failures of the original male-sample finding.""}"
10.1126/science.aac4716,9fed70371eeb17ff,58,,Social identity contingencies: how diversity cues signal threat or safety for African Americans in mainstream institutions,"Purdie-Vaughns, V., Steele, C. M., Davies, P. G., Ditlmann, R., & Crosby, J. R.",2008,full_text,,unverified,unresolved,{},"{""authors"": ""Purdie-Vaughns, V., Steele, C. M., Davies, P. G., Ditlmann, R., & Crosby, J. R."", ""year"": ""2008"", ""title"": ""Social identity contingencies: how diversity cues signal threat or safety for African Americans in mainstream institutions"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": ""2"", ""replication_study_numbers"": """", ""evidence_quote"": ""Replication of “Social identity contingencies: How diversity cues signal threat or safety for African Americans in mainstream institutions” by V Purdie-Vaughns, CM Steele, PG Davies, R Ditlmann, JR Crosby (2008, Journal of Personality and Social Psychology). Kathleen Schmidt kes7z@virginia.edu"", ""outcome"": ""failed"", ""outcome_quote"": ""Confirmatory analyses did not replicate the original finding that fairness cues create more trust for Black but not White participants in an environment with low-minority representation. Exploratory analyses showed a pattern of results in the opposite direction: White participants responded to high fairness cues by feeling more trust to a greater degree than Black participants. The interaction between race and fairness cue did not impact identity contingent evaluations. Data Preparation Data were transposed into short form and cleaned by recoding variables into the appropriate formats."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Individual primary replication report: authors’ verdict and comparisons to this original, prioritizing an overall verdict when stated.""}"
