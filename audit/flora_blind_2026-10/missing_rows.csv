10.7717/peerj.4217,78b567dd3205b6ce,3,10.1080/713754314,A reaching test reveals weak hand preference in specific language impairment and developmental co-ordination disorder,"Hill, E., & Bishop, D.",1998,full_text,,unverified,unresolved,{},"{""authors"": ""Hill, E., & Bishop, D."", ""year"": ""1998"", ""title"": ""A reaching test reveals weak hand preference in specific language impairment and developmental co-ordination disorder"", ""doi"": ""10.1080/713754314"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In particular, our failure to replicate a between-groups difference in the probability of reaching across the midline with the right hand indicates that this may not be a marker of compromised neurodevelopment relevant to language disorder, as previously suggested (Bishop, 2005; Hill & Bishop, 1998)."", ""outcome"": ""failed"", ""outcome_quote"": ""In particular, our failure to replicate a between-groups difference in the probability of reaching across the midline with the right hand indicates that this may not be a marker of compromised neurodevelopment relevant to language disorder, as previously suggested (Bishop, 2005; Hill & Bishop, 1998)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly identify the earlier finding being re-tested and report its nonreplication.""}"
10.7717/peerj.4217,78b567dd3205b6ce,4,10.1002/brb3.56,Does cerebral lateralization develop? A study using functional transcranial Doppler ultrasound assessing lateralization for language production and visuospatial memory,"Groen, M., Whitehouse, A., Badcock, N., & Bishop, D.",2012,full_text,,unverified,unresolved,{},"{""authors"": ""Groen, M., Whitehouse, A., Badcock, N., & Bishop, D."", ""year"": ""2012"", ""title"": ""Does cerebral lateralization develop? A study using functional transcranial Doppler ultrasound assessing lateralization for language production and visuospatial memory"", ""doi"": ""10.1002/brb3.56"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In the second step of analysis, we tested the relationship between language and laterality from the opposite direction, using language measures as predictors, aiming to replicate the effects reported by Groen et al. (2012). We computed Spearman’s correlations between each language measure and the fTCD laterality index in the two replication samples. However, no uncorrected correlation replicated across samples, and no correlation within a sample survived a Holm-Bonferroni correction."", ""outcome"": ""failed"", ""outcome_quote"": ""In the second step of analysis, we tested the relationship between language and laterality from the opposite direction, using language measures as predictors, aiming to replicate the effects reported by Groen et al. (2012). We computed Spearman’s correlations between each language measure and the fTCD laterality index in the two replication samples. However, no uncorrected correlation replicated across samples, and no correlation within a sample survived a Holm-Bonferroni correction."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly identify the earlier finding being re-tested and report its nonreplication.""}"
10.1186/1748-7161-8-s2-o2,69b1f592e08ce7cf,1,,Association of estrogen receptor gene polymorphisms with susceptibility to adolescent idiopathic scoliosis,"Wu, J., Qiu, Y., Zhang, L., Sun, Q., Qiu, X., He, Y.",2006,abstract,,unverified,unresolved,{},"{""authors"": ""Wu, J., Qiu, Y., Zhang, L., Sun, Q., Qiu, X., He, Y."", ""year"": ""2006"", ""title"": ""Association of estrogen receptor gene polymorphisms with susceptibility to adolescent idiopathic scoliosis"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""It has been suggested that XbaI single nucleotide polymorphism (SNP) (A/G rs934099) in estrogen receptor 1 (ESR1) may be associated with curve severity in Japanese AIS patients [1] and with both curve severity and predisposition for AIS in Chinese patients [2]."", ""outcome"": ""failed"", ""outcome_quote"": ""No association between ESR1 XbaI polymorphism and AIS was found in the Caucasian population. None of the previously reported associations with curve severity, progression or operation rate could be confirmed."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The conclusion rejects the previously reported associations as a set. The earlier negative replication is cited as context, not re-tested as the designated claim.""}"
10.1111/head.12807,d81a6602f268754c,1,10.1097/AJP.0000000000000075,Molecular analysis of cluster headache,"Zarrilli F, Tomaiuolo R, Ceglia C, et al.",2015,full_text,,unverified,unresolved,{},"{""authors"": ""Zarrilli F, Tomaiuolo R, Ceglia C, et al."", ""year"": ""2015"", ""title"": ""Molecular analysis of cluster headache"", ""doi"": ""10.1097/AJP.0000000000000075"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The single nucleotide polymorphism (SNP) rs1126671 located in exon 7 of the ADH4 gene was associated with an increased risk for CH in two Italian studies, whereas rs1800759 located in the promoter region of ADH4 could only be associated with CH in the smaller case–control study. Thus, we performed a replication study on the ADH4 SNPs rs1126671 and rs1800759 in a large, Swedish case–control cohort in order to further investigate the possible contribution of ADH4 to CH."", ""outcome"": ""failed"", ""outcome_quote"": ""The data did not support an association of the ADH4 SNPs rs1126671 and rs1800759 with CH."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors report no association for either variant, contrary to the associations reported by both cited Italian studies.""}"
