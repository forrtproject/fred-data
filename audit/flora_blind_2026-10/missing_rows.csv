10.1016/0885-2014(95)90011-x,36a4644f76545c4c,1,,The concept of object identity.,"Xu, E",1993,full_text,,unverified,unresolved,{},"{""authors"": ""Xu, E"", ""year"": ""1993"", ""title"": ""The concept of object identity."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This effect was demonstrated in 5-month-old infants just as in Xu’s (1993)\nlo-month-old subjects."", ""outcome"": ""successful"", ""outcome_quote"": ""Second, when tracking the existence of an\nobject that was seen to move behind a screen, infants will ignore changes in\nthe object’s identity and attend instead to its spatiotemporal specification.\nThis effect was demonstrated in 5-month-old infants just as in Xu’s (1993)\nlo-month-old subjects."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The discussion explicitly states that this result was replicated.""}"
10.1080/14459795.2022.2135227,cd0616d25cb2d32e,1,10.1098/rsos.200090,A direct and conceptual replication of post-loss speeding when gambling.,"Eben, C., Chen, Z., Vermeylen, L., Billieux, J., & Verbruggen, F.",2020,full_text,,error,argon,"{""target_index"": 1, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""blind_right"", ""corrected_value"": {""doi"": ""10.1098/rsos.200090"", ""title"": ""A direct and conceptual replication of post-loss speeding when gambling."", ""authors"": ""Eben, C., Chen, Z., Vermeylen, L., Billieux, J., & Verbruggen, F."", ""year"": ""2020"", ""type"": ""replication"", ""outcome"": ""successful""}, ""quote"": ""Across experi-\nments, we could again replicate the finding by Langer and Roth (1975) in an online ex-\nperimental setting (see also our replication study). Thus, introducing a start response\ndid not alter the illusion-of-control effect. Moreover, we replicated the finding that par-\nticipants speed up after losses compared to wins (Eben et al., 2020; Verbruggen et al.,\n2017)."", ""location"": ""Section 4. General Discussion, p. 16"", ""reason"": ""Both experiments explicitly re-test and successfully replicate the post-loss speeding effect using the start-response procedure and exclusion criteria of Eben et al. (2020). Under the replication-chain rule, Eben et al. (2020) is the nearest target in the chain re-testing Verbruggen et al. (2017) and is an omitted target in the shipped dataset.""}","{""authors"": ""Eben, C., Chen, Z., Vermeylen, L., Billieux, J., & Verbruggen, F."", ""year"": ""2020"", ""title"": ""A direct and conceptual replication of post-loss speeding when gambling."", ""doi"": ""10.1098/rsos.200090"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""Across experi-\nments, we could again replicate the finding by Langer and Roth (1975) in an online ex-\nperimental setting (see also our replication study). Thus, introducing a start response\ndid not alter the illusion-of-control effect. Moreover, we replicated the finding that par-\nticipants speed up after losses compared to wins (Eben et al., 2020; Verbruggen et al.,\n2017)."", ""outcome"": ""successful"", ""outcome_quote"": ""Across experi-\nments, we could again replicate the finding by Langer and Roth (1975) in an online ex-\nperimental setting (see also our replication study). Thus, introducing a start response\ndid not alter the illusion-of-control effect. Moreover, we replicated the finding that par-\nticipants speed up after losses compared to wins (Eben et al., 2020; Verbruggen et al.,\n2017)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Across both experiments the authors explicitly replicate speeding after losses relative to wins.""}"
10.17705/1atrr.00026,e1d66d7f28d3d3d7,0,,,,2006,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": ""2006"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study is an exact replication of an experiment investigating the impacts of website design on users’ ability to use a website and their opinion of the website (Galletta et al., 2006)."", ""outcome"": ""mixed"", ""outcome_quote"": ""The replication confirms the importance of website design features, specifically delay, breadth, and familiarity on users’ ability to use and form an opinion of a website. However, the replication did not confirm the main finding, that it is the interplay of these three variables, i.e., cognitive cost, that predict performance and attitude."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit agreement and disagreement with the target findings; main interaction finding unconfirmed, but the title does not focus specifically on that interaction.""}"
10.1086/695137,03148576e581e7dc,1,,Gender-Biased Breastfeeding in Egypt: Examining the Fertility Preference Hypotheses of Jayachandran and Kuziemko (2011).,"Chakravarty, Abhishek.",2015,full_text,,error,argon,"{""target_index"": 1, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""blind_right"", ""corrected_value"": {""authors"": ""Chakravarty, Abhishek."", ""year"": ""2015"", ""title"": ""Gender-Biased Breastfeeding in Egypt: Examining the Fertility Preference Hypotheses of Jayachandran and Kuziemko (2011)."", ""doi"": """", ""type"": ""replication"", ""outcome"": ""mixed""}, ""quote"": ""However, Chakravarty’s speciﬁcation omits the gender main effect while\nincluding the interactions of gender with birth order. Adding the gender\ndummy in column 3, we essentially ﬁnd results consistent with column 1, that\nis, there is no evidence for a peak in male advantage in breastfeeding at middle\nbirth order. Thus, this is the only prediction of JK that we fail to support in\nour analysis.\n\nG. Summary\nWe ﬁnd evidence supporting all predictions in JK (1, 2, 3, 5, 6, and 7) but 9,\nthe additional prediction in Chakravarty (4), and our new prediction (8)."", ""location"": ""Primary original-specific empirical retest, raw chars[90849,91409); Methods/Results/Discussion/References and ALLshipped counterparts checked"", ""reason"": ""Chakravarty (2015) is a replicated target tested on two components in the Pakistan DHS sample: (1) Chakravarty's additional sibling-sex-composition hypothesis (prediction 4, eq. 3), which is confirmed in Table 5 col. 5 (Section V.C), Section V.G, and the Conclusion (Section VII), and (2) Chakravarty's quadratic birth-order interaction specification for prediction 9 (Section V.F, Table 9 cols. 2-3). In Table 9 col. 2, replicating Chakravarty's original specification reproduces a strongly statistically significant gender-by-birth-order interaction (p = .000 jointly) in line with a middle-birth-order peak, but the authors show that Chakravarty's specification omits the gender main effect and that adding the gender dummy in col. 3 eliminates the middle-birth-order peak. Under the codebook's main-message rule, 'statistically successful but flawed' applies only when the methodological critique is the paper's main message; here, the omitted-main-effect critique concerns only one regression specification in Section V.F and is not the main message of the paper or of the Chakravarty comparison (which highlights confirmation of prediction 4 in the Summary and Conclusion). Because prediction 4 is supported while the middle-birth-order peak is rejected once properly specified, the overall outcome for Chakravarty (2015) is 'mixed'.""}","{""authors"": ""Chakravarty, Abhishek."", ""year"": ""2015"", ""title"": ""Gender-Biased Breastfeeding in Egypt: Examining the Fertility Preference Hypotheses of Jayachandran and Kuziemko (2011)."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Further, according to the fourth prediction (Chakravarty 2015), we may\nexpect the effect of children’s sex composition on breastfeeding duration to\nbe different for boys and girls. The results in the last column of table 5 are in-\ndeed consistent with Chakravarty (2015); girls are breastfed for an additional\n0.85 months compared to boys as the ratio of elder male siblings increases from\n0 to 1, keeping all else ﬁxed."", ""outcome"": ""mixed"", ""outcome_quote"": ""However, Chakravarty’s speciﬁcation omits the gender main effect while\nincluding the interactions of gender with birth order. Adding the gender\ndummy in column 3, we essentially ﬁnd results consistent with column 1, that\nis, there is no evidence for a peak in male advantage in breastfeeding at middle\nbirth order. Thus, this is the only prediction of JK that we fail to support in\nour analysis.\n\nG. Summary\nWe ﬁnd evidence supporting all predictions in JK (1, 2, 3, 5, 6, and 7) but 9,\nthe additional prediction in Chakravarty (4), and our new prediction (8)."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""Additional sex-composition prediction is supported; birth-order result is obtained with the original specification but rejected after adding the omitted gender main effect. Both findings are explicitly retested.""}"
10.1098/rsos.250508,e7746157bd29dd4b,1,10.1080/02699930500172291,The debt of gratitude: dissociating gratitude and indebtedness.,"Watkins P, Scheer J, Ovnicek M, Kolts R.",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Watkins P, Scheer J, Ovnicek M, Kolts R."", ""year"": ""2006"", ""title"": ""The debt of gratitude: dissociating gratitude and indebtedness."", ""doi"": ""10.1080/02699930500172291"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""We built our extension on the findings by Watkins et al. [6], who, like Tsang [1], argued that gratitude and indebtedness are distinct, but went further to argue that expectations for reciprocity would increase indebtedness but decrease gratitude. Tying these findings together with the experimental paradigm of Tsang [1], we aimed to examine the associations between perceived expectations for reciprocity and the inclination to reciprocate."", ""outcome"": ""mixed"", ""outcome_quote"": ""Overall, we found empirical support for the hypothesis that gratitude and indebtedness are correlated to expectation for reciprocity, yet failed to find support for the association between expectation for reciprocity and reciprocity inclination.Our findings support the argument by Watkins et al. [6] that expectation for reciprocity would be associated with higher indebtedness but lower gratitude."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Extensions retest reciprocity expectations: gratitude and indebtedness comparisons agree, while the expected expectations–inclination association is unsupported. No overall verdict on all Watkins comparisons overrides this combination.""}"
10.1098/rsos.250508,e7746157bd29dd4b,2,10.1111/j.1467-9280.2006.01705.x,Gratitude and prosocial behavior: helping when it costs you.,"Bartlett MY, DeSteno D.",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Bartlett MY, DeSteno D."", ""year"": ""2006"", ""title"": ""Gratitude and prosocial behavior: helping when it costs you."", ""doi"": ""10.1111/j.1467-9280.2006.01705.x"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Findings in the literature about the associations between gratitude and reciprocity have so far been mixed. For example, a seminal study by Bartlett & DeSteno [2] illustrated that gratitude is positively associated with reciprocity, whereas Peng et al. [16] failed to replicate Bartlett & DeSteno [2] and did not find any support for links with reciprocity for both gratitude and indebtedness. Therefore, our extension could be thought of as a conceptual replication of the Bartlett & DeSteno [2] and Peng et al. [16] directions to try and determine whether reciprocity might play a role, using an empirical design from a different study."", ""outcome"": ""failed"", ""outcome_quote"": ""By contrast, the absence of an association between expectations for reciprocity and reciprocity inclination in our results may be seen as lending support for the findings by Peng et al. [16] over that of Bartlett & DeSteno [2]."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Authors frame their conceptual comparison as supporting Peng over Bartlett and DeSteno. An exploratory positive gratitude–inclination correlation also appears; confidence is reduced because the discussion comparison concerns expectations rather than gratitude.""}"
10.1098/rsos.250508,e7746157bd29dd4b,3,10.1080/15534510.2019.1710248,"Gratitude, indebtedness, and reciprocity: an extended replication of Bartlett & DeSteno (2006).","Peng C, Malafosse C, Nelissen RMA, Zeelenberg M.",2020,full_text,,unverified,unresolved,{},"{""authors"": ""Peng C, Malafosse C, Nelissen RMA, Zeelenberg M."", ""year"": ""2020"", ""title"": ""Gratitude, indebtedness, and reciprocity: an extended replication of Bartlett & DeSteno (2006)."", ""doi"": ""10.1080/15534510.2019.1710248"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Findings in the literature about the associations between gratitude and reciprocity have so far been mixed. For example, a seminal study by Bartlett & DeSteno [2] illustrated that gratitude is positively associated with reciprocity, whereas Peng et al. [16] failed to replicate Bartlett & DeSteno [2] and did not find any support for links with reciprocity for both gratitude and indebtedness. Therefore, our extension could be thought of as a conceptual replication of the Bartlett & DeSteno [2] and Peng et al. [16] directions to try and determine whether reciprocity might play a role, using an empirical design from a different study."", ""outcome"": ""successful"", ""outcome_quote"": ""By contrast, the absence of an association between expectations for reciprocity and reciprocity inclination in our results may be seen as lending support for the findings by Peng et al. [16] over that of Bartlett & DeSteno [2]."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Peng 2020 is itself explicitly retested, separately from Bartlett 2006. The discussion supports Peng; exploratory gratitude and indebtedness correlations differ from the introductory description, creating uncertainty.""}"
10.3765/exabs.v0i0.603,ec68785003c85bd3,0,,"The meaning of most: Semantics, numerosity and psychology.","Pietroski, P., J. Lidz, T. Hunter & J. Halberda.",2008,full_text,,unverified,unresolved,{},"{""authors"": ""Pietroski, P., J. Lidz, T. Hunter & J. Halberda."", ""year"": ""2008"", ""title"": ""The meaning of most: Semantics, numerosity and psychology."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""My results confirm and extend the findings of Pietroski et al. (2008), Hackl (2009), Lidz et al. (2011) and indicate that semantics provides inviolable instructions to visual cognition processes."", ""outcome"": ""successful"", ""outcome_quote"": ""My results confirm and extend the findings of Pietroski et al. (2008), Hackl (2009), Lidz et al. (2011) and indicate that semantics provides inviolable instructions to visual cognition processes."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The author explicitly places this original within the set of findings confirmed and extended.""}"
10.3765/exabs.v0i0.603,ec68785003c85bd3,1,,On the grammar and processing of proportional quantifiers: most versus more than half.,"Hackl, M.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Hackl, M."", ""year"": ""2009"", ""title"": ""On the grammar and processing of proportional quantifiers: most versus more than half."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""My results confirm and extend the findings of Pietroski et al. (2008), Hackl (2009), Lidz et al. (2011) and indicate that semantics provides inviolable instructions to visual cognition processes."", ""outcome"": ""successful"", ""outcome_quote"": ""My results confirm and extend the findings of Pietroski et al. (2008), Hackl (2009), Lidz et al. (2011) and indicate that semantics provides inviolable instructions to visual cognition processes."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The author explicitly places this original within the set of findings confirmed and extended.""}"
10.1177/019874290503100104,88e177b9a1be6cb9,0,,,"Walker, Stiller, Severson, & Golly",1998,abstract,,unverified,unresolved,"{""corrected_value"": null, ""field"": ""missing_row"", ""file_key"": ""88e177b9a1be6cb9"", ""location"": ""Abstract"", ""method"": ""argon"", ""quote"": ""This article describes a replication of the First Step to Success program (Walker, Stiller, Severson, & Golly, 1998) with at-risk students in the first and second grade to determine program effectiveness in decreasing inappropriate behaviors and increasing academic engagement time. This expands the First Step to Success program to (1) serve slightly older students than those in the earlier kindergarten studies; (2) assess implementation effects across a full school day rather than half-day periods; and (3) determine effects when used in conjunction with individualized, across-the-day, contingency reinforcement systems."", ""reason"": ""No prior adjudication or state files exist for this work. Only the abstract is available in the source file, with no reference list or full text. While the abstract describes a replication of 'the First Step to Success program (Walker, Stiller, Severson, & Golly, 1998)' and contrasts it with 'the earlier kindergarten studies,' the supplied evidence does not provide the full bibliographic entry for Walker, Stiller, Severson, & Golly (1998) and cannot resolve whether that citation refers to a non-target program manual/curriculum or whether it and shipped row 2252 (Golly; Stiller; Walker, 1998, 'First Step to Success', DOI 10.1177/106342669800600406) represent the same underlying kindergarten First Step to Success study."", ""request_id"": ""luna_0070_88e177b9a1be6cb9"", ""target_index"": 0, ""verdict"": ""undeterminable""}","{""authors"": ""Walker, Stiller, Severson, & Golly"", ""year"": ""1998"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This article describes a replication of the First Step to Success program (Walker, Stiller, Severson, & Golly, 1998) with at-risk students in the first and second grade to determine program effectiveness in decreasing inappropriate behaviors and increasing academic engagement time."", ""outcome"": ""cannot_be_determined"", ""outcome_quote"": """", ""outcome_quote_section"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""The abstract reports improved behavior but gives neither the original finding nor an overall replication verdict. Its citation identifies a program source, whose full reference and relationship to the original finding cannot be resolved from this abstract.""}"
10.1080/02699931.2024.2434156,9430b3e92b9d82bb,1,10.1037/0022-3514.75.6.1586,Interpersonal forgiving in close relationships: II. Theoretical Elaboration and Measurement.,"McCullough, M. E., Rachal, K. C., Sandage, S. J., Worthington, E. L., Brown, S. W., & Hight, T. L.",1998,full_text,,error,argon,"{""corrected_value"": {""authors"": ""McCullough, M. E., Rachal, K. C., Sandage, S. J., Worthington, E. L., Brown, S. W., & Hight, T. L."", ""doi"": ""10.1037/0022-3514.75.6.1586"", ""outcome"": ""cannot_be_determined"", ""record_type"": ""replication"", ""title"": ""Interpersonal forgiving in close relationships: II. Theoretical Elaboration and Measurement."", ""year"": ""1998""}, ""field"": ""missing_row"", ""file_key"": ""9430b3e92b9d82bb"", ""location"": ""Abstract, line 1 (p. 1); Results, line 1 (pp. 11-12); Discussion, line 1 (p. 19); References, line 1 (p. 22)"", ""method"": ""argon"", ""quote"": ""We took initial steps to partially replicate some of the work by McCullough et al. (1998) by including the revenge measure in our replication, yet we see the value in a more comprehensive revisiting of their study."", ""reason"": ""No prior adjudication or state file exists for this work. In addition to using the TRIM avoidance and revenge subscales developed in McCullough et al. (1998) (Study 1), the authors empirically re-tested the negative correlation between forgiveness and revenge motivation (Hypothesis 2bii, r(261) = -0.43, p < .001—a relationship not tested in the 1997 paper, as indicated by '/' in Table 9) and whether forgiveness is more strongly linked with avoidance and revenge motivation than empathy (Hypothesis 2c), explicitly stating in the Discussion that 'We took initial steps to partially replicate some of the work by McCullough et al. (1998) by including the revenge measure in our replication' and in the Abstract that 'Overall, this was a successful replication of the findings by McCullough et al. (1997; 1998) with the empathy model of forgiveness receiving strong empirical support.' Shipped row 2257 (10.1037/0022-3514.73.2.321, JPSP 73(2), 321-336) is the earlier 1997 article by McCullough, Worthington, and Rachal, whereas McCullough et al. (1998) (10.1037/0022-3514.75.6.1586, JPSP 75(6), 1586-1603) is a separate multi-study follow-up article with additional co-authors and new empirical data rather than an alternate report of the 1997 study."", ""request_id"": ""luna_0073_9430b3e92b9d82bb"", ""target_index"": 1, ""verdict"": ""blind_right""}","{""authors"": ""McCullough, M. E., Rachal, K. C., Sandage, S. J., Worthington, E. L., Brown, S. W., & Hight, T. L."", ""year"": ""1998"", ""title"": ""Interpersonal forgiving in close relationships: II. Theoretical Elaboration and Measurement."", ""doi"": ""10.1037/0022-3514.75.6.1586"", ""identified_by"": ""citation"", ""study_numbers"": ""1"", ""replication_study_numbers"": """", ""evidence_quote"": ""We took initial steps to partially replicate some of the work by McCullough et al. (1998) by including the revenge measure in our replication, yet we see the value in a more comprehensive revisiting of their study."", ""outcome"": ""successful"", ""outcome_quote"": ""Overall, this was a successful replication of the findings by McCullough et al. (1997; 1998) with the empathy model of forgiveness receiving strong empirical support."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The overall successful-replication verdict explicitly names both original papers. The 1998 study is partially re-tested for forgiveness and revenge, with the authors expressly calling this a partial replication.""}"
10.31234/osf.io/yha5e,2c9f0476b9f6e56f,1,,Information-processing alternatives to holistic perception: identifying the mechanisms of secondary-level holism within a categorization paradigm.,"Fifić, M., & Townsend, J. T.",2010,full_text,,unverified,unresolved,{},"{""study_numbers"": """", ""doi"": """", ""identified_by"": ""citation"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""authors"": ""Fifić, M., & Townsend, J. T."", ""year"": ""2010"", ""title"": ""Information-processing alternatives to holistic perception: identifying the mechanisms of secondary-level holism within a categorization paradigm."", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""To further investigate the difference in these findings, we extend our investigation\nof face processing to schematic faces similar to Fifić and Townsend’s (2010) using the\nparadigm developed in Cheng et al. (2018). Unlike the morphed faces in Cheng et al.\n(2018) in which the category of the face depended on the observer’s perception of the\nsimilarity between faces, the schematic faces are made up of fixed values that represent the\ndifferences between the space between the eyes and the space between the nose and the\nlips. We again employ SFT in order to determine whether there is any evidence for holistic\nprocessing."", ""outcome"": ""failed"", ""outcome_quote"": ""Importantly, while the faces we used appear to be processed holistically in the stan-\ndard composite task, there is no consistent evidence for coactivity when participants cate-\ngorize upright aligned faces. We also did not find that upright faces are treated differently\nfrom misaligned or inverted faces. Based on our non-parametric and parametric results, we\ncan also see that the main differences between the face conditions were quantitative rather\nthan qualitative (see Richler, Wong, & Gauthier, 2011))."", ""outcome_reasoning"": ""The paper explicitly investigates the discrepancy between Fific and Townsend’s coactivity finding and Cheng et al. using schematic faces, with a stated prediction about reproducing the former. Experiment 2 finds no consistent coactivity, contrary to that target finding. This is a retest by relationship, despite design changes; not merely a stimulus-source citation.""}"
10.31235/osf.io/nt8c4,fd0aaf93ce9c110d,1,,Immigration and redistribution.,"Alesina, Alberto, Miano, Armando and Stantcheva, Stefanie",2023,full_text,,unverified,unresolved,{},"{""authors"": ""Alesina, Alberto, Miano, Armando and Stantcheva, Stefanie"", ""year"": ""2023"", ""title"": ""Immigration and redistribution."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our pre-registered (see Appendix B.1 for blinded version) survey design builds\nupon and replicates Magni (2021) and Alesina, Miano and Stantcheva (2023)\nwith a quota-representative (age, gender, education, region) sample of the sur-\nvey company Kantar."", ""outcome"": ""failed"", ""outcome_quote"": ""Third, priming on immigration does not\nmake respondents support a reduction of redistribution as previously proposed by\nAlesina, Miano and Stantcheva (2023); rather, it even decreases welfare chauvinis-\ntic attitudes."", ""outcome_quote_section"": ""introduction"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The central immigration effect on redistribution fails; successful manipulation checks do not establish successful replication of that claim.""}"
10.1167/12.11.12,edb96f4b87f5413a,0,10.1167/8.7.2,Perceptual grouping and inverse fMRI activity patterns in human visual cortex.,"Fang, F., Kersten, D., & Murray, S. O.",2008,full_text,,unverified,unresolved,{},"{""authors"": ""Fang, F., Kersten, D., & Murray, S. O."", ""year"": ""2008"", ""title"": ""Perceptual grouping and inverse fMRI activity patterns in human visual cortex."", ""doi"": ""10.1167/8.7.2"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""It is perhaps not surprising that our study replicates the\nreduction found in Murray and colleagues’ previous\nwork, given that we explicitly set out to replicate the\nparameters used in the study of Fang et al."", ""outcome"": ""mixed"", ""outcome_quote"": ""This model\nhas previously been motivated based on data showing\nthat organized (and thus predictable) percepts lead to\nreduced activation levels on the primary visual cortex\n(Fang et al., 2008; Murray et al., 2002). The results of\nthe current study replicate this reduction, but ﬁnd that\nthis reduction is not speciﬁc to the sensory representation of this stimulus; rather, it also occurs in retinotopic\nregions that do not respond to the sensory onset of the\nstimulus. Importantly however this reduction is not\nfound in all visual areas (which might suggest a general\narousal effect); rather, our results also replicate an\nincrease in activation for the organized percept in the\nhigher-level shape selective region LO (Fang et al.,\n2008)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The V1 decrease and LO increase replicate, but the paper expressly contrasts its retinotopically nonspecific decrease with Fang et al.’s claim of retinotopic specificity. Confirming the decrease alone is an effect-specific comparison, not a verdict on the replication as a whole. Indeed this assumption was made explicit in Fang et al. (2008), who stated that ‘‘we are conﬁdent that the modulations in the fMRI signal that we observed occurred in the retinotopic representation of the stimulus and not in immediately adjacent retinotopic regions’’ (p. 6). In contrast, when we investigated this directly it became evident that, although there was a clear reduction in activation at the retinotopic location of the stimuli, this reduction did not appear to be speciﬁc to, or even selectively stronger in, the retinotopic location of the stimulus. ""}"
10.1167/jov.22.10.10,61e96a83743884f1,1,,Failure to detect displacement of the visual world during saccadic eye movements,"Bridgeman, B., Hendry, D., & Stark, L.",1975,full_text,,unverified,unresolved,{},"{""authors"": ""Bridgeman, B., Hendry, D., & Stark, L."", ""year"": ""1975"", ""title"": ""Failure to detect displacement of the visual world during saccadic eye movements"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""However, performance declines the closer in time displacements were presented to saccade onset. This result replicates previous findings ( Bridgeman, Hendry, & Stark, 1975 ; Zimmermann, 2020 )."", ""outcome"": ""successful"", ""outcome_quote"": ""However, performance declines the closer in time displacements were presented to saccade onset. This result replicates previous findings ( Bridgeman, Hendry, & Stark, 1975 ; Zimmermann, 2020 )."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit confirmation in Experiment 1; Experiment 2 is a contrast extension.""}"
10.1167/jov.20.6.18,84cdf9f12aedb720,0,10.1167/6.10.4,Kin recognition and the perceived facial similarity of children,"Maloney, L. T., & Dal Martello, M. F.",2006,full_text,,error,argon,"{""target_index"": 0, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""blind_right"", ""corrected_value"": {""doi"": ""10.1167/6.10.4"", ""title"": ""Kin recognition and the perceived facial similarity of children"", ""authors"": ""Maloney, L. T., & Dal Martello, M. F."", ""year"": ""2006"", ""type"": ""replication"", ""outcome"": ""mixed""}, ""quote"": ""Facial similarity between individuals informs kinship judgments in third-party kin recognition. Indeed, one study found that similarity and kinship judgments encapsulate the same information (Maloney & Dal Martello, 2006). Yet, another study found that this is not the case when comparing adult face pairs of different sex (DeBruine et al., 2009). We replicated these studies to further clarify the role of facial similarity in kin recognition."", ""location"": ""abstract"", ""reason"": ""The paper explicitly states that it replicates Maloney and Dal Martello's (2006) child-face study alongside DeBruine et al. (2009), and compares its correlation and age-difference results directly against Maloney and Dal Martello (2006), making it an omitted replication target with a mixed outcome.""}","{""authors"": ""Maloney, L. T., & Dal Martello, M. F."", ""year"": ""2006"", ""title"": ""Kin recognition and the perceived facial similarity of children"", ""doi"": ""10.1167/6.10.4"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Facial similarity between individuals informs kinship judgments in third-party kin recognition. Indeed, one study found that similarity and kinship judgments encapsulate the same information (Maloney & Dal Martello, 2006). Yet, another study found that this is not the case when comparing adult face pairs of different sex (DeBruine et al., 2009). We replicated these studies to further clarify the role of facial similarity in kin recognition."", ""outcome"": ""mixed"", ""outcome_quote"": ""In conclusion, using a larger stimuli sample of children, we replicated Maloney and Dal Martello's (\n2006\n) finding that kinship and similarity ratings are highly correlated. We found that the effect of sex was the same on similarity and on kinship judgments, contrary to\nDeBruine et al (2009)\n. However, we found that the effect of age was different on similarity judgments than on kinship judgments, contrary to\nMaloney and Dal Martello (2006)\n."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": """"}"
10.1111/j.1471-6402.1997.tb00120.x,72beb18f4e8c5a25,1,,Overworked and underpaid.,"Major, B., McFarlin, D., Gagnon, D.",1984,abstract,,error,obvious,"{""corrected_value"": {""authors"": ""Major, B., McFarlin, D., Gagnon, D."", ""doi"": """", ""outcome"": ""cannot_be_determined"", ""record_type"": ""replication"", ""title"": ""Overworked and underpaid."", ""year"": ""1984""}, ""field"": ""missing_row"", ""file_key"": ""72beb18f4e8c5a25"", ""location"": ""Abstract, line 5; Reference list, line 40"", ""method"": ""obvious"", ""quote"": ""Previous research has suggested that women pay themselves significantly less than men pay themselves for the same amount of work (Callahan-Levy & Messé, 1979; Major, McFarlin, & Gagnon, 1984). In an experimental study involving 132 participants (68 men and 64 women), this “depressed-entitlement effect” was replicated in a current sample of university students."", ""reason"": ""Parent independently verified the primary source and exact empirical relationship. Actual current is JohnT.Jost1997 AnExperimentalReplicationOfTheDepressedEntitlementEffectAmongWomen, DOI10.1111/j.1471-6402.1997.tb00120.x; not Desmarais/Curtis as initial reason says. Complete primary abstract explicitly names bothCallahanLevy/Messe1979andMajor/McFarlin/Gagnon1984, then reports own132participants retesting that precise equal-work self-pay gender difference; publisher reference entries identify both. Sole shipped2291is1979paper. Major1984is a distinct source-confirmed genuinely absent empirical original, not inferred from topical title alone. Initial expert original-identity conclusion corroborated from primary evidence, while fabricated current author/DOI/sample/section claims are expressly rejected; immutable provider replies retained. This factual correction does not change blind coding or create a new model attempt."", ""request_id"": ""luna_0057_72beb18f4e8c5a25"", ""target_index"": 1, ""verdict"": ""blind_right""}","{""authors"": ""Major, B., McFarlin, D., Gagnon, D."", ""year"": ""1984"", ""title"": ""Overworked and underpaid."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Previous research has suggested that women pay themselves significantly less than men pay themselves for the same amount of work (Callahan-Levy & Messé, 1979; Major, McFarlin, & Gagnon, 1984). In an experimental study involving 132 participants (68 men and 64 women), this “depressed-entitlement effect” was replicated in a current sample of university students."", ""outcome"": ""successful"", ""outcome_quote"": ""Previous research has suggested that women pay themselves significantly less than men pay themselves for the same amount of work (Callahan-Levy & Messé, 1979; Major, McFarlin, & Gagnon, 1984). In an experimental study involving 132 participants (68 men and 64 women), this “depressed-entitlement effect” was replicated in a current sample of university students."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract attributes the effect to both studies and states that this effect was replicated in the new sample.""}"
10.17705/1atrr.00032,d29f41a193cc6e12,1,,Profiling the research productivity of tenured Information Systems faculty at U.S. institutions.,"Dean, D. L., Lowry, P. B., & Humpherys, S.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Dean, D. L., Lowry, P. B., & Humpherys, S."", ""year"": ""2011"", ""title"": ""Profiling the research productivity of tenured Information Systems faculty at U.S. institutions."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Following their procedures, we limited our sample to recent cases of designated IS scholars in U.S. business schools, but used a more recent time frame, and found very similar results. Details of our modest replication of their study are found in the Appendix (Table A1)."", ""outcome"": ""successful"", ""outcome_quote"": ""Our results are very close to those in Dean et al. (2011). They found that promoted IS scholars published 23% of their articles in CS and Engineering journals; we find 24%. They found 22% of articles in non-IS business journals; we find 21%."", ""outcome_quote_section"": ""fulltext"", ""outcome_confident"": true, ""outcome_reasoning"": ""The appendix explicitly reports a separate replication in a new sample of promoted faculty and compares the original publication proportions with almost identical new proportions.""}"
