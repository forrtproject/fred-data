10.1080/20445911.2020.1805453,ed701519c48a420b,1,10.1080/20445911.2019.1659801,Anticipation-speciﬁc reliability and trial-to-trial carryover of anticipatory attentional bias for threat.,"Gladwin, T. E., Figner, B., & Vink, M.",2019,full_text,,unverified,unresolved,{},"{""authors"": ""Gladwin, T. E., Figner, B., & Vink, M."", ""year"": ""2019"", ""title"": ""Anticipation-speciﬁc reliability and trial-to-trial carryover of anticipatory attentional bias for threat."", ""doi"": ""10.1080/20445911.2019.1659801"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""The predicted within-subject eﬀects were found.\nFor Colour cues, attentional bias was drawn\ntowards the colour cue on which the target was presented in the previous trial. This replicated the previous ﬁnding on colour cues and carryover\n(Gladwin & Figner, 2019). Carryover was also found\nfor negative facial expressions, as in previous\nﬁndings for threatening stimuli (Gladwin et al.,\n2019; Gladwin & Figner, 2019)."", ""outcome"": ""successful"", ""outcome_quote"": ""The predicted within-subject eﬀects were found.\nFor Colour cues, attentional bias was drawn\ntowards the colour cue on which the target was presented in the previous trial. This replicated the previous ﬁnding on colour cues and carryover\n(Gladwin & Figner, 2019). Carryover was also found\nfor negative facial expressions, as in previous\nﬁndings for threatening stimuli (Gladwin et al.,\n2019; Gladwin & Figner, 2019)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Both cited findings are explicitly compared as confirmed by new samples and stimulus sets. Low individual-difference reliability does not invalidate the within-subject carryover finding; Study 2 also reports its replication.""}"
10.1177/01461672211052120,d6fc9c6efb321353,1,10.17759/exppsy.2017100102,The effects of alcohol on heart rate and evaluation of actions in moral dilemma.,"Arutyunova, K. R., Bakhchina, A. V., Krylov, A. K., & Alexandrov Yu, I.",2017,full_text,,unverified,unresolved,{},"{""authors"": ""Arutyunova, K. R., Bakhchina, A. V., Krylov, A. K., & Alexandrov Yu, I."", ""year"": ""2017"", ""title"": ""The effects of alcohol on heart rate and evaluation of actions in moral dilemma."", ""doi"": ""10.17759/exppsy.2017100102"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Subsequent laboratory experiments (Arutyunova et al., 2017; Francis et al., 2019) aimed to address this concern, and these studies did not find any significant effects of alcohol on moral judgments. However, the consumed doses of alcohol were relatively small in these experiments."", ""outcome"": ""successful"", ""outcome_quote"": ""Despite these improvements, we failed to obtain any significant effect of alcohol on moral judgments."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper retests the prior experimental null effect with a higher dose and larger sample; its null result agrees.""}"
