10.3389/fpsyg.2018.02662,d6d6e6eb9709b275,1,10.1086/674547,Environmental disorder leads to self-regulatory failure.,"Chae B., Zhu R.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Chae B., Zhu R."", ""year"": ""2014"", ""title"": ""Environmental disorder leads to self-regulatory failure."", ""doi"": ""10.1086/674547"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also compared the effect of experimental conditions only considering the rotations that most closely resembled the task order in Vohs et al. (2013) and Chae and Zhu (2014) ."", ""outcome"": ""failed"", ""outcome_quote"": ""Results in our study indicated that working at a messy desk did not result in significantly and reliably different creativity or executive functioning performance."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The original disorder effect was not found. The authors report no creativity or executive functioning differences, and explicitly compare the designs and discrepant results to this original.""}"
10.17705/1atrr.00061,5e2562976f8b03cf,1,,Examining the influence of demographic factors on internet users’ information privacy concerns.,"Zukowski, T., & Brown, I.",2007,full_text,,unverified,unresolved,{},"{""authors"": ""Zukowski, T., & Brown, I."", ""year"": ""2007"", ""title"": ""Examining the influence of demographic factors on internet users’ information privacy concerns."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our replication of the analysis by Zukowski and Brown (2007), regarding covariate effects, only confirmed the effects of gender on the privacy concerns in Japan."", ""outcome"": ""mixed"", ""outcome_quote"": ""Even though the correlation of IUIPC with age is significant, we consider it negligible in magnitude (0.113). Zukowski and Brown again obtain a different result from what we observed in Japan by accepting their hypothesis of an effect of age. Similarly, our correlation of IUIPC with the education and personal income levels yields negligible values of 0.03, and -0.05 respectively. Zukowski and Brown, however, do identify an effect of education, but also reject the effect of income."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly call the covariate analysis a replication. Age and education differ, while absence of income effect agrees; gender also differs. Earlier IUIPC replications cited solely for context are not targets.""}"
