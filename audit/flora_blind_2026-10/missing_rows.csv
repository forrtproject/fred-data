10.1037/a0036307,83f22bb16cd6de76,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""In the present study, we replicated the RI/E model in 2 samples and extended it by simultaneously investigating the longitudinal associations of academic self-concepts and achievements in 3 academic domains (i.e., mathematics, German as a native language, English as a foreign language)."", ""outcome"": ""cannot_be_determined"", ""outcome_quote"": """", ""outcome_quote_section"": """", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""The abstract reports support for a model but does not name the earlier original paper or state that original’s specific finding. Model support cannot settle an original-specific outcome.""}"
10.1167/iovs.14-15390,74f17c0afe5e7c4a,0,,Association and familial segregation of CTG18.1 trinucleotide repeat expansion of TCF4 gene in Fuchs' endothelial corneal dystrophy,"Mootha VV, Gong X, Ku HC, Xing C.",2014,full_text,,correct,argon,"{""target_index"": 0, ""field"": ""missing_row"", ""method"": ""argon"", ""verdict"": ""shipped_right"", ""corrected_value"": null, ""quote"": ""In 2012, a strong association between a CTG trinucleotide repeat locus (CTG18.1) in intron 3 of the TCF4 and FECD was reported, which displayed greater specificity than rs613872. 25 The locus CTG18.1 was initially discovered by the repeat expansion detection assay and was found to be expanded in 3% of subjects in Caucasian pedigrees without known associated phenotype. 26 Expanded alleles with greater than 37 CTG repeats at this locus were found to be unstable. 26 Our group replicated the association with 120 FECD cases and 100 controls, finding that one copy of the expanded CTG18.1 allele increased risk of disease by 32.3-fold (95% confidence interval [CI], 13.4-77.6). 27"", ""location"": ""introduction"", ""reason"": ""Reference 27 (Mootha et al., 2014) is the authors' own prior replication of Wieben et al.'s (2012, ref 25) Caucasian CTG18.1-FECD association (plus familial segregation in Caucasian kindreds, which is not tested here). While the authors reuse their >=40-repeat cutoff and compare the Chinese odds ratio against Reference 27's Caucasian odds ratio, Reference 27 represents the same underlying CTG18.1-FECD association finding already captured by shipped row 71 (Wieben et al., 2012) rather than an independent omitted target.""}","{""authors"": ""Mootha VV, Gong X, Ku HC, Xing C."", ""year"": ""2014"", ""title"": ""Association and familial segregation of CTG18.1 trinucleotide repeat expansion of TCF4 gene in Fuchs' endothelial corneal dystrophy"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our group replicated the association with 120 FECD cases and 100 controls, finding that one copy of the expanded CTG18.1 allele increased risk of disease by 32.3-fold (95% confidence interval [CI], 13.4-77.6). 27 We found the OR of each copy of the expanded allele estimated to be 66.5 (95% CI: 12.6-350.1) in the Chinese population, mirroring its extremely high OR in Caucasians of 32.3 (95% CI: 13.4-77.6). 27"", ""outcome"": ""successful"", ""outcome_quote"": ""We found the OR of each copy of the expanded allele estimated to be 66.5 (95% CI: 12.6-350.1) in the Chinese population, mirroring its extremely high OR in Caucasians of 32.3 (95% CI: 13.4-77.6). 27"", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""Authors expressly compare the Chinese association with the preceding Caucasian replication and describe mirrored large effects and transethnic replication.""}"
10.1111/josh.12124,a829f47b0712f89f,0,,,,2010,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": ""2010"", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The School Climate Measure ( SCM ) was developed and validated in 2010 in response to a dearth of psychometrically sound school climate instruments. This study sought to further validate the SCM on a large, diverse sample of Arizona public school adolescents (N = 20,953)."", ""outcome"": ""successful"", ""outcome_quote"": ""Additional evidence supports the validity and reliability of the SCM ."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The original validation finding is identified as SCM validity and reliability; the authors conclude that their independent sample provides additional support for both. Target citation fields remain empty because the abstract supplies no authors or reference list, preventing identification from this evidence alone.""}"
