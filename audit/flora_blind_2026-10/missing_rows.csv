10.1108/scm-06-2023-0297,9de69025f12b33a8,0,,,Ambulkar et al.,2015,abstract,,unverified,unresolved,{},"{""authors"": ""Ambulkar et al."", ""year"": ""2015"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The purpose is to replicate and extend Ambulkar et al.’s (2015) work testing resource reconfiguration as a mediator of the supply chain disruption/firm resilience relationship and testing risk management infrastructure as a moderator."", ""outcome"": ""mixed"", ""outcome_quote"": ""Two of four of Ambulkars et al.’s (2015) hypotheses were confirmed as relevant to firm resilience during the pandemic while two were not confirmed."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit partial confirmation of the four hypotheses from a single original paper. Original reference citation is unavailable in abstract.""}"
10.1523/eneuro.0332-25.2025,5c0e372f71ca86f5,1,10.1126/science.7256273,Phenomenological space-time: toward an experiential relativity.,DeLong AJ,1981,full_text,,unverified,unresolved,{},"{""authors"": ""DeLong AJ"", ""year"": ""1981"", ""title"": ""Phenomenological space-time: toward an experiential relativity."", ""doi"": ""10.1126/science.7256273"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Second, the size of the VR did not significantly impact the retrospective time estimation as would have been expected through other studies ( DeLong, 1981 ; Riemer et al., 2014 )."", ""outcome"": ""failed"", ""outcome_quote"": ""Second, the size of the VR did not significantly impact the retrospective time estimation as would have been expected through other studies ( DeLong, 1981 ; Riemer et al., 2014 ). Two differences can explain this incongruence: our study tested a different time scale and used a retrospective, not a prospective paradigm."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Experiment 3 explicitly tested whether environmental size affects time estimation and contrasts its null effect with this cited earlier result.""}"
10.1523/eneuro.0332-25.2025,5c0e372f71ca86f5,2,10.1007/s00221-014-3848-6,Interrelations between the perception of time and space in large-scale environments.,"Riemer M, Hölzl R, Kleinböhl D",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Riemer M, Hölzl R, Kleinböhl D"", ""year"": ""2014"", ""title"": ""Interrelations between the perception of time and space in large-scale environments."", ""doi"": ""10.1007/s00221-014-3848-6"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Second, the size of the VR did not significantly impact the retrospective time estimation as would have been expected through other studies ( DeLong, 1981 ; Riemer et al., 2014 )."", ""outcome"": ""failed"", ""outcome_quote"": ""Second, the size of the VR did not significantly impact the retrospective time estimation as would have been expected through other studies ( DeLong, 1981 ; Riemer et al., 2014 ). Two differences can explain this incongruence: our study tested a different time scale and used a retrospective, not a prospective paradigm."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The same explicit contrast identifies this independent earlier paper as a target of the environmental-size test.""}"
10.1111/lang.12403,a58225dce84de1c5,0,10.1016/j.neuropsychologia.2015.10.020,Tracking lexical consolidation with ERPs: Lexical and semantic-priming effects on N400 and LPC responses to newly-learned words.,"Bakker, I., Takashima, A., vanHell, J. G., Janzen, G., & McQueen, J. M.",2015,full_text,same_author_year_siblings,unverified,unresolved,{},"{""authors"": ""Bakker, I., Takashima, A., vanHell, J. G., Janzen, G., & McQueen, J. M."", ""year"": ""2015"", ""title"": ""Tracking lexical consolidation with ERPs: Lexical and semantic-priming effects on N400 and LPC responses to newly-learned words."", ""doi"": ""10.1016/j.neuropsychologia.2015.10.020"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Taken together, the current study sought to conceptually replicate and extend the findings of Bakker et al. (2015), and investigate novel vocabulary learning in monolingual English speakers with minimal foreign language learning experience."", ""outcome"": ""mixed"", ""outcome_quote"": ""Both types of learners showed a LPC semantic priming effect (indexing controlled semantic retrieval), but no N400 effect (indexing at least partial automatic semantic retrieval), after a 24-hour consolidation period. The main difference is that only the experienced learners (Bakker et al., 2015) also showed a frontal LPC priming effect shortly after learning (for words trained and tested on Day 2)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly compare agreement after 24 hours with absence of the original immediate LPC effect. No overall replication verdict overrides these comparisons.""}"
10.1371/journal.pone.0229161,b74519d198cc668b,1,10.1177/0361684315580125,From sex objects to human beings: Masking sexual body parts and humanization as moderators to women’s objectification,"Bernard, P., Gervais, S. J., Allen, J., Delmée, A., & Klein, O.",2015,full_text,,unverified,unresolved,{},"{""authors"": ""Bernard, P., Gervais, S. J., Allen, J., Delmée, A., & Klein, O."", ""year"": ""2015"", ""title"": ""From sex objects to human beings: Masking sexual body parts and humanization as moderators to women’s objectification"", ""doi"": ""10.1177/0361684315580125"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2a"", ""evidence_quote"": ""We conducted three studies: a direct replication of Bernard and colleagues’ study [\n4\n], using their original materials, but with counterbalanced stimuli as in [\n5\n] (Study 1); a conceptual replication–to our knowledge the first one–with different sexualized materials to investigate whether the same pattern of results would emerge with different stimuli (Study 2a; indeed, so far most of the evidence in favor of the IBRT has emerged from research using the set of stimuli developed by Bernard and colleagues [\n4\n]); an investigation of the inversion effect with non-sexualized stimuli (Study 2b).\nWe expected (H1) stronger inversion effects for male than female targets and (H1b) that the participant’s gender would not moderate this difference between male and female targets. The confirmation of this hypothesis in Study 1 would be a direct replication of [\n5\n], and its confirmation in Study 2a would be a conceptual replication, enhancing its external validity beyond the specific stimuli. Study 2b tested a boundary condition, namely, whether differences in inversion effects between male and female targets would emerge also for non-sexualized stimuli."", ""outcome"": ""mixed"", ""outcome_quote"": ""Study 1 replicated the original results, showing a stronger inversion effect for male photos. However, no difference between male and female stimuli emerged in either Study 2a or 2b."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Direct replication agrees, conceptual replication fails; authors explicitly contrast these results. The validity critique does not remove the explicit close/conceptual mixed pattern.""}"
10.3389/fnhum.2022.937515,1b5f207ca572ce22,1,10.1113/jphysiol.2009.175885,Modulation of interhemispheric inhibition by volitional motor activity: an ipsilateral silent period study.,"Giovannelli F., Borgheresi A., Balestrieri F., Zaccara G., Viggiano M. P., Cincotta M., et al.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Giovannelli F., Borgheresi A., Balestrieri F., Zaccara G., Viggiano M. P., Cincotta M., et al."", ""year"": ""2009"", ""title"": ""Modulation of interhemispheric inhibition by volitional motor activity: an ipsilateral silent period study."", ""doi"": ""10.1113/jphysiol.2009.175885"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In fact, during the iSP paradigm we manipulated the activity of the contralateral hand, expecting to induce a stronger interhemispheric inhibition in the Contracted compared to the Relaxed condition (Giovannelli et al., 2009 ), which we did not observe."", ""outcome"": ""failed"", ""outcome_quote"": ""In fact, during the iSP paradigm we manipulated the activity of the contralateral hand, expecting to induce a stronger interhemispheric inhibition in the Contracted compared to the Relaxed condition (Giovannelli et al., 2009 ), which we did not observe. The null result on iSP modulation was surprising, considering the consistent effects reported previously throughout several manipulations of contralateral hand activity (Giovannelli et al., 2009 )."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""The predicted published contraction effect was directly tested but not observed; the authors do not give a verdict that the attempt as a whole was incapable of adjudication.""}"
10.3102/0162373720948884,6f1653adad3488ee,1,,"Selection into Identification in Fixed Effects Models, with Application to Head Start","Miller, D. L., Shenhav, N. A., & Grosz, M. Z.",2019,full_text,,unverified,unresolved,{},"{""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""outcome_computation"": ""computationally reproducible"", ""outcome_computational_quote"": ""These results closely replicate MSG (2019) findings and can be found in Table S16 of the online appendix."", ""outcome_robustness"": ""not checked"", ""outcome_robustness_quote"": ""We also performed the MSG (2019) reweighting-on-observables procedure for the Deming cohort sample. Similar to MSG (2019), we found reweighting attenuated the FFE estimates of Head Start for high school graduation, idleness, learning disability and poor health, but find little change on other young adult outcomes or ASI."", ""outcome_confident"": true, ""authors"": ""Miller, D. L., Shenhav, N. A., & Grosz, M. Z."", ""year"": ""2019"", ""title"": ""Selection into Identification in Fixed Effects Models, with Application to Head Start"", ""evidence_quote"": ""We also performed the MSG (2019) reweighting-on-observables procedure for the Deming cohort sample."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""results"", ""outcome_reasoning"": ""Table S16 directly compares MSG weighted estimates with their reproduced values. Reweighting is MSG finding being reproduced; no distinct alternative specifications testing MSG result are reported. New combined cohorts are independent extensions, not original-data robustness.""}"
10.1177/1091142114537892,990cdb9f33b9b199,0,,Coveting Thy Neighbor’s Manufacturing: The Dilemma of State Income Apportionment.,"Goolsbee Austan, Maydew Edward L.",2000,abstract,,unverified,unresolved,{},"{""authors"": ""Goolsbee Austan, Maydew Edward L."", ""year"": ""2000"", ""title"": ""Coveting Thy Neighbor’s Manufacturing: The Dilemma of State Income Apportionment."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""I gather data and attempt to replicate their analyses and findings."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": ""computational issues"", ""outcome_computational_quote"": ""I identify an apparent but inconsequential error in G&M’s sample, and I replicate the most widely cited result in the original article. Other results are substantively but not quantitatively replicated."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""When standard errors are clustered by state, as is now common econometric practice, lowering the weight on payroll in states’ corporate income tax apportionment formulae has no statistically significant impact on manufacturing employment."", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract explicitly reports numerical discrepancies in some original results and loss of significance under alternative standard errors. It also includes a newer-data extension; primary classification follows the re-analysis of the original data. Full text could further disambiguate the extent of numerical differences.""}"
10.1080/17470210903377380,55cf730a319892f9,1,10.1037/0278-7393.30.3.723,The time course of recovery for grammatical class information during lexical processing for syntactic construction,"Pechmann, T.; Garrett, M. F.; Zerbst, D.",2004,full_text,,unverified,unresolved,{},"{""authors"": ""Pechmann, T.; Garrett, M. F.; Zerbst, D."", ""year"": ""2004"", ""title"": ""The time course of recovery for grammatical class information during lexical processing for syntactic construction"", ""doi"": ""10.1037/0278-7393.30.3.723"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""If the word class effect observed here and by Pechmann and colleagues (2004 ; Pechmann & Zerbst, 2002 ) does not reflect a lexical effect, it would remove such evidence as support for models that assume word class constraints on lexical selection (e.g., Dell et al., 2008 ). In Experiment 2, we tried to establish whether a word class effect could be obtained when the variable imageability was controlled."", ""outcome"": ""failed"", ""outcome_quote"": ""Experiment 2 revealed that the word class effect could not be separated from the imageability effect: Naming latencies were sensitive to distractor imageability (see Lupker, 1979 ), but were not sensitive to distractor word class when imageability was controlled. These results conflict with the results of Pechmann and colleagues (2004 ; Pechmann & Zerbst, 2002 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly compare the tested word class effects to this original; outcome follows the reported agreement and disagreement.""}"
10.3389/fpsyg.2014.00875,10507719f2a93503,1,,Studies of similarity,"Tversky, A., Gati, I.",1978,full_text,,unverified,unresolved,{},"{""authors"": ""Tversky, A., Gati, I."", ""year"": ""1978"", ""title"": ""Studies of similarity"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": ""Experiment 4"", ""replication_study_numbers"": ""2a, 2b"", ""evidence_quote"": ""In Study 2 we attempted to replicate Experiment 4 in Tversky and Gati ( 1978 ) which was reported in Tversky ( 1977 ) as the second study providing support for the diagnosticity effect."", ""outcome"": ""statistically successful but flawed"", ""outcome_quote"": ""Thus, as the meta-analysis indicates, without eliminating possible substitution effects we replicate the original findings by Tversky ( 1977 ) and Tversky and Gati ( 1978 ). However, eliminating substitution effects strongly reduces the observed differences between conditions with averages of 2.89% (1a), 17.5% (1b), −1.21% (2a), and 1.24% (2b). Overall the size of differences between conditions, when substitution effects were eliminated, clustered around zero (see Figure 6 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors replicate the original choice pattern but identify substitution as a central confound; the effect disappears overall once that confound is eliminated. This is the paper’s main message, with the explicit joint verdict naming both originals.""}"
10.1017/ssh.2017.27,0245b18b007f60d7,1,10.1126/science.1251936,Inequality in the Long Run,"Piketty, Thomas, and Emmanuel Saez",2014,full_text,competing_supported_matches; conflicting_dois; same_author_year_siblings,unverified,unresolved,{},"{""authors"": ""Piketty, Thomas, and Emmanuel Saez"", ""year"": ""2014"", ""title"": ""Inequality in the Long Run"", ""doi"": ""10.1126/science.1251936"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""At least in the issue of Science for May 23, 2014 he has a coauthored review with Emmanuel Saez which presents his data for the top ten percent but does not present the companion series for the top one percent [Piketty and Saez 2014: Figure 2, 839]. I replicate the figure from Science here as Figure 4. It reproduced the data in Figure 10.6 from Piketty’s book except it drops the point for 1810, but it now inexplicably adds a point for 1890 that isn't in the book’s version."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""fulltext"", ""outcome_computation"": ""computational issues"", ""outcome_computational_quote"": ""For 1980 Piketty reported that he averaged the 1983 figure from Wolff [1994] with the 1989 Federal Reserve figure from Kennickell [2009]. Had he done that, the number would be 67.7, but he reported 67.2 (which is the 1989 figure unaveraged)."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""For 1870 Piketty reports Soltow’s number taken from Lindert, 71 percent, but without applying the 1.2 multiplier that he used on the top one-percent wealth share, which consistency suggests he should have done. Had he done so, his 1870 figure would be 85.2 percent of the wealth in the hands of the top 10 percent. But that figure implies there was a fall in the wealth share between 1870 and 1910."", ""outcome_confident"": true, ""outcome_reasoning"": ""Reconstruction yields substantive discrepancies in reported shares; alternative constructions of the same source estimates qualify the historical trend.""}"
10.1111/acer.15532,a679446e24e8a56a,1,10.1007/s00213-018-4922-8,"Alcohol use disorder symptoms are associated with greater relative value ascribed to alcohol, but not greater discounting of costs imposed on alcohol.","Hogarth, L. & Hardy, L.",2018,full_text,,unverified,unresolved,{},"{""authors"": ""Hogarth, L. & Hardy, L."", ""year"": ""2018"", ""title"": ""Alcohol use disorder symptoms are associated with greater relative value ascribed to alcohol, but not greater discounting of costs imposed on alcohol."", ""doi"": ""10.1007/s00213-018-4922-8"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our behavioral findings partially replicate previous results, showing that choice preference for alcohol was affected by the relative value of the alternative reward (Hogarth & Hardy,  2018 ; Karlsson et al.,  2024 )."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our behavioral findings partially replicate previous results, showing that choice preference for alcohol was affected by the relative value of the alternative reward (Hogarth & Hardy,  2018 ; Karlsson et al.,  2024 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly describe their behavioral findings as partially replicating the set of results from both cited papers. Relative-cost sensitivity replicated, while the relation between alcohol use severity and alcohol choice did not. The overall partial-replication verdict applies to both named originals.""}"
10.1121/10.0042222,3b3b69b425327e86,1,10.1016/j.cognition.2022.105320,Do individual differences in lexical reliance reflect states or traits?,"Giovannone, N., and Theodore, R. M.",2023,full_text,,unverified,unresolved,{},"{""authors"": ""Giovannone, N., and Theodore, R. M."", ""year"": ""2023"", ""title"": ""Do individual differences in lexical reliance reflect states or traits?"", ""doi"": ""10.1016/j.cognition.2022.105320"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Indeed, Giovannone & Theodore (2023) found in both sessions of their Ganong task that individuals who showed greater lexical effect used continuum VOT less during category identification. Results from Task 2 (Ganong Task) of the current experiment found the same pattern. However, in Task 1, we instead found a positive relationship (consistent with the original study). Thus, the findings are again mixed on whether there is a general pattern of trading-off high level information and acoustic information across individuals."", ""outcome"": ""mixed"", ""outcome_quote"": ""Indeed, Giovannone & Theodore (2023) found in both sessions of their Ganong task that individuals who showed greater lexical effect used continuum VOT less during category identification. Results from Task 2 (Ganong Task) of the current experiment found the same pattern. However, in Task 1, we instead found a positive relationship (consistent with the original study). Thus, the findings are again mixed on whether there is a general pattern of trading-off high level information and acoustic information across individuals."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper explicitly reports an agreeing result and a differing result across the tested relationships/tasks.""}"
10.1080/713755986,fed9b2985183e3e8,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Using the naming task, no affective priming was found in the present studies irrespective of prime-set size and target-set size (Experiment 1), irrespective of stimulus-onset asynchrony (Experiment 2), and even when a nearly exact replication of previous work that demonstrated the effect was conducted (Experiment 3)."", ""outcome"": ""failed"", ""outcome_quote"": ""Using the naming task, no affective priming was found in the present studies irrespective of prime-set size and target-set size (Experiment 1), irrespective of stimulus-onset asynchrony (Experiment 2), and even when a nearly exact replication of previous work that demonstrated the effect was conducted (Experiment 3)."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true}"
10.1016/j.infbeh.2019.101340,d7dd7a918f384d33,1,10.3389/fpsyg.2012.00370,Actions seen through babies’ eyes: A dissociation between looking time and predictive gaze.,"Daum, M. M., Attig, M., Gunawan, R., Prinz, W., & Gredebäck, G.",2012,full_text,,unverified,unresolved,{},"{""authors"": ""Daum, M. M., Attig, M., Gunawan, R., Prinz, W., & Gredebäck, G."", ""year"": ""2012"", ""title"": ""Actions seen through babies’ eyes: A dissociation between looking time and predictive gaze."", ""doi"": ""10.3389/fpsyg.2012.00370"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""In the path-paradigm, we expected 11-month-olds and 32-month-olds to anticipate the old path, thus the novel goal, as the action is performed by a non-human agent (Daum et al., 2012)."", ""outcome"": ""successful"", ""outcome_quote"": ""Considering the path-paradigm with the animated agent, 11-month-olds looked longer towards the familiarized path leading to the novel goal. Hence results are similar to Study 1 and Daum et al. (2012)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""New samples re-test the path-versus-goal result in animated-agent tasks. The paper explicitly describes agreement with Daum for infant and toddler path anticipations; adults also anticipate the goal in the animated path paradigm.""}"
10.1016/j.infbeh.2019.101340,d7dd7a918f384d33,2,10.1016/j.yhbeh.2017.03.006,Oxytocin promotes attention to social cues regardless of group membership.,"Pfundmair, M., Zwarg, C., Paulus, M., & Rimpel, A.",2017,full_text,,unverified,unresolved,{},"{""authors"": ""Pfundmair, M., Zwarg, C., Paulus, M., & Rimpel, A."", ""year"": ""2017"", ""title"": ""Oxytocin promotes attention to social cues regardless of group membership."", ""doi"": ""10.1016/j.yhbeh.2017.03.006"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""We hypothesized to find anticipations towards the familiarized goal within the adult sample in both paradigms (Daum et al., 2012; Pfundmair et al., 2017)."", ""outcome"": ""failed"", ""outcome_quote"": ""Pfundmair et al. (2017) found that adults anticipated the goal of a grasping hand as well as of a grasping claw, which is in contrast to our findings."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Study 2 explicitly predicts adult goal anticipations from this prior finding and contrasts its observed adult hand-path anticipation with that result. The original oxytocin effect itself is not re-tested; target is the adult action-goal anticipation finding.""}"
10.1080/23743603.2016.1248081,0e4a00331066c9e6,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Previous work has found that configuring participants into high-power versus low-power physical postures caused increases in subjective feelings of power, testosterone, and risk-taking as well as decreases in cortisol. We attempted to replicate and extend this pattern of findings by testing for the mediating role of testosterone and overconfidence in the relationship between power poses and risk-taking."", ""outcome"": ""failed"", ""outcome_quote"": ""We were unable to replicate the findings of the original study and subsequently found no evidence for our extended hypotheses."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall failure verdict.""}"
10.1177/23982128241255798,b035fe7f6b702c00,1,10.1523/JNEUROSCI.0349-18.2018,Single-trial phase entrainment of theta oscillations in sensory regions predicts human associative memory performance,"Wang, D.; Clouter, A.; Chen, Q.; et al.",2018,full_text,,unverified,unresolved,{},"{""authors"": ""Wang, D.; Clouter, A.; Chen, Q.; et al."", ""year"": ""2018"", ""title"": ""Single-trial phase entrainment of theta oscillations in sensory regions predicts human associative memory performance"", ""doi"": ""10.1523/JNEUROSCI.0349-18.2018"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Despite the theoretical and practical importance of TIME, there has not yet been a replication of the combined behavioural results of Clouter et al. (2017) and Wang et al. (2018) outside the original research group. Of particular importance for interpretation of memory enhancement effects is a replication in which all relevant control conditions (asynchronous theta, no-flicker, and synchronous non-theta) are combined in a single experiment. This is the aim of the present experiment."", ""outcome"": ""failed"", ""outcome_quote"": ""Together with the lack of evidence for any advantage of synchronous theta against asynchronous theta or synchronous delta, we conclude that we have failed to replicate the TIME reported by Clouter et al. (2017) and Wang et al. (2018) ."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""An explicit overall non-replication verdict names both targets. Incidental synchrony-discrimination confirmation is outside the central memory effect.""}"
10.1177/1948550616646426,6b77954dd4b14dae,1,,Deflecting the trajectory and changing the narrative: How self-affirmation affects academic performance and motivation under identity threat.,"Sherman, D. K., Hartson, K. A., Binning, K. R., Purdie-Vaughns, V., Garcia, J., Taborsky-Barba, S., . . . Cohen, G. L.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Sherman, D. K., Hartson, K. A., Binning, K. R., Purdie-Vaughns, V., Garcia, J., Taborsky-Barba, S., . . . Cohen, G. L."", ""year"": ""2013"", ""title"": ""Deflecting the trajectory and changing the narrative: How self-affirmation affects academic performance and motivation under identity threat."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also explored whether affirmations worked best for the lowest performing students, as has been found in prior research (Sherman et al., 2013)."", ""outcome"": ""failed"", ""outcome_quote"": ""We also explored whether affirmations worked best for the lowest performing students, as has been found in prior research (Sherman et al., 2013). To pursue this possibility, we included the students’ previous term GPA as a covariate and interaction term with experimental condition and ethnic stereotype status. This controls for prior differences in achievement and allows an even more powerful test of the effect. In this model, previous term GPA significantly predicted later term GPA (b ¼ .952, 95% confidence interval [CI] [0.879, 1.024]), no other main effect or interaction approached significance (all ps > .266)."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""The reported test does not support the corresponding original finding.""}"
10.1098/rsos.191114,43fa795352067a92,1,10.1177/1088868309352321,Two decades of terror management theory: a meta-analysis of mortality salience research,"Burke BL, Martens A, Faucher EH",2010,full_text,,unverified,unresolved,{},"{""authors"": ""Burke BL, Martens A, Faucher EH"", ""year"": ""2010"", ""title"": ""Two decades of terror management theory: a meta-analysis of mortality salience research"", ""doi"": ""10.1177/1088868309352321"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our own inspection of the data reported by Burke et al. [3] converges to the conclusion that the robustness of these effect sizes may have been overestimated."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": ""not checked"", ""outcome_computational_quote"": ""Instead of analysing raw correlation coefficients, which are constrained to adopt values from −1 to +1 and do not follow a normal distribution, we converted all effect sizes to Fisher's z scores."", ""outcome_robustness"": ""robustness challenges"", ""outcome_robustness_quote"": ""Consistent with the former interpretation, our own reanalysis of Burke et al. ([3]; see also [11]) provides compelling evidence that the effect sizes of previous research on mortality salience may have been overestimated."", ""outcome_confident"": true, ""outcome_reasoning"": ""Same meta-analytic data reanalysed using bias-sensitive alternatives; bias-corrected effect 37% smaller and original absence-of-bias conclusion challenged. Original-number reproduction was outside these alternative analyses.""}"
10.3390/jintelligence7010006,cfc2ba332d77bd60,1,,Psychological Examining in the United States Army.,Yerkes R.M.,1921,full_text,,unverified,unresolved,{},"{""authors"": ""Yerkes R.M."", ""year"": ""1921"", ""title"": ""Psychological Examining in the United States Army."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To further test the viability of the one-factor model, we performed confirmatory factor analysis on two correlation matrices of Army Beta data for World War I draftees ([15], pp. 390, 634)."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_computation"": ""not checked"", ""outcome_computational_quote"": ""To further test the viability of the one-factor model, we performed confirmatory factor analysis on two correlation matrices of Army Beta data for World War I draftees ([15], pp. 390, 634)."", ""outcome_robustness"": ""robust"", ""outcome_robustness_quote"": ""Thus, even in two samples of World War I draftees—groups that would be much more likely to have a separate factor for recognition of written numbers than a modern sample of college students—a one-factor model fit the data just as well as a two-factor model. Again, parsimony dictates that researchers should favor a one-factor model of intelligence from the historic Army Beta data."", ""outcome_reasoning"": ""A secondary reproduction reanalyses two original correlation matrices using alternative factor models to test the substantive validity finding. Recovering original reported coefficients was outside this analysis; the original general-ability interpretation survives the tested alternative. Both matrices belong to one original volume.""}"
10.1002/bem.10105,54ae4433391a94ab,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our study was a replication and extension with methodological improvements to a previous study on effects of the electromagnetic field (EMF) emitted by a 902 MHz mobile phone on human cognitive functioning."", ""outcome"": ""failed"", ""outcome_quote"": ""Although the RTs and the accuracy of answers were very similar to those of our previous study, our previous results were not replicated."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall failure verdict. The abstract does not identify the previous study bibliographically; no guess is made among related prior works.""}"
10.1038/sj.ejhg.5201317,46d9e2d0b98ee6de,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Recently, significant linkage has been reported to a 39.5 cM region on the long arm of chromosome 2 (2q36-37; PARK11) in North American Parkinson families under an autosomal dominant model of inheritance. We have performed a replication study to confirm linkage to this region in a European population."", ""outcome"": ""failed"", ""outcome_quote"": ""Linkage analysis in 153 individuals from 45 European families with a strong family history of PD did not show any significant LOD score in this region. Therefore, PARK11 does not seem to play a major role for familial PD in the European population."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""Explicit replication of previously significant linkage yields no linkage and an overall negative conclusion.""}"
10.1128/jvi.00693-11,c8ced3fa8a29c729,1,,"Detection of an infectious retrovirus, XMRV, in blood cells of patients with chronic fatigue syndrome.","Lombardi V. C., et al.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Lombardi V. C., et al."", ""year"": ""2009"", ""title"": ""Detection of an infectious retrovirus, XMRV, in blood cells of patients with chronic fatigue syndrome."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Furthermore, we also analyzed the WPI samples using tests from the two studies that found XMRV or XMRV-like viruses in CFS patients, viz. a PCR assay for gag sequences, both in single-round ( 12 ) and nested formats ( 11 ), and a test for viral growth in cultured cells ( 12 ). Neither of these tests revealed any evidence of XMRV."", ""outcome"": ""failed"", ""outcome_quote"": ""Our findings do not support an association between CFS and MLV-related viruses, including XMRV, and the off-label use of antiretrovirals for the treatment of CFS does not seem justified at present."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Overall verdict rejects the association reported by both positive original studies; new samples and repeated assays find no specific viral association. Initial positives attributed to contamination are not a successful replication verdict.""}"
10.2522/ptj.20120444,db4af6ad7a4749b7,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The purposes of the study were to replicate some aspects of the original study of the OPTIMAL Difficulty and Confidence scales and to conduct additional psychometric tests."", ""outcome"": ""failed"", ""outcome_quote"": ""The findings generally did not support the psychometric properties of the OPTIMAL instrument."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract states an overall negative verdict on the psychometric properties being re-tested. Citation fields unavailable in abstract; no target metadata imported from external sources.""}"
10.1371/journal.pone.0096654,a1595e3436c3f948,1,,Social heuristics shape intuitive cooperation.,"Rand DG, Peysakhovich A, Kraft-Todd GT, Newman GE, Wurzbacher O, et al.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Rand DG, Peysakhovich A, Kraft-Todd GT, Newman GE, Wurzbacher O, et al."", ""year"": ""2014"", ""title"": ""Social heuristics shape intuitive cooperation."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Considering that Mechanical Turk workers from the United States are experienced, and that the intuitive-cooperation effect interacts with experience, it might be possible that Rand and colleagues\n[8]\nrecent failures to find an intuitive-cooperation effect in Mechanical Turk experiments as well as our failures to find such an effect in Experiment 1 and in Experiments 2a, 2b and 2c are due to the Mechanical Turk population becoming increasingly experienced in playing public good games. In order to test this experience hypothesis of our replication failures, we conducted a third experiment."", ""outcome"": ""failed"", ""outcome_quote"": ""In Experiment 3, we again failed to demonstrate an intuitive-cooperation effect. This replication failure contradicts the experience hypothesis because it was obtained using naïve participants only."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly report failure of the intuitive-cooperation effect.""}"
10.1097/brs.0000000000000807,1bd88ffc8036c3a7,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To determine whether the 53 single nucleotide polymorphisms (SNPs) that were previously associated with spinal deformity progression in an American Caucasian cohort are similarly associated in French-Canadian population."", ""outcome"": ""failed"", ""outcome_quote"": ""Although the 52 SNPs studied here were previously associated with curve progression in an American population of European descent, we found no association in French-Canadian patients with adolescent idiopathic scoliosis."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly report no association against the previous positive association. The abstract does not identify the original citation; no reference list is available.""}"
10.18632/oncotarget.9819,1e8323e953d1828e,1,10.1038/tp.2014.2,Follow-up of loci from the International Genomics of Alzheimer's Disease Project identifies TRIP4 as a novel susceptibility gene.,"Ruiz A, Heilmann S, Becker T, Hernandez I, Wagner H, Thelen M, Mauleon A, Rosende-Roca M, Bellenguez C, Bis JC, Harold D, Gerrish A, Sims R, et al.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Ruiz A, Heilmann S, Becker T, Hernandez I, Wagner H, Thelen M, Mauleon A, Rosende-Roca M, Bellenguez C, Bis JC, Harold D, Gerrish A, Sims R, et al."", ""year"": ""2014"", ""title"": ""Follow-up of loci from the International Genomics of Alzheimer's Disease Project identifies TRIP4 as a novel susceptibility gene."", ""doi"": ""10.1038/tp.2014.2"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Recently, a large meta-analysis has confirmed that the SNP rs190982 polymorphism within MEF2C on chromosome 5 acted as a protective factor for AD dementia (OR = 0.93, 95%CI = 0.90-0.95, P = 3.2×10 −8 ) in the Caucasian population [ 14 ]. Similarly, the association between the MEF2C gene rs190982 polymorphism and AD was also confirmed in a large Spanish sample (OR = 0.885, 95%CI = 0.811-0.966) [ 15 ]. Furthermore, another two studies replicated the association in China Han. Regretfully, they failed to reveal any association of rs190982 polymorphism in MEF2C gene with AD susceptibility in our Han Chinese cohort [ 16 , 17 ]. Here, we conducted a case-control study containing 2332 individuals to clarify whether the selected SNP on MEF2C gene has an association with LOAD in Northern Han Chinese population."", ""outcome"": ""failed"", ""outcome_quote"": ""In contrast to our results, Lambert et al. [ 14 ] identified rs190982 as a protective factor to the development of LOAD in Caucasian patients in a large-scale GWAS (OR = 0.93, 95%CI = 0.90-0.95). In addition, Ruiz et al. [ 15 ] also detected that rs190982 could decrease the risk of AD through multiple test in a large Spanish sample (OR = 0.885, 95%CI = 0.81 1-0.966)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly contrast the new sample null association with this published protective association. Meta-analytic pooling does not change the result of their own replication.""}"
10.1002/smj.2905,4d78b6f175169c98,0,,,"Hill, Upadhyay and Beekun",2015,abstract,,unverified,unresolved,{},"{""authors"": ""Hill, Upadhyay and Beekun"", ""year"": ""2015"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""With the goal of contributing to cumulative knowledge development in this area, we seek to reexamine Hill et al.'s finding about gender differences in CEO compensation by extending the analyses further in time, using a larger sample of firms and more rigorous empirical analyses."", ""outcome"": ""failed"", ""outcome_quote"": ""Recently, Hill, Upadhyay and Beekun reported that female CEOs receive greater compensation than male CEOs, which runs counter to common wisdom that the gender pay gap in the labor market favors men over women. With the goal of contributing to cumulative knowledge development in this area, we seek to reexamine Hill et al.'s finding about gender differences in CEO compensation by extending the analyses further in time, using a larger sample of firms and more rigorous empirical analyses. Our findings, which are robust to different statistical procedures and econometric specifications, do not reveal reliable evidence for differences in compensation paid to male and female CEOs."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_reasoning"": ""The abstract explicitly identifies the earlier female pay advantage and finds no reliable difference. Expanded firms and years support replication rather than exclusively reanalysis of original data. No reference list accessible, so full citation title and initials are unavailable.""}"
10.1186/s13018-018-0769-2,f7079a3b8eb85bc0,1,10.1136/annrheumdis-2013-203772,The effect of FTO variation on increased osteoarthritis risk is mediated through body mass index: a mendelian randomisation study,"Panoutsopoulou K, Metrustry S, Doherty SA, Laslett LL, Maciewicz RA, Hart DJ, et al.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Panoutsopoulou K, Metrustry S, Doherty SA, Laslett LL, Maciewicz RA, Hart DJ, et al."", ""year"": ""2014"", ""title"": ""The effect of FTO variation on increased osteoarthritis risk is mediated through body mass index: a mendelian randomisation study"", ""doi"": ""10.1136/annrheumdis-2013-203772"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""An extended study of the GWAS study revealed that the association between rs8044769 and OA was degenerated after stratification by BMI, and the association between rs8044769 and BMI was identified in this study [14]."", ""outcome"": ""failed"", ""outcome_quote"": ""An extended study of the GWAS study revealed that the association between rs8044769 and OA was degenerated after stratification by BMI, and the association between rs8044769 and BMI was identified in this study [14]. There have been several reports for the association between FTO and BMI [6–12], and two of them referred to rs8044769 as BMI associated SNP [11, 12]. So, we suspected that the association between rs8044769 and BMI may contribute to the association between this SNP and OA in the GWAS study. However, in our study, rs8044769 was not associated with BMI, and it might be another reason for the negative association between rs8044769 and OA."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The extended GWAS paper is explicitly compared on the SNP–BMI association; the current study fails to find that association.""}"
10.1186/s13018-018-0769-2,f7079a3b8eb85bc0,2,10.1038/oby.2009.159,The role of obesity-associated loci identified in genome-wide association studies in the determination of pediatric BMI,"Zhao J, Bradfield JP, Li M, Wang K, Zhang H, Kim CE, et al.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Zhao J, Bradfield JP, Li M, Wang K, Zhang H, Kim CE, et al."", ""year"": ""2009"", ""title"": ""The role of obesity-associated loci identified in genome-wide association studies in the determination of pediatric BMI"", ""doi"": ""10.1038/oby.2009.159"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The association of the FTO polymorphism (rs8044769) with BMI was not replicated in the Chinese Han population either. The previous studies showed that FTO was associated with BMI [6–12], and two of them referred to rs8044769 as BMI-associated SNP [11, 12]. In the association analysis of rs8044769 with BMI, we found no association between rs8044769 and BMI."", ""outcome"": ""failed"", ""outcome_quote"": ""The association of the FTO polymorphism (rs8044769) with BMI was not replicated in the Chinese Han population either. The previous studies showed that FTO was associated with BMI [6–12], and two of them referred to rs8044769 as BMI-associated SNP [11, 12]. In the association analysis of rs8044769 with BMI, we found no association between rs8044769 and BMI."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly identify references 11 and 12 as reports of the exact rs8044769–BMI association and state that this association was not replicated. Other FTO variants in references 6–10 are background.""}"
10.1186/s13018-018-0769-2,f7079a3b8eb85bc0,3,10.1038/ijo.2010.244,Analysis of FTO gene variants with obesity and glucose homeostasis measures in the multiethnic insulin resistance atherosclerosis study cohort,"Wing MR, Ziegler JM, Langefeld CD, Roh BH, Palmer ND, Mayer-Davis EJ, et al.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Wing MR, Ziegler JM, Langefeld CD, Roh BH, Palmer ND, Mayer-Davis EJ, et al."", ""year"": ""2011"", ""title"": ""Analysis of FTO gene variants with obesity and glucose homeostasis measures in the multiethnic insulin resistance atherosclerosis study cohort"", ""doi"": ""10.1038/ijo.2010.244"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The association of the FTO polymorphism (rs8044769) with BMI was not replicated in the Chinese Han population either. The previous studies showed that FTO was associated with BMI [6–12], and two of them referred to rs8044769 as BMI-associated SNP [11, 12]. In the association analysis of rs8044769 with BMI, we found no association between rs8044769 and BMI."", ""outcome"": ""failed"", ""outcome_quote"": ""The association of the FTO polymorphism (rs8044769) with BMI was not replicated in the Chinese Han population either. The previous studies showed that FTO was associated with BMI [6–12], and two of them referred to rs8044769 as BMI-associated SNP [11, 12]. In the association analysis of rs8044769 with BMI, we found no association between rs8044769 and BMI."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly identify references 11 and 12 as reports of the exact rs8044769–BMI association and state that this association was not replicated. Other FTO variants in references 6–10 are background.""}"
10.1186/s13018-018-0769-2,f7079a3b8eb85bc0,4,10.1302/2046-3758.55.2000589,No association of the single nucleotide polymorphism rs8044769 in the fat mass and obesity-associated gene with knee osteoarthritis risk and body mass index: a population-based study in China,"Wang Y, Chu M, Rong J, Xing B, Zhu L, Zhao Y, et al.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""Wang Y, Chu M, Rong J, Xing B, Zhu L, Zhao Y, et al."", ""year"": ""2016"", ""title"": ""No association of the single nucleotide polymorphism rs8044769 in the fat mass and obesity-associated gene with knee osteoarthritis risk and body mass index: a population-based study in China"", ""doi"": ""10.1302/2046-3758.55.2000589"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""A study on Chinese Han population denied this association, but the subject number of the Chinese study was a little bit small [16]. Until now, the association between FTO and OA remains debatable.Therefore, we evaluated the potential association of the FTO polymorphism (rs8044769) with OA in the Chinese Han population with more cases and controls."", ""outcome"": ""successful"", ""outcome_quote"": ""Our results were consistent with a previous study in Chinese population and had enlarged studied subjects. We also conducted a meta-analysis together with the previous study in Chinese population to offer a solid evidence that rs8044769 of FTO was not associated with OA risk or BMI in Chinese population."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The explicitly motivated larger Chinese sample re-tests the earlier Chinese null and agrees. The new sample independently re-tests this finding; the accompanying pooled meta-analysis is not the sole basis.""}"
10.3390/rs14030597,58537b5a1a67b22d,1,10.1016/j.rse.2011.01.021,Differences in Landsat-Based Trend Analyses in Drylands due to the Choice of Vegetation Estimate.,"Sonnenschein, R.; Kuemmerle, T.; Udelhoven, T.; Stellmes, M.; Hostert, P.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Sonnenschein, R.; Kuemmerle, T.; Udelhoven, T.; Stellmes, M.; Hostert, P."", ""year"": ""2011"", ""title"": ""Differences in Landsat-Based Trend Analyses in Drylands due to the Choice of Vegetation Estimate."", ""doi"": ""10.1016/j.rse.2011.01.021"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The VD 1.0 processing was performed in FORCE, too, although some more user interactions were necessary to reproduce a workflow comparable to [42,49]."", ""outcome"": ""mixed"", ""outcome_quote"": ""However, the results from VD 2.0 are fundamentally different to those from VD 1.0 (Figure 5b). Severe cover loss is limited to small areas and the magnitude of cover change is smaller compared to VD 1.0. Overall, net cover change is positive with 18% of areas showing a decreasing trend of vegetation cover, while half (50%) of all semi-natural areas exhibit an increase (Table 4)."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly say the restricted-data VD 1.0 reconstruction agrees with both references, but the full-data VD 2.0 test reverses the net trend. Close agreement alongside a changed-data replication that disagrees is mixed under the codebook.""}"
10.1186/s12888-023-04903-9,b3185f4a2cdbe718,1,10.1007/s10803-017-3422-8,The Glasgow Sensory Questionnaire: validation of a French language version and refinement of sensory profiles of people with high Autism-Spectrum Quotient,"Sapey-Triomphe L-A, Moulin A, Sonié S, Schmitz C",2018,full_text,,unverified,unresolved,{},"{""authors"": ""Sapey-Triomphe L-A, Moulin A, Sonié S, Schmitz C"", ""year"": ""2018"", ""title"": ""The Glasgow Sensory Questionnaire: validation of a French language version and refinement of sensory profiles of people with high Autism-Spectrum Quotient"", ""doi"": ""10.1007/s10803-017-3422-8"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The two main goals of this study were: (a) the validation of the German version of the GSQ according to the Universalist model of cross-cultural adaptation [ 29 ] and (b) the replication of sensory processing differences of individuals with higher or lower AQ scores as reported in the original English version by Robertson and Simmons [ 48 ] and in the French version of Sapey-Triomphe et al. [ 51 ]."", ""outcome"": ""uninformative"", ""outcome_quote"": ""Contrary to expectations, only 35 out of 297 students had AQ scores higher than 26 in our sample. Therefore, the present sample seems not suitable for drawing meaningful conclusions about the sensory processing differences of individuals with higher AQ scores."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors also call the replication unsuccessful, but explicitly judge their sample unsuitable for meaningful conclusions because too few participants had high AQ. The codebook special verdict for a non-adjudicating attempt takes precedence. Both named targets are included in the replication objective.""}"
10.1007/s11002-024-09739-1,aac86ddf4e1dacb0,1,10.1093/jcr/ucac017,Bundle Selection and Variety Seeking: The Importance of Combinatorics.,"O’Donnell, M., Critcher, C. R., & Nelson, L. D.",2023,full_text,,unverified,unresolved,{},"{""authors"": ""O’Donnell, M., Critcher, C. R., & Nelson, L. D."", ""year"": ""2023"", ""title"": ""Bundle Selection and Variety Seeking: The Importance of Combinatorics."", ""doi"": ""10.1093/jcr/ucac017"", ""identified_by"": ""citation"", ""study_numbers"": ""Supplemental Study E"", ""replication_study_numbers"": ""1a, 1b, 2a, 2b"", ""evidence_quote"": ""To clarify the direction of effect, we conducted four studies in two product categories and found evidence of a stronger preference for variety in bundled offering conditions (compared to single offering conditions), replicating O’Donnell et al.’s (2023) findings."", ""outcome"": ""successful"", ""outcome_quote"": ""To clarify the direction of effect, we conducted four studies in two product categories and found evidence of a stronger preference for variety in bundled offering conditions (compared to single offering conditions), replicating O’Donnell et al.’s (2023) findings."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper explicitly compares its own results with this target and states the direction of agreement or contradiction.""}"
10.5114/cipp/189860,f09bd7ad99cf794f,0,10.1037/h0036049,The assessment of effectance motivation in normal and retarded children.,"Harter, S., & Zigler, E.",1974,full_text,,unverified,unresolved,{},"{""authors"": ""Harter, S., & Zigler, E."", ""year"": ""1974"", ""title"": ""The assessment of effectance motivation in normal and retarded children."", ""doi"": ""10.1037/h0036049"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Based on descriptions available in the literature, we prepared tasks similar to those that were used to differentiate the performance of people with intellectual disability and controls in the original studies (Harter & Zigler, 1974; Yando & Zigler, 1971; Zigler & Balla, 1972)."", ""outcome"": ""failed"", ""outcome_quote"": ""The results of our study do not support the hypothesis regarding differences between people with intellectual disability and people from the general population; as such, they are not in accordance with the results of previous studies conducted by Zigler and colleagues."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors state their overall results do not support the hypothesized group differences and disagree with the earlier studies; the statement covers the three named originals. Directional means and possible sample-size limitations do not override that verdict.""}"
