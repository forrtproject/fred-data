10.1002/jaba.613,b99fe2c5d5675e4b,1,10.1002/jaba.67,Effects of two variations of differential reinforcement on prompt dependency,"Cividini-Motta, C., & Ahearn, W. H.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Cividini-Motta, C., & Ahearn, W. H."", ""year"": ""2013"", ""title"": ""Effects of two variations of differential reinforcement on prompt dependency"", ""doi"": ""10.1002/jaba.67"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The current research sought to systematically replicate Smaby et al. (2007) and Cividini-Motta and Ahearn’s (2013) use of the MSA, speci ﬁ cally to evaluate the relative reinforcing ef ﬁ cacy of the individual components of a token economy in a brief assessment."", ""outcome"": ""descriptive only"", ""outcome_quote"": ""The current research sought to systematically replicate Smaby et al. (2007) and Cividini-Motta and Ahearn’s (2013) use of the MSA, speci ﬁ cally to evaluate the relative reinforcing ef ﬁ cacy of the individual components of a token economy in a brief assessment."", ""outcome_quote_section"": ""introduction"", ""outcome_confident"": false, ""outcome_reasoning"": ""Authors explicitly replicate use of the assessment in a token-economy application. Discussion confirms utility of the method but does not compare the specific earlier social-reinforcer or prompt-dependency effects. Methodological success alone is not a finding comparison.""}"
10.1152/jn.00412.2024,7b36096465800442,1,10.1016/j.neurobiolaging.2019.03.020,Internal model recalibration does not deteriorate with age while motor adaptation does.,"Vandevoorde K, Orban de Xivry JJ.",2019,full_text,,unverified,unresolved,{},"{""authors"": ""Vandevoorde K, Orban de Xivry JJ."", ""year"": ""2019"", ""title"": ""Internal model recalibration does not deteriorate with age while motor adaptation does."", ""doi"": ""10.1016/j.neurobiolaging.2019.03.020"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Therefore, we set out to measure both implicit adaptation and its retention via spontaneous recovery in a single force-ﬁeld paradigm in both healthy young and older adults to test four different hypotheses, reﬂecting previous research: 1) implicit adaptation levels at the end of the adaptation period are similar across age groups (27), 2) spontaneous recovery is larger in young than in older participants (37), 3) implicit adaptation at the end of the adaptation period is correlated with the amount of spontaneous recovery (45), and 4) as suggested by Trewartha and colleagues, spontaneous recovery is related to explicit memory processes such as working memory capacity."", ""outcome"": ""successful"", ""outcome_quote"": ""Across age groups, we observed little difference in performance in this task. Both total adaptation and implicit adaptation were not impaired in older adults compared with their younger controls."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Hypothesis 1 explicitly re-tests reference 27: preserved implicit adaptation with age. New sample shows the same finding.""}"
10.1152/jn.00412.2024,7b36096465800442,2,10.1523/JNEUROSCI.5061-14.2015,Explicit and implicit processes constitute the fast and slow processes of sensorimotor learning.,"McDougle SD, Bond KM, Taylor JA.",2015,full_text,,unverified,unresolved,{},"{""authors"": ""McDougle SD, Bond KM, Taylor JA."", ""year"": ""2015"", ""title"": ""Explicit and implicit processes constitute the fast and slow processes of sensorimotor learning."", ""doi"": ""10.1523/JNEUROSCI.5061-14.2015"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Therefore, we set out to measure both implicit adaptation and its retention via spontaneous recovery in a single force-ﬁeld paradigm in both healthy young and older adults to test four different hypotheses, reﬂecting previous research: 1) implicit adaptation levels at the end of the adaptation period are similar across age groups (27), 2) spontaneous recovery is larger in young than in older participants (37), 3) implicit adaptation at the end of the adaptation period is correlated with the amount of spontaneous recovery (45), and 4) as suggested by Trewartha and colleagues, spontaneous recovery is related to explicit memory processes such as working memory capacity."", ""outcome"": ""successful"", ""outcome_quote"": ""This is consistent with the correlation between the amount of implicit adaptation during learning and the amount of spontaneous recovery (Fig. 6). This is also consistent with the ﬁndings of McDougle et al. (45)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Hypothesis 3 explicitly re-tests reference 45 linking implicit adaptation to spontaneous recovery; discussion explicitly agrees.""}"
10.1111/2041-210x.13602,a6ce639055c5e466,1,10.7554/eLife.46923,Consistent and correctable bias in metagenomic sequencing experiments.,"McLaren, M. R., Willis, A. D., & Callahan, B. J.",2019,full_text,,unverified,unresolved,{},"{""authors"": ""McLaren, M. R., Willis, A. D., & Callahan, B. J."", ""year"": ""2019"", ""title"": ""Consistent and correctable bias in metagenomic sequencing experiments."", ""doi"": ""10.7554/eLife.46923"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We recovered Elbrecht et al.'s (2017)\nfinding that efficiency is higher when species evenness is higher\n(Figure 2; Figure S1), and we found that OTU sizes are a poor pre-\ndictor of input genomic DNA, which confirms the conventional wis-\ndom that OTU size is a poor predictor of species relative abundances\n(Figure S2; McLaren et al., 2019)."", ""outcome"": ""successful"", ""outcome_quote"": ""We recovered Elbrecht et al.'s (2017)\nfinding that efficiency is higher when species evenness is higher\n(Figure 2; Figure S1), and we found that OTU sizes are a poor pre-\ndictor of input genomic DNA, which confirms the conventional wis-\ndom that OTU size is a poor predictor of species relative abundances\n(Figure S2; McLaren et al., 2019)."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1111/2041-210x.13602,a6ce639055c5e466,2,10.1128/Aem.05220-11,Barcoded primers used in multiplex amplicon pyrosequencing bias amplification.,"Berry, D., Ben Mahfoudh, K., Wagner, M., & Loy, A.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Berry, D., Ben Mahfoudh, K., Wagner, M., & Loy, A."", ""year"": ""2011"", ""title"": ""Barcoded primers used in multiplex amplicon pyrosequencing bias amplification."", ""doi"": ""10.1128/Aem.05220-11"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also find no evidence for ‘tag bias’, which is the hypoth-\nesis that the sample-­\nidentifying nucleotide sequences attached to\nPCR primers might promote annealing to some template-­\nDNA se-\nquences over others, exacerbating taxonomic bias in PCR (e.g. Berry\net al., 2011; O'Donnell et al., 2016)."", ""outcome"": ""failed"", ""outcome_quote"": ""We found no evidence for tag bias in PCR amplification. For instance,\nunder optimal PCR conditions (A & B), pairs using the same tags (A1/\nB1, A2/B2, A3/B3) and pairs using different tags (e.g. A1/B2, A2/\nB1, A3/B2, …) both generated almost identical NMDS ordinations\n(Figure 3). Under non-­\noptimal PCRs, we still found no evidence for\ntag bias, even though at higher annealing temperatures, some tag\nsequences might be more likely to aid primer annealing (Figures S3\nand S4). Note that we did not correct the p-­\nvalues for three tests,\nunderlining the lack of evidence for tag bias."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true}"
10.1111/2041-210x.13602,a6ce639055c5e466,3,10.1371/journal.pone.0148698,Indexed PCR primers induce template-specific bias in large-scale DNA sequencing studies.,"O'Donnell, J. L., Kelly, R. P., Lowell, N. C., & Port, J. A.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""O'Donnell, J. L., Kelly, R. P., Lowell, N. C., & Port, J. A."", ""year"": ""2016"", ""title"": ""Indexed PCR primers induce template-specific bias in large-scale DNA sequencing studies."", ""doi"": ""10.1371/journal.pone.0148698"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also find no evidence for ‘tag bias’, which is the hypoth-\nesis that the sample-­\nidentifying nucleotide sequences attached to\nPCR primers might promote annealing to some template-­\nDNA se-\nquences over others, exacerbating taxonomic bias in PCR (e.g. Berry\net al., 2011; O'Donnell et al., 2016)."", ""outcome"": ""failed"", ""outcome_quote"": ""We found no evidence for tag bias in PCR amplification. For instance,\nunder optimal PCR conditions (A & B), pairs using the same tags (A1/\nB1, A2/B2, A3/B3) and pairs using different tags (e.g. A1/B2, A2/\nB1, A3/B2, …) both generated almost identical NMDS ordinations\n(Figure 3). Under non-­\noptimal PCRs, we still found no evidence for\ntag bias, even though at higher annealing temperatures, some tag\nsequences might be more likely to aid primer annealing (Figures S3\nand S4). Note that we did not correct the p-­\nvalues for three tests,\nunderlining the lack of evidence for tag bias."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true}"
10.1080/02699206.2018.1504989,a3bfced90a859553,1,,Vocal Tract Control in Parkinson's Disease.,"Logemann, J. A. & Fisher, H. B.",1981,full_text,,unverified,unresolved,{},"{""authors"": ""Logemann, J. A. & Fisher, H. B."", ""year"": ""1981"", ""title"": ""Vocal Tract Control in Parkinson's Disease."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Influential reports on speech changes in people with Parkinson’s disease (Logemann et al, 1978, 1981) reported a posterior to anterior pattern of loss of speech sound accuracy. These claims have never been examined. In a partial replication of Logemann et al’s work we examined whether posterior lingual sounds are most affected in people with Parkinson’s disease, followed by anterior lingual sounds then labial sounds."", ""outcome"": ""failed"", ""outcome_quote"": ""This study sought to re-examine the long propagated assumption that there is a posterior- anterior progression in articulatory breakdown in PD. The current data failed to uphold the assertion."", ""outcome_quote_section"": ""fulltext"", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall conclusion rejects the common posterior-to-anterior assertion in both original papers.""}"
10.1111/j.1467-7687.2004.00322.x,7bc9ff8a5446a5aa,1,,,,,full_text,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also replicated the finding that 4-year-olds are significantly more productive than 2 1/2 -year-olds with the transitive construction, with the new finding that this is also true for verbs of emission."", ""outcome"": ""successful"", ""outcome_quote"": ""We also replicated the finding that 4-year-olds are significantly more productive than 2 1/2 -year-olds with the transitive construction, with the new finding that this is also true for verbs of emission."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The age finding is explicitly replicated, but the discussion attributes it only to the Tomasello (2000) review. No uniquely identifiable primary original paper is supplied for that age comparison; review excluded as target citation.""}"
10.31979/etd.eh36-m2wx,551ceb3696631a2f,0,,,Condry and Condry,,abstract,,unverified,unresolved,{},"{""authors"": ""Condry and Condry"", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This was tested using a conceptual replication of an influential gender label study by Condry and Condry in which participants viewed a video of a baby crying in response to a startling event."", ""outcome"": ""failed"", ""outcome_quote"": ""Contrary to the Condry findings, this study found that participant perception of why a baby was crying was not consistent with the gender label given (consistent, being angry for the boy label and fearful for the girl label). Participant ratings did not vary significantly based on the gender label."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract directly contrasts the tested gender-label finding with the original; reference details are absent.""}"
