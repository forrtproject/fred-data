10.1016/j.jenvp.2024.102289,d474c9df976cbc31,1,,"When worry about climate change leads to climate action: How values, worry and personal responsibility relate to various climate actions","Bouman, T., et al.",2020,abstract,,unverified,unresolved,{},"{""authors"": ""Bouman, T., et al."", ""year"": ""2020"", ""title"": ""When worry about climate change leads to climate action: How values, worry and personal responsibility relate to various climate actions"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The current study replicates and extends recent work (Bouman et al., 2020; Syropoulos & Markowitz, 2022) which found a meaningful and robust relationship between people's feelings of responsibility to reduce climate change, their worry about climate change, and their belief that climate change is caused by humans."", ""outcome"": ""successful"", ""outcome_quote"": ""The current study replicates and extends recent work (Bouman et al., 2020; Syropoulos & Markowitz, 2022) which found a meaningful and robust relationship between people's feelings of responsibility to reduce climate change, their worry about climate change, and their belief that climate change is caused by humans. Importantly, these findings were consistently observed across 31 different European countries, and when controlling for crucial socio-demographic variables."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The publisher discussion preview explicitly places both named originals inside the replicated-and-extended set and states agreement on the relationship. This is independent evidence of a retested target rather than mere topical background.""}"
10.1016/j.jsp.2024.101307,cf3cdf98cc2a333b,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The purpose of this research was to conduct a practice-based replication of Academic and Behavior Combined Support (ABC Support), a previously developed and experimentally evaluated supplemental intervention that merges a combined focus on reading fluency and academic engagement."", ""outcome"": ""successful"", ""outcome_quote"": ""In concert with prior empirical findings on ABC Support, analyses revealed improvement from baseline to intervention for both reading and behavior outcomes, as well as from baseline to follow-up assessments."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly compare the new improvements with prior ABC Support findings as being in concert. The abstract does not identify the original bibliographic entry.""}"
10.1080/19345747.2024.2333734,865e547d45f851f6,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The On Track program, previously found to be effective in a researcher-driven and tightly controlled setting, was implemented in a larger sample of schools. To investigate the robustness of the original findings, specific aspects of the implementation were deliberately altered from the original study."", ""outcome"": ""successful"", ""outcome_quote"": ""Results indicated that the intervention significantly reduced the number of at-risk students by the end of first grade. However, effect sizes in the replication study were reduced compared to the original try-out."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract states original program effective and corresponding beneficial intervention result, explicitly compares reduced sizes; reduced magnitude alone is not mixed. Reference citation is not in the abstract.""}"
10.1080/09658211.2011.590505,67caf928cf788ab5,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Two prospective studies have investigated whether the presence, intrusion, and avoidance of negative intrusive memories predict depression, and have reported conflicting findings. We aimed to replicate and extend these investigations by exploring the role of intrusion and avoidance of intrusive memories, as well as memory characteristics, in the prediction of depression prospectively."", ""outcome"": ""cannot_be_determined"", ""outcome_quote"": """", ""outcome_quote_section"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Abstract identifies two conflicting earlier investigations but does not identify either citation or state which original found which result. Hypothesis-level results cannot be mapped to either original.""}"
