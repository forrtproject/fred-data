10.51910/ijhdr.v11i40.598,d7591f8fdbd060c8,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Three series including five independent blinded and randomised experiments each were carried out in the same way as in the original study. Only time and conductor of experiments were modified."", ""outcome"": ""failed"", ""outcome_quote"": ""No specific effects of agitated dilutions of gibberellic acid were found in the first two replication series (p=0.263 and p=0.062). In the third serie with gibbous Lemna gibba L. we observed a significant effect (p=0.009) of the homeopathic treatment, however growth was increased in contrast to decreasing in the former study."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The first two series show no original effect and the third shows the opposite direction. The abstract identifies no bibliographic entry for the former study; no target citation is guessed.""}"
10.1111/acer.15532,a679446e24e8a56a,1,10.1007/s00213-018-4922-8,"Alcohol use disorder symptoms are associated with greater relative value ascribed to alcohol, but not greater discounting of costs imposed on alcohol.","Hogarth, L. & Hardy, L.",2018,full_text,,unverified,unresolved,{},"{""authors"": ""Hogarth, L. & Hardy, L."", ""year"": ""2018"", ""title"": ""Alcohol use disorder symptoms are associated with greater relative value ascribed to alcohol, but not greater discounting of costs imposed on alcohol."", ""doi"": ""10.1007/s00213-018-4922-8"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our behavioral findings partially replicate previous results, showing that choice preference for alcohol was affected by the relative value of the alternative reward (Hogarth & Hardy,  2018 ; Karlsson et al.,  2024 )."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our behavioral findings partially replicate previous results, showing that choice preference for alcohol was affected by the relative value of the alternative reward (Hogarth & Hardy,  2018 ; Karlsson et al.,  2024 )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly describe their behavioral findings as partially replicating the set of results from both cited papers. Relative-cost sensitivity replicated, while the relation between alcohol use severity and alcohol choice did not. The overall partial-replication verdict applies to both named originals.""}"
10.1037/ebs0000298,d3aed2ed281ad7c4,0,,,Arnocky et al.,2017,abstract,,unverified,unresolved,{},"{""authors"": ""Arnocky et al."", ""year"": ""2017"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study sought to directly replicate a previous investigation that demonstrated a positive association between altruism and indices of mating success (Arnocky et al., 2017)."", ""outcome"": ""failed"", ""outcome_quote"": ""Overall, the findings are inconsistent with those of the original study and provide evidence that altruism does not predict mating success in humans."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract states an overall verdict of inconsistency with the original study and no association across the tested mating-success measures.""}"
10.1080/713755986,fed9b2985183e3e8,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Using the naming task, no affective priming was found in the present studies irrespective of prime-set size and target-set size (Experiment 1), irrespective of stimulus-onset asynchrony (Experiment 2), and even when a nearly exact replication of previous work that demonstrated the effect was conducted (Experiment 3)."", ""outcome"": ""failed"", ""outcome_quote"": ""Using the naming task, no affective priming was found in the present studies irrespective of prime-set size and target-set size (Experiment 1), irrespective of stimulus-onset asynchrony (Experiment 2), and even when a nearly exact replication of previous work that demonstrated the effect was conducted (Experiment 3)."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true}"
10.3389/fnins.2017.00664,69c54c69a95cf6e3,1,10.1016/j.brs.2011.01.003,Neglect-like effects induced by tDCS modulation of posterior parietal cortices in healthy subjects,"Giglia G., Mattaliano P., Puma A., Rizzo S., Fierro B., Brighina F.",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Giglia G., Mattaliano P., Puma A., Rizzo S., Fierro B., Brighina F."", ""year"": ""2011"", ""title"": ""Neglect-like effects induced by tDCS modulation of posterior parietal cortices in healthy subjects"", ""doi"": ""10.1016/j.brs.2011.01.003"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In contrast to both Benwell et al. (\n2015\n) and Giglia et al. (\n2011\n) we did not succeed here in replicating the overall rightward shift of spatial attention bias with a bi-parietal left P5 anode/right P6 cathode montage. Although there was indeed a small\nmean\nrightward shift relative to the sham protocol in response to both stimulation intensities, and for both performance groups (Figure\n6\n), these shifts failed to reach significance. The Bayesian analysis of this overall rightward shift, comparing the two studies, indicates that the replication data is unfortunately insensitive to allow us to distinguish between the presence or absence of an effect (BF = 1.58), although eliciting an overall stimulation effect was not the main aim of this study."", ""outcome"": ""uninformative"", ""outcome_quote"": ""In contrast to both Benwell et al. (\n2015\n) and Giglia et al. (\n2011\n) we did not succeed here in replicating the overall rightward shift of spatial attention bias with a bi-parietal left P5 anode/right P6 cathode montage. Although there was indeed a small\nmean\nrightward shift relative to the sham protocol in response to both stimulation intensities, and for both performance groups (Figure\n6\n), these shifts failed to reach significance. The Bayesian analysis of this overall rightward shift, comparing the two studies, indicates that the replication data is unfortunately insensitive to allow us to distinguish between the presence or absence of an effect (BF = 1.58), although eliciting an overall stimulation effect was not the main aim of this study."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1016/j.infbeh.2019.101340,d7dd7a918f384d33,1,10.3389/fpsyg.2012.00370,Actions seen through babies’ eyes: A dissociation between looking time and predictive gaze.,"Daum, M. M., Attig, M., Gunawan, R., Prinz, W., & Gredebäck, G.",2012,full_text,,unverified,unresolved,{},"{""authors"": ""Daum, M. M., Attig, M., Gunawan, R., Prinz, W., & Gredebäck, G."", ""year"": ""2012"", ""title"": ""Actions seen through babies’ eyes: A dissociation between looking time and predictive gaze."", ""doi"": ""10.3389/fpsyg.2012.00370"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""In the path-paradigm, we expected 11-month-olds and 32-month-olds to anticipate the old path, thus the novel goal, as the action is performed by a non-human agent (Daum et al., 2012)."", ""outcome"": ""successful"", ""outcome_quote"": ""Considering the path-paradigm with the animated agent, 11-month-olds looked longer towards the familiarized path leading to the novel goal. Hence results are similar to Study 1 and Daum et al. (2012)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""New samples re-test the path-versus-goal result in animated-agent tasks. The paper explicitly describes agreement with Daum for infant and toddler path anticipations; adults also anticipate the goal in the animated path paradigm.""}"
10.1016/j.infbeh.2019.101340,d7dd7a918f384d33,2,10.1016/j.yhbeh.2017.03.006,Oxytocin promotes attention to social cues regardless of group membership.,"Pfundmair, M., Zwarg, C., Paulus, M., & Rimpel, A.",2017,full_text,,unverified,unresolved,{},"{""authors"": ""Pfundmair, M., Zwarg, C., Paulus, M., & Rimpel, A."", ""year"": ""2017"", ""title"": ""Oxytocin promotes attention to social cues regardless of group membership."", ""doi"": ""10.1016/j.yhbeh.2017.03.006"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""We hypothesized to find anticipations towards the familiarized goal within the adult sample in both paradigms (Daum et al., 2012; Pfundmair et al., 2017)."", ""outcome"": ""failed"", ""outcome_quote"": ""Pfundmair et al. (2017) found that adults anticipated the goal of a grasping hand as well as of a grasping claw, which is in contrast to our findings."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Study 2 explicitly predicts adult goal anticipations from this prior finding and contrasts its observed adult hand-path anticipation with that result. The original oxytocin effect itself is not re-tested; target is the adult action-goal anticipation finding.""}"
10.1177/1948550616652209,d715987328d983ae,1,,Look me in the eye: Manipulated eye gaze affects dominance mindsets,"Tang, D., & Schmeichel, B. J.",2015,full_text,,unverified,unresolved,{},"{""authors"": ""Tang, D., & Schmeichel, B. J."", ""year"": ""2015"", ""title"": ""Look me in the eye: Manipulated eye gaze affects dominance mindsets"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We expected to replicate Carney et al.’s (2010) results when\nparticipants looked directly ahead, such that high-power (vs.\nlow power) posers report feeling more powerful and take the\ngambling risk more often; we also expected these participants\nto demonstrate dominance in the ultimatum game (consistent\nwith Tang & Schmeichel, 2015)."", ""outcome"": ""mixed"", ""outcome_quote"": ""In sum, holding a direct gaze increased the likelihood of\nrejecting a low offer on the hypothetical ultimatum game,\nwhich is consistent with the results of Tang and Schmeichel\n(2015). However, we did not find any effects of the pose or\ngaze manipulations on the amount of money participants\noffered to the opponent or the minimum amount of money par\u0002ticipants were willing to accept from the opponent."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true}"
10.1080/23743603.2016.1248081,0e4a00331066c9e6,1,10.1016/j.obhdp.2011.11.009,Power and overconﬁdent decision-making.,"Fast, N. J., Sivanathan, N., Mayer, N. D., & Galinsky, A. D.",2012,full_text,,unverified,unresolved,{},"{""authors"": ""Fast, N. J., Sivanathan, N., Mayer, N. D., & Galinsky, A. D."", ""year"": ""2012"", ""title"": ""Power and overconﬁdent decision-making."", ""doi"": ""10.1016/j.obhdp.2011.11.009"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Building from these ﬁndings, Fast and colleagues (2012)\nreported ﬁve experiments that used multiple instantiations of power – including manip-\nulations via episodic recall tasks, role assignment, and extant work related power –\nwhere they found high power to be associated with overconﬁdent decision-making.\nBased on these ﬁndings, we propose that exaggerated expressions of conﬁdence will\nemerge as a function of the degree to which high-power poses facilitate a high-power\nmind-set."", ""outcome"": ""failed"", ""outcome_quote"": ""High-power (M = 0.14, SD = 0.53) posers did not have higher post-manipulation levels of\noverconﬁdence than low-power posers (M = −0.01, SD = 0.51), F(1,104) = 0.26, p = 0.61,\nd = 0.099, r = 0.05."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The extension directly tests the published power-to-overconfidence relationship using embodied power. The introduction states the original positive finding and derives this study’s prediction from it; the new-sample comparison fails to show it. This is a conceptual retest, even though called an extension.""}"
10.1080/23743603.2016.1248081,0e4a00331066c9e6,2,10.1016/j.psyneuen.2015.02.023,Testosterone and cortisol jointly modulate risk-taking.,"Mehta, P. H., Welker, K. M., Zilioli, S., & Carré, J. M.",2015,full_text,,unverified,unresolved,{},"{""authors"": ""Mehta, P. H., Welker, K. M., Zilioli, S., & Carré, J. M."", ""year"": ""2015"", ""title"": ""Testosterone and cortisol jointly modulate risk-taking."", ""doi"": ""10.1016/j.psyneuen.2015.02.023"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Because Carney et al.\n(2010) found high-power poses to both increase testosterone and decrease cortisol, the\ninteraction between these eﬀects may predict risk-taking, as has been previously shown\n(Mehta et al., 2015). Furthermore, although Ranehill et al. (2015) failed to replicate\nCarney et al.’s (2010) eﬀects of power posing on hormonal changes, other manipulations\nrelated to power, such as winning a competition, have been shown to jointly impact\ntestosterone and cortisol (e.g. see Hamilton, Carré, Mehta, Olmstead, & Whitaker, 2015).\nThus, in the present research, we measured both testosterone and cortisol at two time\npoints, as per Carney et al.’s (2010) original design and tested for both main and\ninteractive eﬀects."", ""outcome"": ""failed"", ""outcome_quote"": ""The interaction\nbetween post-manipulation testosterone and cortisol was also unrelated to gambling\ndecisions, z = 0.02, p = 0.90, φ = 0.037."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper explicitly invokes the previously shown testosterone-by-cortisol prediction of risk-taking, then measures both hormones to test their interactive effects in its own sample. The corresponding interaction is unrelated to gambling decisions, contrary to that published prediction.""}"
10.1177/23982128241255798,b035fe7f6b702c00,1,10.1523/JNEUROSCI.0349-18.2018,Single-trial phase entrainment of theta oscillations in sensory regions predicts human associative memory performance,"Wang, D.; Clouter, A.; Chen, Q.; et al.",2018,full_text,,unverified,unresolved,{},"{""authors"": ""Wang, D.; Clouter, A.; Chen, Q.; et al."", ""year"": ""2018"", ""title"": ""Single-trial phase entrainment of theta oscillations in sensory regions predicts human associative memory performance"", ""doi"": ""10.1523/JNEUROSCI.0349-18.2018"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Despite the theoretical and practical importance of TIME, there has not yet been a replication of the combined behavioural results of Clouter et al. (2017) and Wang et al. (2018) outside the original research group. Of particular importance for interpretation of memory enhancement effects is a replication in which all relevant control conditions (asynchronous theta, no-flicker, and synchronous non-theta) are combined in a single experiment. This is the aim of the present experiment."", ""outcome"": ""failed"", ""outcome_quote"": ""Together with the lack of evidence for any advantage of synchronous theta against asynchronous theta or synchronous delta, we conclude that we have failed to replicate the TIME reported by Clouter et al. (2017) and Wang et al. (2018) ."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""An explicit overall non-replication verdict names both targets. Incidental synchrony-discrimination confirmation is outside the central memory effect.""}"
10.1177/1948550616646426,6b77954dd4b14dae,1,,Deflecting the trajectory and changing the narrative: How self-affirmation affects academic performance and motivation under identity threat.,"Sherman, D. K., Hartson, K. A., Binning, K. R., Purdie-Vaughns, V., Garcia, J., Taborsky-Barba, S., . . . Cohen, G. L.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Sherman, D. K., Hartson, K. A., Binning, K. R., Purdie-Vaughns, V., Garcia, J., Taborsky-Barba, S., . . . Cohen, G. L."", ""year"": ""2013"", ""title"": ""Deflecting the trajectory and changing the narrative: How self-affirmation affects academic performance and motivation under identity threat."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We also explored whether affirmations worked best for the lowest performing students, as has been found in prior research (Sherman et al., 2013)."", ""outcome"": ""failed"", ""outcome_quote"": ""We also explored whether affirmations worked best for the lowest performing students, as has been found in prior research (Sherman et al., 2013). To pursue this possibility, we included the students’ previous term GPA as a covariate and interaction term with experimental condition and ethnic stereotype status. This controls for prior differences in achievement and allows an even more powerful test of the effect. In this model, previous term GPA significantly predicted later term GPA (b ¼ .952, 95% confidence interval [CI] [0.879, 1.024]), no other main effect or interaction approached significance (all ps > .266)."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""The reported test does not support the corresponding original finding.""}"
10.51224/cik.v1i2.39,be770b85c49bd7e8,1,10.1016/j.humov.2016.08.009,Expecting to teach enhances motor learning and information processing during practice,"Daou, M., Lohse, K. R., & Miller, M. W.",2016,full_text,,unverified,unresolved,{},"{""authors"": ""Daou, M., Lohse, K. R., & Miller, M. W."", ""year"": ""2016"", ""title"": ""Expecting to teach enhances motor learning and information processing during practice"", ""doi"": ""10.1016/j.humov.2016.08.009"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The primary purpose of this research was to replicate the findings of Daou and colleagues (Daou, Lohse, et al., 2016; Daou, Buchanan, et al., 2016)"", ""outcome"": ""failed"", ""outcome_quote"": ""The present study fails to replicate the benefits reported in the original experiments."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall failure verdict applies to the two named original experiments. Motivation/practice checks and uncertain declarative knowledge estimates do not override this overall verdict.""}"
10.1002/ajhb.22875,74db913f182acbb1,0,,,Dressler et al.,2009,abstract,,unverified,unresolved,{},"{""authors"": ""Dressler et al."", ""year"": ""2009"", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To replicate a previously identified gene‐environment interaction between a genetic polymorphism in the serotonin 2A receptor and cultural consonance in family life in relation to depressive symptoms (Dressler et al., 2009)."", ""outcome"": ""failed"", ""outcome_quote"": ""The previously identified gene‐environment interaction was not replicated."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall verdict that the targeted gene-environment interaction was not replicated. Main-effect findings do not change the verdict on the focal interaction.""}"
10.1177/1948550616639649,7009c476dabe7640,1,,"The retrospective gambler’s fallacy: Unlikely events, constructing the past, and multiple universes.","Oppenheimer, D. M., & Monin, B.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Oppenheimer, D. M., & Monin, B."", ""year"": ""2009"", ""title"": ""The retrospective gambler’s fallacy: Unlikely events, constructing the past, and multiple universes."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""1a, 1b, 2"", ""evidence_quote"": ""To help indicate the overall quality of our replication attempt, we included as a positive control an additional experiment with a well-defined effect size. Specifically, we used the retrospective gambler’s task (Oppenheimer & Monin, 2009)."", ""outcome"": ""successful"", ""outcome_quote"": ""To allay such concerns, we used a positive control, the retrospective gambler’s fallacy (Oppenheimer & Monin, 2009). In all cases, we observed the expected pattern of results."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The positive-control experiment re-tests the specifically attributed published finding in new samples, and the authors state that its expected pattern occurred in all cases. Klein et al. supplied materials and prior evidence; the paper names Oppenheimer and Monin as the finding tested.""}"
10.3390/jintelligence7010006,cfc2ba332d77bd60,1,,Psychological Examining in the United States Army.,Yerkes R.M.,1921,full_text,,unverified,unresolved,{},"{""authors"": ""Yerkes R.M."", ""year"": ""1921"", ""title"": ""Psychological Examining in the United States Army."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To further test the viability of the one-factor model, we performed confirmatory factor analysis on two correlation matrices of Army Beta data for World War I draftees ([15], pp. 390, 634)."", ""outcome"": """", ""outcome_quote"": """", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_computation"": ""not checked"", ""outcome_computational_quote"": ""To further test the viability of the one-factor model, we performed confirmatory factor analysis on two correlation matrices of Army Beta data for World War I draftees ([15], pp. 390, 634)."", ""outcome_robustness"": ""robust"", ""outcome_robustness_quote"": ""Thus, even in two samples of World War I draftees—groups that would be much more likely to have a separate factor for recognition of written numbers than a modern sample of college students—a one-factor model fit the data just as well as a two-factor model. Again, parsimony dictates that researchers should favor a one-factor model of intelligence from the historic Army Beta data."", ""outcome_reasoning"": ""A secondary reproduction reanalyses two original correlation matrices using alternative factor models to test the substantive validity finding. Recovering original reported coefficients was outside this analysis; the original general-ability interpretation survives the tested alternative. Both matrices belong to one original volume.""}"
10.2307/146341,b7595c5566c460f7,0,,,Holzer,,abstract,,unverified,unresolved,{},"{""authors"": ""Holzer"", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Examining self-reported reservation wages from the 1979-80 waves of the National Longitudinal Survey of Youth (NLSY), Holzer concludes that 26 to 42 percent of the race difference in the length of jobless spells is due to the higher wages sought by young Black men. This replication uses NLSY reservation wage data from 1979 through 1986."", ""outcome"": ""failed"", ""outcome_quote"": ""Thus, evidence from the NLSY does not support the claim that reservation wage differences explain the race employment gap."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true}"
10.1002/bem.10105,54ae4433391a94ab,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our study was a replication and extension with methodological improvements to a previous study on effects of the electromagnetic field (EMF) emitted by a 902 MHz mobile phone on human cognitive functioning."", ""outcome"": ""failed"", ""outcome_quote"": ""Although the RTs and the accuracy of answers were very similar to those of our previous study, our previous results were not replicated."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit overall failure verdict. The abstract does not identify the previous study bibliographically; no guess is made among related prior works.""}"
10.1038/sj.ejhg.5201317,46d9e2d0b98ee6de,1,,Genome-wide linkage analysis and evidence of gene-by-gene interactions in a sample of 362 multiplex Parkinson disease families.,"Pankratz N, Nichols WC, Uniacke SK et al",2003,full_text,competing_supported_matches; same_author_year_siblings,unverified,unresolved,{},"{""authors"": ""Pankratz N, Nichols WC, Uniacke SK et al"", ""year"": ""2003"", ""title"": ""Genome-wide linkage analysis and evidence of gene-by-gene interactions in a sample of 362 multiplex Parkinson disease families."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The studies by Pankratz et al showed a significant linkage of\n  In the 15 families, that included at least one affected               PD to 2q36 – 37 in a North American population. The\nindividual with an age of onset p50 years, a marker in                  sample of Pankratz et al17,19 was primarily Caucasian\nintron 7 of the parkin gene (D6S305) was genotyped in                   (94%), although Hispanics (5%) also participated. Interest-\norder to identify families more likely to have a mutation               ingly, the Hispanic families in the sample provided a\nin this known PD-susceptibility gene. Linkage analysis was              substantial portion of the linkage evidence.19 We could not\nrepeated excluding those families showing possible linkage              find a significant linkage to this region in our European\nto D6S305.                                                              families."", ""outcome"": ""failed"", ""outcome_quote"": ""Recently, significant linkage has been\nreported to a 39.5 cM region on the long arm of chromosome 2 (2q36-37; PARK11) in North American\nParkinson families under an autosomal dominant model of inheritance. We have performed a replication\nstudy to confirm linkage to this region in a European population. Linkage analysis in 153 individuals from\n45 European families with a strong family history of PD did not show any significant LOD score in this\nregion. Therefore, PARK11 does not seem to play a major role for familial PD in the European population.\n"", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The European-family replication did not confirm significant PARK11 linkage reported in the Pankratz studies.""}"
10.1111/j.1742-9536.2011.00001.x,6fdb3d74d29e1b1b,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": ""1"", ""evidence_quote"": ""We first attempted to replicate previous findings by comparing VGPs and NVGPs on a flanker compatibility task (Experiment 1)."", ""outcome"": ""failed"", ""outcome_quote"": ""In contrast with previous studies, VGPs did not demonstrate greater intrusion from distractors, calling into question the reliability of previous findings."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract explicitly contrasts the intended finding with its absence. Original citation identity is unavailable in the saved abstract.""}"
10.1128/jvi.00693-11,c8ced3fa8a29c729,1,,"Detection of an infectious retrovirus, XMRV, in blood cells of patients with chronic fatigue syndrome.","Lombardi V. C., et al.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Lombardi V. C., et al."", ""year"": ""2009"", ""title"": ""Detection of an infectious retrovirus, XMRV, in blood cells of patients with chronic fatigue syndrome."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Furthermore, we also analyzed the WPI samples using tests from the two studies that found XMRV or XMRV-like viruses in CFS patients, viz. a PCR assay for gag sequences, both in single-round ( 12 ) and nested formats ( 11 ), and a test for viral growth in cultured cells ( 12 ). Neither of these tests revealed any evidence of XMRV."", ""outcome"": ""failed"", ""outcome_quote"": ""Our findings do not support an association between CFS and MLV-related viruses, including XMRV, and the off-label use of antiretrovirals for the treatment of CFS does not seem justified at present."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""Overall verdict rejects the association reported by both positive original studies; new samples and repeated assays find no specific viral association. Initial positives attributed to contamination are not a successful replication verdict.""}"
10.2522/ptj.20120444,db4af6ad7a4749b7,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The purposes of the study were to replicate some aspects of the original study of the OPTIMAL Difficulty and Confidence scales and to conduct additional psychometric tests."", ""outcome"": ""failed"", ""outcome_quote"": ""The findings generally did not support the psychometric properties of the OPTIMAL instrument."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract states an overall negative verdict on the psychometric properties being re-tested. Citation fields unavailable in abstract; no target metadata imported from external sources.""}"
10.1371/journal.pone.0096654,a1595e3436c3f948,1,,Social heuristics shape intuitive cooperation.,"Rand DG, Peysakhovich A, Kraft-Todd GT, Newman GE, Wurzbacher O, et al.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Rand DG, Peysakhovich A, Kraft-Todd GT, Newman GE, Wurzbacher O, et al."", ""year"": ""2014"", ""title"": ""Social heuristics shape intuitive cooperation."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""3"", ""evidence_quote"": ""Considering that Mechanical Turk workers from the United States are experienced, and that the intuitive-cooperation effect interacts with experience, it might be possible that Rand and colleagues\n[8]\nrecent failures to find an intuitive-cooperation effect in Mechanical Turk experiments as well as our failures to find such an effect in Experiment 1 and in Experiments 2a, 2b and 2c are due to the Mechanical Turk population becoming increasingly experienced in playing public good games. In order to test this experience hypothesis of our replication failures, we conducted a third experiment."", ""outcome"": ""failed"", ""outcome_quote"": ""In Experiment 3, we again failed to demonstrate an intuitive-cooperation effect. This replication failure contradicts the experience hypothesis because it was obtained using naïve participants only."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly report failure of the intuitive-cooperation effect.""}"
10.1097/brs.0000000000000807,1bd88ffc8036c3a7,0,,,,,abstract,,unverified,unresolved,"{""corrected_value"": null, ""field"": ""missing_row"", ""file_key"": ""1bd88ffc8036c3a7"", ""location"": ""Abstract (line 4)"", ""method"": ""argon"", ""quote"": ""In Brief Study Design. A replication association study that used genomic data generated from French-Canadian case and control cohorts. Objectives. To determine whether the 53 single nucleotide polymorphisms (SNPs) that were previously associated with spinal deformity progression in an American Caucasian cohort are similarly associated in French-Canadian population."", ""reason"": ""No prior adjudication or state file exists for this work. The available primary source is an abstract only and states that 52 of 53 single nucleotide polymorphisms from the ScoliScore test previously associated with spinal deformity progression in an American Caucasian cohort were retested in a French-Canadian cohort with no association found. However, the abstract contains no in-text citations or reference list to identify the specific originating report for the American Caucasian ScoliScore cohort. Shipped row 1129 (Ward et al., 2010, 'Validation of DNA-Based Prognostic Testing to Predict Spinal Curve Progression in Adolescent Idiopathic Scoliosis', DOI 10.1097/brs.0b013e3181ed2de1) is a plausible candidate for that original study, but the abstract alone cannot resolve whether row 1129 is the exact cited target work or whether a different discovery report is cited in the full article."", ""request_id"": ""luna_0008_1bd88ffc8036c3a7"", ""target_index"": 0, ""verdict"": ""undeterminable""}","{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To determine whether the 53 single nucleotide polymorphisms (SNPs) that were previously associated with spinal deformity progression in an American Caucasian cohort are similarly associated in French-Canadian population."", ""outcome"": ""failed"", ""outcome_quote"": ""Although the 52 SNPs studied here were previously associated with curve progression in an American population of European descent, we found no association in French-Canadian patients with adolescent idiopathic scoliosis."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The conclusion explicitly contrasts the prior associations with their absence in this sample.""}"
10.18632/oncotarget.9819,1e8323e953d1828e,1,10.1038/tp.2014.2,Follow-up of loci from the International Genomics of Alzheimer's Disease Project identifies TRIP4 as a novel susceptibility gene.,"Ruiz A, Heilmann S, Becker T, Hernandez I, Wagner H, Thelen M, Mauleon A, Rosende-Roca M, Bellenguez C, Bis JC, Harold D, Gerrish A, Sims R, et al.",2014,full_text,,unverified,unresolved,"{""file_key"": ""1e8323e953d1828e"", ""field"": ""missing_row"", ""target_index"": 1, ""method"": ""obvious"", ""verdict"": ""undeterminable"", ""corrected_value"": null, ""quote"": ""In addition, Ruiz et al. [ 15 ] also detected that rs190982 could decrease the risk of AD through multiple test in a large Spanish sample (OR = 0.885, 95%CI = 0.81 1-0.966). Several factors may be responsible for these discrepancies in these researches."", ""location"": ""Discussion, original-specific Ruiz2014comparison and discrepancies"", ""reason"": ""Primary Discussion specifically contrasts the current Chinese association results with Ruiz2014Spanishprotective-association result and discusses discrepancies; it is stronger than background-only citation or meta-analysis membership. However, Ruiz and shippedLambert2013report the same rs190982protective finding in a follow-up chain, and current study selects LambertGWASas discovery target. The closest-actual-finding rule versus separate independent follow-up paper cannot be settled by different authors/DOI or pooled meta-analysis alone. Initial categorical exclusion omits contrary own-result comparison; no third unchanged model attempt. Preserve an actual additional-target/chain ambiguity and do not falsely certify a genuinely absent pair or background exclusion.""}","{""authors"": ""Ruiz A, Heilmann S, Becker T, Hernandez I, Wagner H, Thelen M, Mauleon A, Rosende-Roca M, Bellenguez C, Bis JC, Harold D, Gerrish A, Sims R, et al."", ""year"": ""2014"", ""title"": ""Follow-up of loci from the International Genomics of Alzheimer's Disease Project identifies TRIP4 as a novel susceptibility gene."", ""doi"": ""10.1038/tp.2014.2"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Recently, a large meta-analysis has confirmed that the SNP rs190982 polymorphism within MEF2C on chromosome 5 acted as a protective factor for AD dementia (OR = 0.93, 95%CI = 0.90-0.95, P = 3.2×10 −8 ) in the Caucasian population [ 14 ]. Similarly, the association between the MEF2C gene rs190982 polymorphism and AD was also confirmed in a large Spanish sample (OR = 0.885, 95%CI = 0.811-0.966) [ 15 ]. Furthermore, another two studies replicated the association in China Han. Regretfully, they failed to reveal any association of rs190982 polymorphism in MEF2C gene with AD susceptibility in our Han Chinese cohort [ 16 , 17 ]. Here, we conducted a case-control study containing 2332 individuals to clarify whether the selected SNP on MEF2C gene has an association with LOAD in Northern Han Chinese population."", ""outcome"": ""failed"", ""outcome_quote"": ""In contrast to our results, Lambert et al. [ 14 ] identified rs190982 as a protective factor to the development of LOAD in Caucasian patients in a large-scale GWAS (OR = 0.93, 95%CI = 0.90-0.95). In addition, Ruiz et al. [ 15 ] also detected that rs190982 could decrease the risk of AD through multiple test in a large Spanish sample (OR = 0.885, 95%CI = 0.81 1-0.966)."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Authors explicitly contrast the new sample null association with this published protective association. Meta-analytic pooling does not change the result of their own replication.""}"
10.1080/02699931.2017.1292217,80e47e28ccb76b2f,1,,The beneficial effect of concurrent task-irrelevant mental activity on temporal attention,"Olivers, C. N. L., & Nieuwenhuis, S.",2005,full_text,,unverified,unresolved,{},"{""authors"": ""Olivers, C. N. L., & Nieuwenhuis, S."", ""year"": ""2005"", ""title"": ""The beneficial effect of concurrent task-irrelevant mental activity on temporal attention"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Furthermore, in light of Olivers and Nieuwenhuis’ (2005, 2006) overinvestment hypothesis I expected that any type of distraction diminishes the AB effect, as it would diminish the over focusing of attentional resources on T1 processing."", ""outcome"": ""failed"", ""outcome_quote"": ""However, I found no effects of distraction, nor did I find any effects of mood, nor an interaction between distraction and mood. When I made a comparison between AB effects of the participants who received a mood induction and participants who did not, no significant effects were obtained."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The fourth stated aim tests the previously reported reduction in attentional blink with distraction. No distraction effect was found. Included as a conceptual retest of the finding rather than merely theoretical background.""}"
10.1080/02699931.2017.1292217,80e47e28ccb76b2f,2,,"The beneficial effects of additional task load, positive affect, and instruction of the attentional blink","Olivers, C. N. L., & Nieuwenhuis, S.",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Olivers, C. N. L., & Nieuwenhuis, S."", ""year"": ""2006"", ""title"": ""The beneficial effects of additional task load, positive affect, and instruction of the attentional blink"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Furthermore, in light of Olivers and Nieuwenhuis’ (2005, 2006) overinvestment hypothesis I expected that any type of distraction diminishes the AB effect, as it would diminish the over focusing of attentional resources on T1 processing."", ""outcome"": ""failed"", ""outcome_quote"": ""However, I found no effects of distraction, nor did I find any effects of mood, nor an interaction between distraction and mood. When I made a comparison between AB effects of the participants who received a mood induction and participants who did not, no significant effects were obtained."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The fourth stated aim tests the previously reported reduction in attentional blink with distraction. No distraction effect was found. Included as a conceptual retest of the finding rather than merely theoretical background.""}"
10.1186/s13018-018-0769-2,f7079a3b8eb85bc0,1,10.1136/annrheumdis-2013-203772,The effect of FTO variation on increased osteoarthritis risk is mediated through body mass index: a mendelian randomisation study,"Panoutsopoulou K, Metrustry S, Doherty SA, Laslett LL, Maciewicz RA, Hart DJ, et al.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Panoutsopoulou K, Metrustry S, Doherty SA, Laslett LL, Maciewicz RA, Hart DJ, et al."", ""year"": ""2014"", ""title"": ""The effect of FTO variation on increased osteoarthritis risk is mediated through body mass index: a mendelian randomisation study"", ""doi"": ""10.1136/annrheumdis-2013-203772"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""An extended study of the GWAS study revealed that the association between rs8044769 and OA was degenerated after stratification by BMI, and the association between rs8044769 and BMI was identified in this study [14]."", ""outcome"": ""failed"", ""outcome_quote"": ""An extended study of the GWAS study revealed that the association between rs8044769 and OA was degenerated after stratification by BMI, and the association between rs8044769 and BMI was identified in this study [14]. There have been several reports for the association between FTO and BMI [6–12], and two of them referred to rs8044769 as BMI associated SNP [11, 12]. So, we suspected that the association between rs8044769 and BMI may contribute to the association between this SNP and OA in the GWAS study. However, in our study, rs8044769 was not associated with BMI, and it might be another reason for the negative association between rs8044769 and OA."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The extended GWAS paper is explicitly compared on the SNP–BMI association; the current study fails to find that association.""}"
10.1186/s13018-018-0769-2,f7079a3b8eb85bc0,2,10.1038/oby.2009.159,The role of obesity-associated loci identified in genome-wide association studies in the determination of pediatric BMI,"Zhao J, Bradfield JP, Li M, Wang K, Zhang H, Kim CE, et al.",2009,full_text,,unverified,unresolved,{},"{""authors"": ""Zhao J, Bradfield JP, Li M, Wang K, Zhang H, Kim CE, et al."", ""year"": ""2009"", ""title"": ""The role of obesity-associated loci identified in genome-wide association studies in the determination of pediatric BMI"", ""doi"": ""10.1038/oby.2009.159"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The association of the FTO polymorphism (rs8044769) with BMI was not replicated in the Chinese Han population either. The previous studies showed that FTO was associated with BMI [6–12], and two of them referred to rs8044769 as BMI-associated SNP [11, 12]. In the association analysis of rs8044769 with BMI, we found no association between rs8044769 and BMI."", ""outcome"": ""failed"", ""outcome_quote"": ""The association of the FTO polymorphism (rs8044769) with BMI was not replicated in the Chinese Han population either. The previous studies showed that FTO was associated with BMI [6–12], and two of them referred to rs8044769 as BMI-associated SNP [11, 12]. In the association analysis of rs8044769 with BMI, we found no association between rs8044769 and BMI."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly identify references 11 and 12 as reports of the exact rs8044769–BMI association and state that this association was not replicated. Other FTO variants in references 6–10 are background.""}"
