10.3389/fnhum.2014.00460,86e42c99f7cbb579,1,10.1016/j.neuron.2013.05.002,Abnormal visual motion processing is not a cause of dyslexia.,"Olulade O. A., Napoliello E. M., Eden G. F.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Olulade O. A., Napoliello E. M., Eden G. F."", ""year"": ""2013"", ""title"": ""Abnormal visual motion processing is not a cause of dyslexia."", ""doi"": ""10.1016/j.neuron.2013.05.002"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": ""2"", ""evidence_quote"": ""This is the first study to show that the M-D deficit in children with DD is present also when compared with younger children with the same reading performance, challenging the idea that the M-D deficit is a simple effect of reading deprivation and not a cause, as recently suggested by Olulade et al. (2013) ."", ""outcome"": ""failed"", ""outcome_quote"": ""This is the first study to show that the M-D deficit in children with DD is present also when compared with younger children with the same reading performance, challenging the idea that the M-D deficit is a simple effect of reading deprivation and not a cause, as recently suggested by Olulade et al. (2013) ."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """"}"
10.1353/jhe.2015.0006,6b768bc6727abad5,0,,,,2004,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": ""2004"", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This study replicates and extends a 2004 content analysis of three major higher education journals."", ""outcome"": ""successful"", ""outcome_quote"": ""Our findings reveal a field that continues to be dominated by quantitative methods and which is increasingly using more advanced statistical techniques."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Abstract states the original found heavily quantitative and statistically sophisticated content, and the new sample continues quantitative dominance with increasingly advanced methods. This is an implicit agreeing comparison. Original bibliographic entry is absent from the abstract.""}"
10.1177/0734282915580885,cf5667fa368c5800,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The present study reports on a replication of the technical adequacy of the Student Subjective Wellbeing Questionnaire (SSWQ), which is a 16-item self-report instrument for assessing youth’s academic efficacy, educational purpose, joy of learning, and school connectedness, with a sample of adolescents in Grades 6 to 7 ( N = 438)."", ""outcome"": ""successful"", ""outcome_quote"": ""Overall, this study provides a strong, positive replication of the technical adequacy of the SSWQ, suggesting that it is a psychometrically sound measure for school psychological research and, potentially, practice."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract gives an explicit overall positive replication verdict. Its unnamed original SSWQ validation is not bibliographically identifiable from the abstract alone, which does not reduce confidence in the stated outcome.""}"
10.1371/journal.pone.0121564,af4a8c309c18e227,1,,Attention please: No affective priming effects in a valent/neutral-categorisation task.,"Werner B, Rothermund K",2013,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Werner B, Rothermund K"", ""year"": ""2013"", ""title"": ""Attention please: No affective priming effects in a valent/neutral-categorisation task."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We therefore decided to run a new experiment in which the essential ingredients of the experiments run by Werner and Rothermund [\n7\n] were combined with the typical priming parameters used by Spruyt and colleagues."", ""outcome"": ""failed"", ""outcome_quote"": ""Still, the mere fact that we did obtain this effect under strict automaticity conditions is logically sufficient to reject the general assertion that the evaluative priming effect fails to replicate in the valent/non-valent categorization task [\n7\n,\n22\n]."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper directly adjudicates the conflicting published results using a new sample and combined procedural elements.""}"
10.1080/1357650x.2015.1016530,5f5efa4665888309,1,10.3389/fpsyg.2014.00134,Differences between left- and right-handers in approach/avoidance motivation: influence of consistency of handedness measures.,"Hardie, S. M. & Wright, L.",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Hardie, S. M. & Wright, L."", ""year"": ""2014"", ""title"": ""Differences between left- and right-handers in approach/avoidance motivation: influence of consistency of handedness measures."", ""doi"": ""10.3389/fpsyg.2014.00134"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our results replicate those of Wright et al. (2009) and Hardie and Wright (2014) that left-handers have higher BIS scores than right-handers while, as expected, there is no handedness difference for any BAS sub-scale."", ""outcome"": ""mixed"", ""outcome_quote"": ""Hardie and Wright (2014), using the type of classification scheme advocated by Prichard et al. (2013) and a number of different cut-off values to define consistent versus inconsistent handedness, found small but statistically significant effects of consistency or strength of handedness for their sample (N=689) as a whole (consistently handed individuals had higher BIS scores than those of inconsistent handedness). However, when they looked separately at right-handers and left- handers an effect was apparent among the 202 left-handers but not among 481 right-handers. Our own failure to find an effect of strength of handedness may, therefore, be a consequence of the relatively low number of left-handers (36) in our sample."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true, ""outcome_reasoning"": ""Direction finding confirmed; strength finding differs for Hardie and Wright. Wright et al. has an explicit overall replication verdict."", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """"}"
10.1017/sjp.2016.1,fefb1a617468c079,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""This is a replication study of ASR and the first study of P50 suppression in Russian patients with schizophrenia (n = 28) and healthy controls (n = 25)."", ""outcome"": ""cannot_be_determined"", ""outcome_quote"": """", ""outcome_quote_section"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""The abstract identifies a replication but does not name the specific original or state its finding. Current significant results and biomarker utility do not settle agreement with an identifiable target.""}"
10.7717/peerj.5347,15ecfb7ca6e72471,2,10.1007/BF00391130,"Synergistic effects of temperature, salinity and light on the hermatypic coral Montipora verrucosa","Coles SL, Jokiel PL",1978,full_text,,unverified,unresolved,"{""file_key"": ""15ecfb7ca6e72471"", ""field"": ""missing_row"", ""target_index"": 2, ""method"": ""obvious"", ""verdict"": ""undeterminable"", ""corrected_value"": null, ""quote"": ""In our 2017 experiment, we examined the interaction between irradiance and temperature (ambient temperature, +2.8 °C above ambient), with full natural light intensity and shading (50%) for both temperature treatments."", ""location"": ""Independent parent primary context and original-report chain, integration/original_report_chain_0000.result.json"", ""reason"": ""The current2017 experiment explicitly crosses temperature and irradiance, and the1978 primary abstract reports high-light aggravation at high temperature. Absence of salinity manipulation cannot exclude conceptual retesting. Full1978and1977reports are unavailable after documented routes, so cannot independently determine whether this specific finding is an additional original beyond shipped1977or an equivalent report of the same experiment/finding. Retain as unresolved essential-reference candidate; do not adopt initial categorical background exclusion.""}","{""authors"": ""Coles SL, Jokiel PL"", ""year"": ""1978"", ""title"": ""Synergistic effects of temperature, salinity and light on the hermatypic coral Montipora verrucosa"", ""doi"": ""10.1007/BF00391130"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""To replicate the original thermal tolerance experiments conducted in 1970 ( Coles, Jokiel & Lewis, 1976 ; Jokiel & Coles, 1977 ; Coles & Jokiel, 1978 ), three species of corals, Montipora capitata (previously M. verrucosa ), Pocillopora damicornis, and Lobactis scutaria (previously Fungia scutaria ) , ( Gittenberger, Reijnen & Hoeksema, 2011 ) were collected from the Moku o Lo‘e reef in Kāne‘ohe Bay, O‘ahu, near the original 1970 experiment collection site (21.4°N, 157.8°W)."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our results show significant differences in coral bleaching, calcification, survivorship, and mortality since 1970 in three species of corals ( L. scutaria , M. capitata, P. damicornis ). These corals show higher calcification rates at a similar temperature increase in 2017 as compared to 1970. Calcification rates remained impaired under elevated temperatures across species; however, the reductions in 2017 were not as severe as those documented in 1970."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": false, ""outcome_reasoning"": ""Replicated thermal-tolerance experiments show continued impairment but explicit differences in bleaching thresholds, mortality and calcification. The combined experimental comparison is attributed to these three papers; paper-specific attribution of each endpoint is limited.""}"
10.7717/peerj.5347,15ecfb7ca6e72471,3,,Effects of thermal loading on Hawaiian reef corals,"Jokiel PL, Coles SL, Guinther EB, Key GS, Smith SV, Townsley SJ",1975,full_text,,unverified,unresolved,"{""file_key"": ""15ecfb7ca6e72471"", ""field"": ""missing_row"", ""target_index"": 3, ""method"": ""obvious"", ""verdict"": ""undeterminable"", ""corrected_value"": null, ""quote"": ""To replicate the original thermal tolerance experiments conducted in 1970 ( Coles, Jokiel & Lewis, 1976 ; Jokiel & Coles, 1977 ; Coles & Jokiel, 1978 ), three species of corals"", ""location"": ""Independent parent primary context and original-report chain, integration/original_report_chain_0000.result.json"", ""reason"": ""CurrentResults explicitly compare day3historical mortality counts cited to EPA1975. Shared1970survivorship curves make overlap with1977plausible but do not establish that the full technical report and journal paper represent identical tested findings. FullEPAreport and1977original unavailable after recorded attempts; exactEPAcover identity/title variant also unresolved. No proof of additional independent pair or categorical duplicate; actual report-equivalence/access limit retained.""}","{""authors"": ""Jokiel PL, Coles SL, Guinther EB, Key GS, Smith SV, Townsley SJ"", ""year"": ""1975"", ""title"": ""Effects of thermal loading on Hawaiian reef corals"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Additionally, whole-colony mortality was observed sooner, just after 3 days of exposure to 31 °C, in 1970 (i.e., P. damicornis, n = 15; M. capitata, n = 8; and L. scutaria, n = 3) ( Jokiel et al., 1975 ) (Wilcoxon rank-sum test: L. scutaria p <0.0001; M. capitata p < 0.0001; P. damicornis p < 0.0001). Corals were able to withstand elevated temperatures (31.4 °C) for a longer period of time in the current 2017 experiment."", ""outcome"": ""failed"", ""outcome_quote"": ""Additionally, whole-colony mortality was observed sooner, just after 3 days of exposure to 31 °C, in 1970 (i.e., P. damicornis, n = 15; M. capitata, n = 8; and L. scutaria, n = 3) ( Jokiel et al., 1975 ) (Wilcoxon rank-sum test: L. scutaria p <0.0001; M. capitata p < 0.0001; P. damicornis p < 0.0001). Corals were able to withstand elevated temperatures (31.4 °C) for a longer period of time in the current 2017 experiment."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""Directly contrasts earlier whole-colony mortality timing against new experimental results.""}"
10.3389/fpsyg.2018.02374,654919670700751a,0,10.1162/jocn.2007.19.11.1872,How negative emotion enhances the visual specificity of a memory.,"Kensinger E. A., Garoff-Eaton R. J., Schacter D. L.",2007,full_text,,unverified,unresolved,{},"{""authors"": ""Kensinger E. A., Garoff-Eaton R. J., Schacter D. L."", ""year"": ""2007"", ""title"": ""How negative emotion enhances the visual specificity of a memory."", ""doi"": ""10.1162/jocn.2007.19.11.1872"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this study, we provide a conceptual replication of Kensinger’s findings.\nSpecifically, while positive valence seems to have little effect, negative valence appears to significantly increase the amount of details that are remembered. For example,\nKensinger et al. (2007)\nhave shown that participants are more accurate in remembering visual details of negative valanced items (e.g., “a green and black snake with yellow eyes”) compared to positive items (e.g., “a cake”). Obviously, there could be visual confounds that might lead to more detailed memory for negative compared to positive stimuli. It has been shown, however, that even if visual confounds are controlled for, the effect of valence on memory accuracy prevails. One prominent example is the study by\nKensinger and Schacter (2006)\n, which measured the amount of details Red Sox fans and Yankee fans could report from a baseball game and found that supporters of the losing team had more detailed memories. In this instance, the visual information was matched between the groups, but what differed was the either positive or negative appraisal of the event that led to differences in memory accuracy. "", ""outcome"": ""successful"", ""outcome_quote"": ""The results obtained from 60 healthy human participants confirmed Kensinger’s hypothesis by showing that under conditions of high visual interference, negative valanced emotions led to higher levels of recognition accuracy compared to neutral and positive emotions."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The overall confirmation verdict covers the behavioral negative-valence detail-memory finding retested with auditory induction.""}"
10.3389/fpsyg.2018.02374,654919670700751a,1,10.3758/BF03193993,When the red sox shocked the yankees: comparing negative and positive memories.,"Kensinger E. A., Schacter D. L.",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Kensinger E. A., Schacter D. L."", ""year"": ""2006"", ""title"": ""When the red sox shocked the yankees: comparing negative and positive memories."", ""doi"": ""10.3758/BF03193993"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this study, we provide a conceptual replication of Kensinger’s findings.\nSpecifically, while positive valence seems to have little effect, negative valence appears to significantly increase the amount of details that are remembered. For example,\nKensinger et al. (2007)\nhave shown that participants are more accurate in remembering visual details of negative valanced items (e.g., “a green and black snake with yellow eyes”) compared to positive items (e.g., “a cake”). Obviously, there could be visual confounds that might lead to more detailed memory for negative compared to positive stimuli. It has been shown, however, that even if visual confounds are controlled for, the effect of valence on memory accuracy prevails. One prominent example is the study by\nKensinger and Schacter (2006)\n, which measured the amount of details Red Sox fans and Yankee fans could report from a baseball game and found that supporters of the losing team had more detailed memories. In this instance, the visual information was matched between the groups, but what differed was the either positive or negative appraisal of the event that led to differences in memory accuracy. "", ""outcome"": ""successful"", ""outcome_quote"": ""The results obtained from 60 healthy human participants confirmed Kensinger’s hypothesis by showing that under conditions of high visual interference, negative valanced emotions led to higher levels of recognition accuracy compared to neutral and positive emotions."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The overall confirmation verdict covers the behavioral negative-valence detail-memory finding retested with auditory induction.""}"
10.1002/pon.4841,b102ffce14deaaa3,1,,Un Abrazo Para La Familia: An evidenced-based rehabilitation approach in providing cancer education to low-SES Hispanic co-survivors,"Marshall, CA; Curran, MA; Koerner, SS; Kroll, T; Hickman, A; García, F",2014,full_text,,unverified,unresolved,{},"{""authors"": ""Marshall, CA; Curran, MA; Koerner, SS; Kroll, T; Hickman, A; García, F"", ""year"": ""2014"", ""title"": ""Un Abrazo Para La Familia: An evidenced-based rehabilitation approach in providing cancer education to low-SES Hispanic co-survivors"", ""doi"": """", ""identified_by"": ""description"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The objective of the Portland replication was to train 20 promotoras to implement Abrazo in their communities with at least 120 Latino cancer survivors and co-survivors."", ""outcome"": ""successful"", ""outcome_quote"": ""Portland promotoras demonstrated that when the Abrazo intervention is provided via a culturally congruent, accessible format, the significant gains in cancer knowledge and self-efficacy reported by underserved co-survivors can be replicated."", ""outcome_quote_section"": ""abstract"", ""outcome_confident"": true, ""outcome_reasoning"": ""The authors explicitly state that the Portland implementation replicated the prior Tucson gains in knowledge and self-efficacy.""}"
10.1002/ejsp.2390,624a82f690cc0e38,0,,,,2012,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": ""2012"", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Given the important implications of their work, we aimed to directly replicate Sklar's findings using a larger sample (n = 94) from a different population."", ""outcome"": ""successful"", ""outcome_quote"": ""We found evidence of unconscious subtraction consistent with Sklar et al., albeit the effect is weak."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Published abstract explicitly reports evidence consistent with the original; weakness alone does not make mixed.""}"
10.1017/s1930297500002941,908fbb1cb58c9c38,1,,Crowd IQ: Aggregating opinions to boost performance.,"Bachrach, Y., Graepel, T., Kasneci, G., Kosinski, M., & Gael, J. V.",2012,full_text,competing_supported_matches,unverified,unresolved,{},"{""authors"": ""Bachrach, Y., Graepel, T., Kasneci, G., Kosinski, M., & Gael, J. V."", ""year"": ""2012"", ""title"": ""Crowd IQ: Aggregating opinions to boost performance."", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Another study examined group and individual performance based on traditional (not crowdsourced) administration of the Raven’s Standard Progressive Matrices (Bachrach, Graepel, Kasneci, Kosinski & Gael, 2012), and found that response aggregation resulted in a collective IQ that exceeded the best performing individual within the group. Our crowdsourced sample also included a subset of workers who completed the entire test, thus additionally allowing a direct comparison between collective IQ of a randomly assembled crowd, and the individual IQ of its constituent members."", ""outcome"": ""failed"", ""outcome_quote"": ""The collective IQ was not statistically distinguishable from the IQ of the best performing individual within that group for any of the group sizes."", ""outcome_quote_section"": ""results"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true}"
10.1002/ajcp.12385,eeac07d5b52fb523,1,10.1080/15374416.2017.1295379,The moderating effect of risk exposure on an efficacious intervention for maltreated children.,Weiler LM & Taussig HN,2017,full_text,,unverified,unresolved,{},"{""authors"": ""Weiler LM & Taussig HN"", ""year"": ""2017"", ""title"": ""The moderating effect of risk exposure on an efficacious intervention for maltreated children."", ""doi"": ""10.1080/15374416.2017.1295379"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In the FHF pilot study we found that (1) severity of neglect did not moderate outcomes, suggesting that children with severe neglect histories were just as likely to benefit from the intervention as those with less severe neglect histories ( Taussig, Culhane, Garrido, Knudtson, & Petrenko, 2013 ) but that (2) level of risk (i.e., exposure to ACEs) did moderate some outcomes (i.e., posttraumatic stress and dissociative symptoms), such that maltreated children exposed to a relatively higher number of ACEs did not experience the same reduction in trauma symptoms as children exposed to fewer adversities ( Weiler & Taussig, 2017 ). There were no a priori hypotheses about the direction of the potential moderating effects with the exception of the ACEs measure; based on our prior research, we hypothesized that those children with fewer ACEs would demonstrate greater program effects on trauma symptomatology."", ""outcome"": ""mixed"", ""outcome_quote"": ""Forty-two analyses were conducted and three interaction terms were statistically significant. The baseline ACEs measure significantly moderated the intervention’s impact on T2 youth-reported posttraumatic stress symptoms ( β = .15; t = 2.23; p < .05) and quality of life ( β = −.15; t = −2.06; p < .05)."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""The original risk moderation affected posttraumatic stress and dissociation; only posttraumatic stress moderation recurs among those two. Quality-of-life moderation is additional. Discussion confirms the fewer-ACEs pattern on some outcomes, rather than an overall verdict covering both original trauma outcomes. The new cohorts are pooled with the pilot sample, so the test is only partly independent."", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """"}"
10.3389/fnins.2020.00803,708ec94ce2683d68,1,10.3389/fendo.2018.00572,Oxytocin facilitates empathic- and self-embarrassment ratings by attenuating amygdala and anterior insula responses.,"Geng, Y., Zhao, W., Zhou, F., Ma, X., Yao, S., Becker, B.",2018,full_text,,unverified,unresolved,{},"{""authors"": ""Geng, Y., Zhao, W., Zhou, F., Ma, X., Yao, S., Becker, B."", ""year"": ""2018"", ""title"": ""Oxytocin facilitates empathic- and self-embarrassment ratings by attenuating amygdala and anterior insula responses."", ""doi"": ""10.3389/fendo.2018.00572"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""The current preregistered pharmacological eye-tracking study employed a randomized within-subject placebo-controlled design to investigate the effects of intranasal OT (24 IU) on patterns of eye gaze in male subjects performing the MET and to replicate previous findings demonstrating OT-induced facilitation of emotional empathy ( Hurlemann et al., 2010 ; Geng et al., 2018a , b )."", ""outcome"": ""successful"", ""outcome_quote"": ""Results first confirmed previous findings that OT increases emotional empathy in both negative and positive emotional contexts ( Hurlemann et al., 2010 ; Geng et al., 2018a , b )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Explicit confirmation names this target and the positive and negative emotional-empathy findings.""}"
