10.1371/journal.pone.0147770,569d8454dfe97d14,1,,The stability of working memory: Do previous tasks influence complex span?,"Healey MK, Hasher L, Danilova E",2011,full_text,,unverified,unresolved,{},"{""authors"": ""Healey MK, Hasher L, Danilova E"", ""year"": ""2011"", ""title"": ""The stability of working memory: Do previous tasks influence complex span?"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In this study, for the depletion task, we used the actual video material and verbatim instructions from the popular video-viewing attention control task employed by prior researchers. For the outcome task, we used a complex working memory span task known as the operation span task (OSPAN; [\n36\n]). We selected these particular tasks because they maximize the chances of demonstrating the ego-depletion effect for the following reasons: a) the video-viewing attention control task is one of the most widely used tasks and has consistently been shown to induce ego-depletion in prior research (e.g., [\n5\n,\n31\n–\n33\n]); b) the OSPAN task places heavy demand on executive attention and hence should tax self-control resources (e.g., [\n37\n]); c) this particular combination of tasks has produced medium to large effect sizes in prior studies [\n5\n,\n38\n]; d) these tasks are matched in terms of stimulus modality (i.e., both tasks utilize words), which has been shown to amplify the ego-depletion effect [\n38\n]. "", ""outcome"": ""failed"", ""outcome_quote"": ""Contrary to the ego-depletion hypothesis, participants in the depletion condition did not perform worse than control participants on the subsequent self-control task, even after considering moderator variables."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The task combination is explicitly linked to these two prior effect demonstrations; the present attempt finds no depletion effect.""}"
10.1037/xhp0000489,b371e50524c8b0ba,0,,,,,abstract,,unverified,unresolved,{},"{""authors"": """", ""year"": """", ""title"": """", ""doi"": """", ""identified_by"": """", ""study_numbers"": """", ""replication_study_numbers"": ""1, 2"", ""evidence_quote"": ""In Experiments 1 and 2, we replicate our results using a stimulus setup that made random sampling unlikely."", ""outcome"": ""successful"", ""outcome_quote"": ""In Experiments 1 and 2, we replicate our results using a stimulus setup that made random sampling unlikely."", ""outcome_quote_section"": ""abstract"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""The abstract explicitly says Experiments 1 and 2 replicate the prior results. The prior paper citation cannot be extracted from this abstract.""}"
10.1002/ejsp.2748,f973ea0ffc4f9a87,1,10.1177/0146167203261295,Criticizing groups from the inside and the outside: An identity perspective on the intergroup sensitivity effect,"Hornsey, M. J., & Imani, A.",2004,full_text,,unverified,unresolved,{},"{""authors"": ""Hornsey, M. J., & Imani, A."", ""year"": ""2004"", ""title"": ""Criticizing groups from the inside and the outside: An identity perspective on the intergroup sensitivity effect"", ""doi"": ""10.1177/0146167203261295"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Serial mediation analyses confirmed past theorizing on the processes underlying the ISE (Hornsey & Imani, 2004;Thürmer & McCrea, 2018). Specifically, participants ascribed less constructive motives to outgroup commenters, leading to higher threat perceptions. Source and target effects on bonus payment were serially mediated by message motive and message threat ratings."", ""outcome"": ""successful"", ""outcome_quote"": ""Serial mediation analyses confirmed past theorizing on the processes underlying the ISE (Hornsey & Imani, 2004;Thürmer & McCrea, 2018). Specifically, participants ascribed less constructive motives to outgroup commenters, leading to higher threat perceptions. Source and target effects on bonus payment were serially mediated by message motive and message threat ratings."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1002/ejsp.2748,f973ea0ffc4f9a87,2,10.1177/0146167205282992,Reactions to internal and external criticism of outgroups: Social convention in the intergroup sensitivity effect,"Sutton, R. M., Elder, T. J., & Douglas, K. M.",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Sutton, R. M., Elder, T. J., & Douglas, K. M."", ""year"": ""2006"", ""title"": ""Reactions to internal and external criticism of outgroups: Social convention in the intergroup sensitivity effect"", ""doi"": ""10.1177/0146167205282992"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Consistent with the bystander ISE (e.g., Sutton et al., 2006), participants ascribed less constructive motives to and were more threatened by between-group criticism than within-group criticism."", ""outcome"": ""successful"", ""outcome_quote"": ""Registered analyses revealed strong evidence for the classic ISE across behavioural and self-report measures, with effects for selfreport measures being substantially larger. As predicted, we also found unequivocal support for the bystander ISE in self-reports."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1002/ejsp.2748,f973ea0ffc4f9a87,3,,Social identity and social convention in responses to criticisms of groups,"Sutton, R. M., Douglas, K. M., Elder, T. J., & Tarrant, M.",2008,full_text,,unverified,unresolved,{},"{""authors"": ""Sutton, R. M., Douglas, K. M., Elder, T. J., & Tarrant, M."", ""year"": ""2008"", ""title"": ""Social identity and social convention in responses to criticisms of groups"", ""doi"": """", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Sutton et al. (2008) included such a comparison and found consistent evidence for both the classic ISE and the bystander ISE, with both effects being of similar magnitude."", ""outcome"": ""mixed"", ""outcome_quote"": ""In contrast, we observed a bystander ISE that was consistently and substantially larger than the classic ISE across all measures. Although more in line with a normative perspective, general norms against intergroup criticism would also not predict any effects of the target group's identity. Likewise, we observed significant main effects of target, such that individuals were more likely to deny a bonus to commenters who criticized an outgroup than to those who criticized the ingroup."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1002/ejsp.2748,f973ea0ffc4f9a87,4,10.1177/1948550618762298,Motivated collective defensiveness: Group members prioritize counterarguing outgroup criticism over getting their work done,"Thürmer, J. L., McCrea, S. M., & McIntyre, B. M.",2019,full_text,,unverified,unresolved,{},"{""authors"": ""Thürmer, J. L., McCrea, S. M., & McIntyre, B. M."", ""year"": ""2019"", ""title"": ""Motivated collective defensiveness: Group members prioritize counterarguing outgroup criticism over getting their work done"", ""doi"": ""10.1177/1948550618762298"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We conducted additional exploratory tests to determine whether identification with the ingroup could account for the observed results. In particular, it is possible we did not observe more support for the social identity account because participants were not sufficiently identified with the ingroup. We therefore examined whether the classic and bystander ISE effects were consistent across levels of identification. In line with previous research (Thürmer et al., 2019), Johnson-Neyman Analyses indicated that the behavioural classic ISE on participants' bonus payment decision was significant for those participants reporting medium-tohigh identification with their group (2.45 and above), but not for those reporting low identification (Figure 1a). 1 The bystander ISE was significant at all levels of identification (Figure 1b). Importantly, these analyses show that both the classic ISE and the bystander ISE are significant for individuals strongly identifying with the ingroup."", ""outcome"": ""successful"", ""outcome_quote"": ""Further exploratory analysis also showed evidence for the role of identity, though not in line with the predictions of a social identity account. In line with past research, the classic behavioural ISE only emerged for those sufficiently identified with their group. In contrast, the behavioural bystander ISE was observed across levels of ingroup identification. We observed a parallel pattern of results for reported message threat, though not for message motive."", ""outcome_quote_section"": ""discussion"", ""outcome_confident"": true}"
10.1002/pros.21320,b6501b513c44f799,1,10.1073/pnas.0605832103,Admixture mapping ident-ifies 8q24 as a prostate cancer risk locus in African-American men,"Freedman ML, Haiman CA, Patterson N, McDonald GJ, Tandon A, Waliszewska A, Penney K, Steen RG, Ardlie K, John EM, Oakley-Girvan I, Whittemore AS, Cooney KA, Ingles SA, Altshuler D, Henderson BE, Reich D",2006,full_text,,unverified,unresolved,{},"{""authors"": ""Freedman ML, Haiman CA, Patterson N, McDonald GJ, Tandon A, Waliszewska A, Penney K, Steen RG, Ardlie K, John EM, Oakley-Girvan I, Whittemore AS, Cooney KA, Ingles SA, Altshuler D, Henderson BE, Reich D"", ""year"": ""2006"", ""title"": ""Admixture mapping ident-ifies 8q24 as a prostate cancer risk locus in African-American men"", ""doi"": ""10.1073/pnas.0605832103"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Allele A of rs1447295 was not associated with risk of prostate cancer in Tobago men. Our findings support the reports of most studies that have evaluated rs1447295 in most populations of African ancestry. In a case–control study of 246 African American men with prostate cancer and 352 controls in Michigan, Amundadottir et al. 9 failed to replicate the association of the SNP rs1447295 A allele with prostate cancer. Similarly, Freedman et al. 10 found no association of the A allele with prostate cancer among 989 African American men with prostate cancer and 804 controls (OR, 1.05; 95% CI = 0.95–1.16, P = 0.15). Likewise, Gudmundsson et al. 12 (OR, 1.01; 95% CI = 0.81–1.25, P = 0.96), Cheng et al. 15 (OR, 0.87, 95% CI = 0.55–1.40, P = 0.87) and Salinas et al. 16 (OR, 1.19; 95% CI = 0.66–2.14) all found no association of allele A of SNP rs1447295 with prostate cancer risk in African American men ( Table III )."", ""outcome"": ""successful"", ""outcome_quote"": ""Allele A of rs1447295 was not associated with risk of prostate cancer in Tobago men. Our findings support the reports of most studies that have evaluated rs1447295 in most populations of African ancestry. In a case–control study of 246 African American men with prostate cancer and 352 controls in Michigan, Amundadottir et al. 9 failed to replicate the association of the SNP rs1447295 A allele with prostate cancer. Similarly, Freedman et al. 10 found no association of the A allele with prostate cancer among 989 African American men with prostate cancer and 804 controls (OR, 1.05; 95% CI = 0.95–1.16, P = 0.15). Likewise, Gudmundsson et al. 12 (OR, 1.01; 95% CI = 0.81–1.25, P = 0.96), Cheng et al. 15 (OR, 0.87, 95% CI = 0.55–1.40, P = 0.87) and Salinas et al. 16 (OR, 1.19; 95% CI = 0.66–2.14) all found no association of allele A of SNP rs1447295 with prostate cancer risk in African American men ( Table III )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Codes the reported comparison to this primary paper in the ancestry-specific context; associations in other populations make the cross-population interpretation uncertain.""}"
10.1002/pros.21320,b6501b513c44f799,2,10.1038/ng1999,Genome-wide association study identifies a second prostate cancer susceptibility variant at 8q24,"Gudmundsson J, Sulem P, Manolescu A, Amundadottir LT, Gudbjartsson D, Helgason A, Rafnar T, Bergthorsson JT, Agnarsson BA, Baker A, Sigurdsson A, Benediktsdottir KR, Jakobsdottir M, Xu J, Blondal T, Kostic J, Sun J, Ghosh S, Stacey SN, Mouy M, Saemundsdottir J, Backman VM, Kristjansson K, Tres A, Partin AW, Albers-Akkers MT, Godino-Ivan Marcos J, Walsh PC, Swinkels DW, Navarrete S, Isaacs SD, Aben KK, Graif T, Cashy J, Ruiz-Echarri M, Wiley KE, Suarez BK, Witjes JA, Frigge M, Ober C, Jonsson E, Einarsson GV, Mayordomo JI, Kiemeney LA, Isaacs WB, Catalona WJ, Barkardottir RB, Gulcher JR, Thorsteinsdottir U, Kong A, Stefansson K",2007,full_text,,unverified,unresolved,{},"{""authors"": ""Gudmundsson J, Sulem P, Manolescu A, Amundadottir LT, Gudbjartsson D, Helgason A, Rafnar T, Bergthorsson JT, Agnarsson BA, Baker A, Sigurdsson A, Benediktsdottir KR, Jakobsdottir M, Xu J, Blondal T, Kostic J, Sun J, Ghosh S, Stacey SN, Mouy M, Saemundsdottir J, Backman VM, Kristjansson K, Tres A, Partin AW, Albers-Akkers MT, Godino-Ivan Marcos J, Walsh PC, Swinkels DW, Navarrete S, Isaacs SD, Aben KK, Graif T, Cashy J, Ruiz-Echarri M, Wiley KE, Suarez BK, Witjes JA, Frigge M, Ober C, Jonsson E, Einarsson GV, Mayordomo JI, Kiemeney LA, Isaacs WB, Catalona WJ, Barkardottir RB, Gulcher JR, Thorsteinsdottir U, Kong A, Stefansson K"", ""year"": ""2007"", ""title"": ""Genome-wide association study identifies a second prostate cancer susceptibility variant at 8q24"", ""doi"": ""10.1038/ng1999"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Allele A of rs1447295 was not associated with risk of prostate cancer in Tobago men. Our findings support the reports of most studies that have evaluated rs1447295 in most populations of African ancestry. In a case–control study of 246 African American men with prostate cancer and 352 controls in Michigan, Amundadottir et al. 9 failed to replicate the association of the SNP rs1447295 A allele with prostate cancer. Similarly, Freedman et al. 10 found no association of the A allele with prostate cancer among 989 African American men with prostate cancer and 804 controls (OR, 1.05; 95% CI = 0.95–1.16, P = 0.15). Likewise, Gudmundsson et al. 12 (OR, 1.01; 95% CI = 0.81–1.25, P = 0.96), Cheng et al. 15 (OR, 0.87, 95% CI = 0.55–1.40, P = 0.87) and Salinas et al. 16 (OR, 1.19; 95% CI = 0.66–2.14) all found no association of allele A of SNP rs1447295 with prostate cancer risk in African American men ( Table III ). Our finding of increased risk of prostate cancer in men carrying the “at risk” A allele of rs16901979 in region 2 of chromosome 8q24 in Tobago men is in agreement with reports of several other investigators in both populations of African 12 , 14 , 15 and European ancestry 12 , 15 . However, Cheng et al. 15 reported a non-significant 37% increased risk of prostate cancer among African American men in King County, Seattle; the lack of association may be due to the small sample size of their study."", ""outcome"": ""successful"", ""outcome_quote"": ""Allele A of rs1447295 was not associated with risk of prostate cancer in Tobago men. Our findings support the reports of most studies that have evaluated rs1447295 in most populations of African ancestry. In a case–control study of 246 African American men with prostate cancer and 352 controls in Michigan, Amundadottir et al. 9 failed to replicate the association of the SNP rs1447295 A allele with prostate cancer. Similarly, Freedman et al. 10 found no association of the A allele with prostate cancer among 989 African American men with prostate cancer and 804 controls (OR, 1.05; 95% CI = 0.95–1.16, P = 0.15). Likewise, Gudmundsson et al. 12 (OR, 1.01; 95% CI = 0.81–1.25, P = 0.96), Cheng et al. 15 (OR, 0.87, 95% CI = 0.55–1.40, P = 0.87) and Salinas et al. 16 (OR, 1.19; 95% CI = 0.66–2.14) all found no association of allele A of SNP rs1447295 with prostate cancer risk in African American men ( Table III ). Our finding of increased risk of prostate cancer in men carrying the “at risk” A allele of rs16901979 in region 2 of chromosome 8q24 in Tobago men is in agreement with reports of several other investigators in both populations of African 12 , 14 , 15 and European ancestry 12 , 15 . However, Cheng et al. 15 reported a non-significant 37% increased risk of prostate cancer among African American men in King County, Seattle; the lack of association may be due to the small sample size of their study."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Codes the reported comparison to this primary paper in the ancestry-specific context; associations in other populations make the cross-population interpretation uncertain.""}"
10.1002/pros.21320,b6501b513c44f799,3,10.1038/ng2022,Genome-wide association study of prostate cancer identifies a second risk locus at 8q24,"Yeager M, Orr N, Hayes RB, Jacobs KB, Kraft P, Wacholder S, Minichiello MJ, Fearnhead P, Yu K, Chatterjee N, Wang Z, Welch R, Staats BJ, Calle EE, Feigelson HS, Thun MJ, Rodriguez C, Albanes D, Virtamo J, Weinstein S, Schumacher FR, Giovannucci E, Willett WC, Cancel-Tassin G, Cussenot O, Valeri A, Andriole GL, Gelmann EP, Tucker M, Gerhard DS, Fraumeni JF, Hoover R, Hunter DJ, Chanock SJ, Thomas G",2007,full_text,,unverified,unresolved,{},"{""authors"": ""Yeager M, Orr N, Hayes RB, Jacobs KB, Kraft P, Wacholder S, Minichiello MJ, Fearnhead P, Yu K, Chatterjee N, Wang Z, Welch R, Staats BJ, Calle EE, Feigelson HS, Thun MJ, Rodriguez C, Albanes D, Virtamo J, Weinstein S, Schumacher FR, Giovannucci E, Willett WC, Cancel-Tassin G, Cussenot O, Valeri A, Andriole GL, Gelmann EP, Tucker M, Gerhard DS, Fraumeni JF, Hoover R, Hunter DJ, Chanock SJ, Thomas G"", ""year"": ""2007"", ""title"": ""Genome-wide association study of prostate cancer identifies a second risk locus at 8q24"", ""doi"": ""10.1038/ng2022"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""We did not detect any association of allele T of rs6983267 in region 3 of chromosome 8q24 with prostate cancer risk in Tobago men similar to the findings of some investigators that have evaluated this SNP in populations of African ancestry. Cheng et al. 15 reported no association between this SNP and prostate cancer risk among 89 African American men with prostate cancer and 89 controls in King County, Seattle. Robbins et al. 14 noted a tendency towards significance for the G allele among African American men in Washington, D.C. with prostate cancer (OR, 1.4; 95% CI = 0.9–2.4, P = 0.07). Among all populations of European ancestry evaluated to date, the G allele of rs6983267 is significantly associated with increased risk of prostate cancer. In a GWAS study of 550,00 SNPs in 1,172 European American men with prostate cancer and 1,157 controls in the Prostate, Lung, Colon and Ovarian (PLCO) Trial 17 , 18 , Yeager et al. 13 reported significant association of the G allele of rs6983267 with prostate cancer risk."", ""outcome"": ""failed"", ""outcome_quote"": ""We did not detect any association of allele T of rs6983267 in region 3 of chromosome 8q24 with prostate cancer risk in Tobago men similar to the findings of some investigators that have evaluated this SNP in populations of African ancestry. Cheng et al. 15 reported no association between this SNP and prostate cancer risk among 89 African American men with prostate cancer and 89 controls in King County, Seattle. Robbins et al. 14 noted a tendency towards significance for the G allele among African American men in Washington, D.C. with prostate cancer (OR, 1.4; 95% CI = 0.9–2.4, P = 0.07). Among all populations of European ancestry evaluated to date, the G allele of rs6983267 is significantly associated with increased risk of prostate cancer. In a GWAS study of 550,00 SNPs in 1,172 European American men with prostate cancer and 1,157 controls in the Prostate, Lung, Colon and Ovarian (PLCO) Trial 17 , 18 , Yeager et al. 13 reported significant association of the G allele of rs6983267 with prostate cancer risk."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""Codes the reported comparison to this primary paper in the ancestry-specific context; associations in other populations make the cross-population interpretation uncertain.""}"
10.1002/pros.21320,b6501b513c44f799,4,10.1101/gr.6782707,Confirmation study of prostate cancer risk variants at 8q24 in African Americans identifies a novel risk locus,"Robbins C, Torres JB, Hooker S, Bonilla C, Hernandez W, Candreva A, Ahaghotu C, Kittles R, Carpten J",2007,full_text,,unverified,unresolved,{},"{""authors"": ""Robbins C, Torres JB, Hooker S, Bonilla C, Hernandez W, Candreva A, Ahaghotu C, Kittles R, Carpten J"", ""year"": ""2007"", ""title"": ""Confirmation study of prostate cancer risk variants at 8q24 in African Americans identifies a novel risk locus"", ""doi"": ""10.1101/gr.6782707"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our finding of increased risk of prostate cancer in men carrying the “at risk” A allele of rs16901979 in region 2 of chromosome 8q24 in Tobago men is in agreement with reports of several other investigators in both populations of African 12 , 14 , 15 and European ancestry 12 , 15 . However, Cheng et al. 15 reported a non-significant 37% increased risk of prostate cancer among African American men in King County, Seattle; the lack of association may be due to the small sample size of their study."", ""outcome"": ""successful"", ""outcome_quote"": ""Our finding of increased risk of prostate cancer in men carrying the “at risk” A allele of rs16901979 in region 2 of chromosome 8q24 in Tobago men is in agreement with reports of several other investigators in both populations of African 12 , 14 , 15 and European ancestry 12 , 15 . However, Cheng et al. 15 reported a non-significant 37% increased risk of prostate cancer among African American men in King County, Seattle; the lack of association may be due to the small sample size of their study."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Codes the reported comparison to this primary paper in the ancestry-specific context; associations in other populations make the cross-population interpretation uncertain.""}"
10.1002/pros.21320,b6501b513c44f799,5,10.1038/sj.ejhg.5201959,8q24 and prostate cancer: Association with advanced disease and meta-analysis,"Cheng I, Plummer SJ, Jorgenson E, Liu X, Rybicki BA, Casey G, Witte JS",2008,full_text,,unverified,unresolved,{},"{""authors"": ""Cheng I, Plummer SJ, Jorgenson E, Liu X, Rybicki BA, Casey G, Witte JS"", ""year"": ""2008"", ""title"": ""8q24 and prostate cancer: Association with advanced disease and meta-analysis"", ""doi"": ""10.1038/sj.ejhg.5201959"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Our finding of increased risk of prostate cancer in men carrying the “at risk” A allele of rs16901979 in region 2 of chromosome 8q24 in Tobago men is in agreement with reports of several other investigators in both populations of African 12 , 14 , 15 and European ancestry 12 , 15 . However, Cheng et al. 15 reported a non-significant 37% increased risk of prostate cancer among African American men in King County, Seattle; the lack of association may be due to the small sample size of their study."", ""outcome"": ""mixed"", ""outcome_quote"": ""Our finding of increased risk of prostate cancer in men carrying the “at risk” A allele of rs16901979 in region 2 of chromosome 8q24 in Tobago men is in agreement with reports of several other investigators in both populations of African 12 , 14 , 15 and European ancestry 12 , 15 . However, Cheng et al. 15 reported a non-significant 37% increased risk of prostate cancer among African American men in King County, Seattle; the lack of association may be due to the small sample size of their study."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": false, ""outcome_reasoning"": ""The authors explicitly describe agreement on rs16901979 but also mark the nonsignificant African-American estimate as a contrast. This primary empirical article also contains a meta-analysis; only its empirical sample is treated as the target.""}"
10.1002/pros.21320,b6501b513c44f799,6,10.1158/1055-9965.EPI-07-2811,Multiple independent genetic variants in the 8q24 region are associated with prostate cancer risk,"Salinas CA, Kwon E, Carlson CS, Koopmeiners JS, Feng Z, Karyadi DM, Ostrander EA, Stanford JL",2008,full_text,,unverified,unresolved,{},"{""authors"": ""Salinas CA, Kwon E, Carlson CS, Koopmeiners JS, Feng Z, Karyadi DM, Ostrander EA, Stanford JL"", ""year"": ""2008"", ""title"": ""Multiple independent genetic variants in the 8q24 region are associated with prostate cancer risk"", ""doi"": ""10.1158/1055-9965.EPI-07-2811"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""Allele A of rs1447295 was not associated with risk of prostate cancer in Tobago men. Our findings support the reports of most studies that have evaluated rs1447295 in most populations of African ancestry. In a case–control study of 246 African American men with prostate cancer and 352 controls in Michigan, Amundadottir et al. 9 failed to replicate the association of the SNP rs1447295 A allele with prostate cancer. Similarly, Freedman et al. 10 found no association of the A allele with prostate cancer among 989 African American men with prostate cancer and 804 controls (OR, 1.05; 95% CI = 0.95–1.16, P = 0.15). Likewise, Gudmundsson et al. 12 (OR, 1.01; 95% CI = 0.81–1.25, P = 0.96), Cheng et al. 15 (OR, 0.87, 95% CI = 0.55–1.40, P = 0.87) and Salinas et al. 16 (OR, 1.19; 95% CI = 0.66–2.14) all found no association of allele A of SNP rs1447295 with prostate cancer risk in African American men ( Table III )."", ""outcome"": ""successful"", ""outcome_quote"": ""Allele A of rs1447295 was not associated with risk of prostate cancer in Tobago men. Our findings support the reports of most studies that have evaluated rs1447295 in most populations of African ancestry. In a case–control study of 246 African American men with prostate cancer and 352 controls in Michigan, Amundadottir et al. 9 failed to replicate the association of the SNP rs1447295 A allele with prostate cancer. Similarly, Freedman et al. 10 found no association of the A allele with prostate cancer among 989 African American men with prostate cancer and 804 controls (OR, 1.05; 95% CI = 0.95–1.16, P = 0.15). Likewise, Gudmundsson et al. 12 (OR, 1.01; 95% CI = 0.81–1.25, P = 0.96), Cheng et al. 15 (OR, 0.87, 95% CI = 0.55–1.40, P = 0.87) and Salinas et al. 16 (OR, 1.19; 95% CI = 0.66–2.14) all found no association of allele A of SNP rs1447295 with prostate cancer risk in African American men ( Table III )."", ""outcome_quote_section"": ""discussion"", ""outcome_computation"": """", ""outcome_computational_quote"": """", ""outcome_robustness"": """", ""outcome_robustness_quote"": """", ""outcome_confident"": true, ""outcome_reasoning"": ""Codes the reported comparison to this primary paper in the ancestry-specific context; associations in other populations make the cross-population interpretation uncertain.""}"
10.3389/fnhum.2019.00119,c2b5b024c383e620,1,10.1080/17470919.2013.833549,"The political (and physiological) divide: political orientation, performance monitoring and the anterior cingulate response.","Weissflog M., Choma B. L., Dywan J., van Noordt S. J. R., Segalowitz S. J.",2013,full_text,,unverified,unresolved,{},"{""authors"": ""Weissflog M., Choma B. L., Dywan J., van Noordt S. J. R., Segalowitz S. J."", ""year"": ""2013"", ""title"": ""The political (and physiological) divide: political orientation, performance monitoring and the anterior cingulate response."", ""doi"": ""10.1080/17470919.2013.833549"", ""identified_by"": ""citation"", ""study_numbers"": """", ""replication_study_numbers"": """", ""evidence_quote"": ""In addition to the L/C orientation, we also determined the level of Openness, Traditionalism (Altemeyer,  1996 ), and Equality (Kluegel and Smith,  2017 ), as these values have also been reported as related to error monitoring (Weissflog et al.,  2010 ,  2013 )."", ""outcome"": ""failed"", ""outcome_quote"": ""In addition to the aforementioned parameters, we evaluated ERN- and N2-like components upon a correct response to the Go stimulus. Altogether, these components along with the reaction time and the accuracy of reactions, we conducted the correlation analysis with the behavioral parameters: L/C self and validated orientation, Openness, Traditionalism and Equality. For all 40 comparisons, the ρ ranged from −0.15 to 0.21. After Holm’s correction for multiple comparisons, no significant relationship was observed."", ""outcome_quote_section"": ""results"", ""outcome_confident"": true, ""outcome_reasoning"": ""The paper additionally tests the published links of error monitoring to traditionalism/openness/equality, and reports no significant associations after correction. The discussion explicitly describes Weissflog 2013 as finding significant links to Egalitarianism and Right-wing Authoritarianism. Its 2010 conference precursor supplies no separately targeted published positive finding.""}"
