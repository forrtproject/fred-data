      "raw_path": "private/infant_originals_0106/01_parise_pmc.raw",
      "raw_sha256": "6d6389001d0e5bb2f348809678b15c1b5af808f328bd4505512cb597c9a0446b",
      "quote": "N400 was more negative to the incongruous than to the congruous object in the Mother-speech condition",
      "character_offsets": [
        18731,
        18832
      ],
      "utf8_byte_offsets": [
        18740,
        18841
      ],
      "offset_convention": "zero-based, end-exclusive; exact UTF-8 decoded raw file, no normalization"
