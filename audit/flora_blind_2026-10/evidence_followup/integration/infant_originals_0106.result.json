      "role": "original stimulus selection",
      "raw_path": "private/infant_originals_0106/01_parise_pmc.raw",
      "raw_sha256": "6d6389001d0e5bb2f348809678b15c1b5af808f328bd4505512cb597c9a0446b",
      "quote": "We selected 15 object labels that, according to parental reports, two thirds of Hungarian 1-year-old infants recognize.",
      "character_offsets": [
        12757,
        12876
      ],
      "utf8_byte_offsets": [
