      "raw_sha256": "6d6389001d0e5bb2f348809678b15c1b5af808f328bd4505512cb597c9a0446b",
      "quote": "who repeated the word live for the infant.",
      "character_offsets": [
        14566,
        14608
      ],
      "utf8_byte_offsets": [
